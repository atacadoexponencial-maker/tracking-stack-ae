---
// Layout do Planner da Black Atacado (issue 298).
//
// Por que NÃO usa o `BaseLayout.astro`: aquele layout embute GA4, o Meta Pixel,
// o Microsoft Clarity, o PageView disparado para `/tracker` e o aviso de
// cookies — tudo no `<head>`, fora dos condicionais `showHeader`/`showFooter`.
// A spec do planner manda não rastrear nada, e material de turma fechada não
// tem por que alimentar pixel de anúncio. Passar `showHeader={false}` resolveria
// só a moldura, não o tracking. Daí um layout próprio, curto e sem script
// nenhum de medição.
//
// A exclusão do lado do servidor vive em `functions/_middleware.js`: sem ela, a
// visita viraria sessão no dashboard mesmo com o `<head>` limpo.

import '../styles/global.css';
import '../styles/planner.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Planner da Black Atacado — material do Workshop Black Exponencial.',
} = Astro.props;
---

<!doctype html>
<!-- `data-tema` é o gancho da troca de tema (issue 303). Nasce em "escuro", que
     é o padrão da spec; até a 303, ninguém o altera. -->
<html lang="pt-BR" data-tema="escuro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Material pago de turma fechada: fora do índice de busca, sempre. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preload" href="/fonts/Satoshi-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Satoshi-Regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
