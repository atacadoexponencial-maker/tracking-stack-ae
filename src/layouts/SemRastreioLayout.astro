---
// Layout sem medição nenhuma (issue 370).
//
// Por que NÃO usa o `BaseLayout.astro`: aquele layout embute GA4, o Meta Pixel,
// o Microsoft Clarity, o PageView disparado para `/tracker` e o aviso de
// cookies. A aplicação do plano ao vivo (spec-aplicacao-plano-ao-vivo.md) não
// vira lead nem número no dash, então a página não carrega script de medição
// nenhum. Mesmo raciocínio do `PlannerLayout.astro`, sem o tema e o CSS dele.
//
// A metade server-side da mesma decisão vive em `functions/_middleware.js`:
// sem ela, a visita viraria sessão no dashboard mesmo com o `<head>` limpo.

import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Atacado Exponencial' } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="preload" href="/fonts/Satoshi-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Satoshi-Regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
