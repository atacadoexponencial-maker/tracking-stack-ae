---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AvisoCookies from '../components/AvisoCookies.astro';

interface Props {
  title: string;
  description?: string;
  showHeader?: boolean;
  showFooter?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = 'Atacado Exponencial — método para marcas de atacado venderem mais.',
  showHeader = true,
  showFooter = true,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Pré-carrega a fonte da primeira dobra para reduzir o LCP -->
    <link rel="preload" href="/fonts/Satoshi-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Satoshi-Regular.woff2" as="font" type="font/woff2" crossorigin />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- Situação do aviso de cookies (spec-aviso-cookies.md). Definida antes de
         qualquer envio ao /tracker para o PageView (logo abaixo) e os demais
         eventos usarem a mesma regra: "aviso fechado" quando o "Entendi" foi
         clicado nos últimos 12 meses, "aviso exibido" nos demais casos.
         Armazenamento bloqueado não quebra nada: vale só a página atual.
         É só registro de ciência — não liga nem desliga nenhum script. -->
    <script is:inline>
      (function () {
        var CHAVE = 'ae_aviso_cookies_fechado', VALIDADE = 365 * 24 * 3600 * 1000, fechadoAgora = false;
        window.aeSituacaoAviso = function () {
          if (fechadoAgora) return 'aviso fechado';
          try {
            var em = Number(window.localStorage.getItem(CHAVE));
            if (em && Date.now() - em < VALIDADE) return 'aviso fechado';
          } catch (e) { /* armazenamento bloqueado */ }
          return 'aviso exibido';
        };
        window.aeFecharAviso = function () {
          fechadoAgora = true;
          try { window.localStorage.setItem(CHAVE, String(Date.now())); } catch (e) { /* idem */ }
        };
      })();
    </script>
    <!-- GA4 (gtag) via proxy first-party /scripts (anti-adblock). Envia só o
         PageView no client; conversões (Lead/Purchase) continuam server-side no
         /tracker — sem contagem dupla. Measurement ID não é secreto. -->
    <script async is:inline src="/scripts/gtag.js?id=G-3C24BQVR59"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-3C24BQVR59');
    </script>
    <!-- Meta Pixel via proxy first-party /scripts (anti-adblock). PageView
         redundante: cópia do navegador (fbq) + espelho server-side no /tracker
         com o mesmo event_id — o Meta deduplica e conta 1. Pixel ID não é secreto. -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      '/scripts/fbevents.js');
      // Pixel único: conta Sete Ads 2. O pixel anterior saiu em 2026-07-30,
      // quando a conta de anúncios dele foi bloqueada.
      fbq('init', '2800317883678788');
      // event_id único por visualização — mesmo padrão dos pontos de Lead
      var pvEventId = 'pv-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8);
      // Cópia do navegador (deduplicada no Meta pelo event_id)
      fbq('track', 'PageView', {}, { eventID: pvEventId });
      // Espelho server-side — via autoritativa; fire-and-forget, falha silenciosa
      fetch('/tracker', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          event_name: 'PageView',
          event_id: pvEventId,
          consent_status: window.aeSituacaoAviso(),
          event_time: Math.floor(Date.now() / 1000),
          event_source_url: window.location.href,
        }),
      }).catch(function () { /* silencioso */ });
    </script>
    <!-- Microsoft Clarity — mapas de calor e gravação de sessão. Snippet oficial,
         carregado direto de clarity.ms (sem o proxy /scripts): o endereço de
         coleta é cravado dentro do loader, então proxiar só o arquivo não
         escaparia do adblock — e o Clarity não tem via server-side, ao
         contrário do GA4 e do Meta. Project ID não é secreto. -->
    <script is:inline>
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "xv5xbinj2x");
    </script>
  </head>
  <body>
    {showHeader && <Header />}
    <slot />
    {showFooter && <Footer />}
    <AvisoCookies />
    <!-- Degrau "clicou no CTA" do funil de micro-conversões (spec 2026-08-31).
         Vive aqui, no layout, para toda página existente e futura entrar no
         funil sem instrumentação própria. Evento INTERNO: fica no event_log e
         não vai a Meta, GA4 nem CRM. Script bundlado (sem `is:inline`) porque
         usa `import`. -->
    <script>
      import { ativarCtaClick } from '../scripts/funil';
      ativarCtaClick();
    </script>
  </body>
</html>
