---
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo.png';
import felipe from '../../assets/brand/felipe.webp';

interface Props {
  headline?: string;
  /**
   * Trecho do `headline` que recebe o marca-texto. É uma prop, e não HTML
   * dentro da string, porque conteúdo vindo de fora (slot ou set:html) não
   * recebe o CSS com escopo deste componente e o destaque sairia sem estilo.
   */
  highlight?: string;
  subheadline?: string;
  badge?: string;
  navCtaLabel?: string;
  ctaLabel?: string;
  ctaHref?: string;
  trust?: string[];
  stats?: { value: string; label: string }[];
  /**
   * Variação com a foto do Felipe ao lado do texto, como no hero da
   * /workshop-black-exponencial-2026. Sem ela o hero segue centralizado, que
   * é o formato de todas as outras páginas.
   */
  comFoto?: boolean;
}
const {
  headline,
  highlight,
  subheadline,
  badge = 'Para atacadistas com faturamento acima de R$ 20 mil/mês',
  navCtaLabel = 'Agendar diagnóstico',
  ctaLabel = 'Quero meu diagnóstico gratuito',
  ctaHref,
  trust = ['100% gratuito', 'Sem cartão', '35 min'],
  comFoto = false,
  stats = [
    { value: '+100', label: 'marcas atacado atendidas' },
    { value: '35 min', label: 'sessão individual' },
    { value: 'R$ 0', label: 'custo para você' },
    { value: '1º', label: 'método próprio para atacado' },
  ],
} = Astro.props;

// Parte o título na primeira ocorrência do trecho destacado. Sem ocorrência,
// o título sai inteiro e sem marca-texto: destaque é enfeite, nunca requisito.
const corte = headline && highlight ? headline.indexOf(highlight) : -1;
const titulo =
  corte >= 0
    ? {
        antes: headline.slice(0, corte),
        alvo: headline.slice(corte, corte + highlight.length),
        depois: headline.slice(corte + highlight.length),
      }
    : null;
---

<header class:list={['hero', comFoto && 'hero--foto']}>
  <nav class="hero__nav container">
    <Image src={logo} alt="Atacado Exponencial" height={72} class="hero__logo" />
    {ctaHref ? (
      <a class="hero__nav-cta" href={ctaHref}>
        {navCtaLabel} <span aria-hidden="true">→</span>
      </a>
    ) : (
      <button type="button" class="hero__nav-cta" data-open-chat>
        {navCtaLabel} <span aria-hidden="true">→</span>
      </button>
    )}
  </nav>

  <div class="hero__body">
    <div class="hero__texto">
    <span class="hero__badge">{badge}</span>
    {headline && titulo ? (
      <h1 class="hero__title">
        {titulo.antes}<mark class="hero__hl">{titulo.alvo}</mark>{titulo.depois}
      </h1>
    ) : headline ? (
      <h1 class="hero__title">{headline}</h1>
    ) : (
      <h1 class="hero__title">
        O Plano de Ação que seu Atacado precisa para faturar <strong>R$ 400 mil</strong> ou mais por mês
      </h1>
    )}
    {subheadline ? (
      <p class="hero__sub">{subheadline}</p>
    ) : (
      <p class="hero__sub">
        Em uma sessão individual e gratuita, analisamos seu atacado de ponta a ponta
      e entregamos um plano personalizado para destravar seu crescimento.
      </p>
    )}
    {ctaHref ? (
      <a class="btn-cta hero__cta" href={ctaHref}>
        {ctaLabel}
        <span class="hero__cta-arrow" aria-hidden="true">→</span>
      </a>
    ) : (
      <button type="button" class="btn-cta hero__cta" data-open-chat>
        {ctaLabel}
        <span class="hero__cta-arrow" aria-hidden="true">→</span>
      </button>
    )}
    <div class="hero__trust">
      {trust.map((t) => <span class="hero__trust-item">{t}</span>)}
    </div>
    </div>
    {comFoto && (
      <div class="hero__visual">
        <Image src={felipe} alt="Felipe Santos" class="hero__foto" loading="eager" />
      </div>
    )}
  </div>

  <div class="hero__stats container">
    {stats.map((s) => (
      <div class="hero__stat">
        <span class="hero__stat-value">{s.value}</span>
        <span class="hero__stat-label">{s.label}</span>
      </div>
    ))}
  </div>
</header>

<style>
  .hero {
    background: hsl(var(--light-bg));
    color: hsl(var(--light-fg));
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  .hero__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.5rem;
  }
  .hero__logo { height: 2.25rem; width: auto; filter: brightness(0); }
  .hero__nav-cta {
    display: none;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    color: #1e1e1e;
    background: rgba(30, 30, 30, 0.05);
    border: 1px solid rgba(30, 30, 30, 0.1);
    border-radius: 9999px;
    padding: 0.65rem 1.25rem;
  }
  .hero__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1.25rem;
    max-width: 56rem;
    margin-inline: auto;
    padding: 4rem 1.5rem;
  }
  .hero__badge {
    display: inline-block;
    border: 1px solid rgba(30, 30, 30, 0.15);
    border-radius: 9999px;
    padding: 0.5rem 1.25rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(30, 30, 30, 0.7);
  }
  .hero__title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1.08;
  }
  /* Marca-texto amarelo. O gradiente deixa uma faixa limpa em cima e embaixo
     para a cor não virar um retângulo cheio: o traço fica com cara de caneta
     passada por cima da palavra, e não de fundo colorido. */
  .hero__hl {
    background: linear-gradient(
      180deg,
      transparent 14%,
      #ffe94d 14%,
      #ffe94d 92%,
      transparent 92%
    );
    color: inherit;
    padding: 0 0.1em;
    /* Sem isto, uma palavra que quebrasse em duas linhas ganharia um único
       traço esticado atrás das duas metades. */
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .hero__sub {
    color: rgba(30, 30, 30, 0.8);
    font-size: 1.05rem;
    max-width: 42rem;
  }
  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: #1e1e1e;
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 1.25rem 2.5rem;
    border: none;
    border-radius: 9999px;
    transition: transform 0.2s ease;
  }
  /* `btn-cta` entra só para o funil interno contar o clique (src/scripts/funil.ts).
     O `opacity: 1` cancela o fade que `.btn-cta:hover` traz do global.css, para o
     hover do hero continuar sendo só a escala. */
  .hero__cta:hover { transform: scale(1.02); opacity: 1; }
  .hero__cta-arrow {
    width: 2.25rem;
    height: 2.25rem;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .hero__trust {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .hero__trust-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(30, 30, 30, 0.75);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .hero__trust-item::before {
    content: '';
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 9999px;
    background: rgba(30, 30, 30, 0.3);
  }
  .hero__stats {
    padding-bottom: 3rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .hero__stat {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    border: 1px solid rgba(30, 30, 30, 0.1);
    border-radius: 1rem;
    padding: 1.25rem;
  }
  .hero__stat-value { font-weight: 700; font-size: 1.5rem; line-height: 1; }
  .hero__stat-label {
    font-weight: 500;
    color: rgba(30, 30, 30, 0.75);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  /* ---- Variação com foto (hero--foto) -------------------------------------
     Mesmo hero, em duas colunas, com a foto do Felipe à direita — o formato do
     hero da /workshop-black-exponencial-2026. No celular a foto vai para
     baixo do texto, para o título continuar sendo a primeira coisa na tela. */
  .hero__texto {
    display: contents;
  }
  .hero--foto .hero__texto {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .hero__nav-cta { display: inline-flex; }
    .hero__stats { grid-template-columns: repeat(4, 1fr); }
  }

  /* ---- Celular: foto ocupando o hero, texto por cima ----------------------
     Formato pedido pela usuária em 17/09 (referência: a LP do Rise). A foto
     preenche o hero e o texto fica sobre ela, no rodapé, com um degradê escuro
     que garante a leitura. O título, a frase e o botão cabem na primeira tela
     mesmo num celular de 600px de altura útil.
     Acima de 900px isto some e volta o hero em duas colunas, sobre o bege. */
  .hero--foto { min-height: 0; }
  /* Sem a faixa do logo no celular (pedido em 17/09): a foto começa no topo da
     tela e ganha a altura que a faixa ocupava. O logo volta no desktop. */
  .hero--foto .hero__nav { display: none; }
  .hero--foto .hero__body {
    position: relative;
    max-width: none;
    margin-inline: 0;
    min-height: 88svh;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 1.25rem 1.25rem 1.75rem;
    overflow: hidden;
  }
  .hero--foto .hero__visual {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero--foto .hero__foto {
    width: 100%;
    height: 100%;
    max-width: none;
    border-radius: 0;
    object-fit: cover;
    /* O rosto fica no terço de cima da foto; sem isto o corte do `cover`
       centraliza e corta a testa em tela estreita. */
    object-position: 50% 12%;
  }
  /* Degradê por cima da foto: transparente onde está o rosto, escuro onde
     entra o texto. É o que torna o texto branco legível sem tapar a imagem. */
  .hero--foto .hero__visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(20, 18, 16, 0) 26%,
      rgba(20, 18, 16, 0.35) 44%,
      rgba(20, 18, 16, 0.82) 62%,
      rgba(20, 18, 16, 0.96) 80%
    );
  }
  .hero--foto .hero__texto {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: #f7f3ee;
  }
  .hero--foto .hero__title { font-size: clamp(1.5rem, 6.2vw, 2rem); line-height: 1.14; }
  .hero--foto .hero__sub { color: rgba(247, 243, 238, 0.85); font-size: 0.85rem; line-height: 1.4; }
  /* Botão claro: sobre o degradê escuro, o pill preto padrão sumiria. Menor
     que o padrão e com largura pelo conteúdo: em duas linhas e ocupando a
     largura toda, ele dominava a tela (ajuste pedido em 17/09). */
  .hero--foto .hero__cta {
    background: #f7f3ee;
    color: #1e1e1e;
    margin-top: 0.15rem;
    align-self: center;
    width: auto;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    padding: 0.7rem 1.15rem;
    gap: 0.5rem;
  }
  /* A bolinha da seta tem 2,25rem no hero padrão e é ela que deixava o botão
     alto no celular. */
  .hero--foto .hero__cta-arrow {
    width: 1.4rem;
    height: 1.4rem;
    font-size: 0.75rem;
    background: rgba(30, 30, 30, 0.12);
  }
  .hero--foto .hero__trust { font-size: 0.72rem; gap: 0.75rem; }
  /* O selo sai no celular: é a linha menos essencial das quatro e é ela que
     libera a altura para o rosto aparecer acima do texto. */
  .hero--foto .hero__badge { display: none; }
  .hero--foto .hero__trust,
  .hero--foto .hero__trust-item { color: rgba(247, 243, 238, 0.75); }

  @media (min-width: 900px) {
    .hero--foto .hero__nav { display: flex; }
    /* No desktop volta o hero em duas colunas sobre o bege: sem degradê, sem
       texto por cima da foto, com a foto numa coluna própria. */
    .hero--foto { min-height: 100vh; }
    .hero--foto .hero__visual { position: static; }
    .hero--foto .hero__visual::after { content: none; }
    .hero--foto .hero__foto {
      height: auto;
      border-radius: 1rem;
      object-fit: contain;
    }
    .hero--foto .hero__texto { color: inherit; }
    .hero--foto .hero__title { font-size: clamp(2.25rem, 4vw, 3.25rem); }
    .hero--foto .hero__sub { color: rgba(30, 30, 30, 0.7); font-size: 1rem; }
    .hero--foto .hero__badge {
      display: inline-block;
      border-color: rgba(30, 30, 30, 0.15);
      color: rgba(30, 30, 30, 0.7);
      font-size: 0.7rem;
    }
    .hero--foto .hero__cta {
      background: #1e1e1e;
      color: #f5f0eb;
      font-size: 0.875rem;
      letter-spacing: 0.1em;
      padding: 1.1rem 2.25rem;
      gap: 0.75rem;
    }
    .hero--foto .hero__cta-arrow {
      width: 2.25rem;
      height: 2.25rem;
      font-size: inherit;
      background: rgba(255, 255, 255, 0.1);
    }
    .hero--foto .hero__trust { font-size: inherit; }
    .hero--foto .hero__trust,
    .hero--foto .hero__trust-item { color: inherit; }
    .hero--foto .hero__body {
      position: static;
      min-height: 0;
      overflow: visible;
      margin-inline: auto;
      gap: 2.5rem;
      padding: 4rem 1.5rem;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      text-align: left;
    }
    .hero--foto .hero__texto { align-items: flex-start; }
    .hero--foto .hero__cta { align-self: flex-start; }
    .hero--foto .hero__foto { max-width: 26rem; }
  }
</style>
