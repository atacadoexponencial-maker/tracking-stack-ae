---
// Bloco 2 — Suas ofertas (issue 298).
//
// O bloco mais longo do planner, e o único que carrega um aviso capaz de
// contradizer o que a pessoa escreveu (desconto acima da margem). Aqui tudo
// isso é marcação inerte: a issue 301 liga as faixas e o aviso, a 302 liga a
// escolha de narrativa e a Black VIP condicional.
//
// As narrativas citam a marca. O nome ainda não existe quando a página carrega,
// então cada citação vira um `<span data-marca>` com o marcador de lacuna — é
// ele que a issue 301 troca pelo nome digitado no cabeçalho. O texto é fatiado
// em `{marca}` e remontado com elementos de verdade, em vez de injetado como
// HTML.

import CampoPlanner from './CampoPlanner.astro';
import PlannerAvancar from './PlannerAvancar.astro';
import { BLOCO_2, LACUNA_MARCA } from '../../data/planner-black.js';

// 'a Black da {marca} começa...' → ['a Black da ', ' começa...']
function fatiar(texto) {
  return texto.split('{marca}');
}
---

<section class="pl-bloco" id={`bloco-${BLOCO_2.id}`} data-bloco={BLOCO_2.numero} aria-labelledby="titulo-bloco-2">
  <p class="pl-bloco__selo">Bloco {BLOCO_2.numero} de 4</p>
  <h2 class="pl-bloco__titulo" id="titulo-bloco-2">{BLOCO_2.titulo}</h2>
  <p class="pl-bloco__abertura">{BLOCO_2.abertura}</p>

  <CampoPlanner campo={BLOCO_2.margem} />

  {BLOCO_2.picos.map((pico) => (
    <div class="pl-secao" data-pico={pico.id}>
      <h3 class="pl-secao__titulo">{pico.titulo}</h3>

      <CampoPlanner campo={pico.inicio} />

      <!-- Narrativa: escolha de uma só. A exclusividade entre as três é do
           tipo `radio`; a regra de "escrever a sua desmarca a escolhida" é da
           issue 302. -->
      <p class="pl-sub">{pico.narrativa.rotulo}</p>
      <p class="pl-campo__apoio">{pico.narrativa.apoio}</p>
      <div class="pl-opcoes" role="radiogroup" data-grupo-narrativa={pico.id}>
        {pico.narrativa.opcoes.map((opcao) => (
          <label class="pl-opcao">
            <input type="radio" name={pico.narrativa.chave} value={opcao.valor} />
            <span>
              <span class="pl-opcao__angulo">{opcao.angulo}:</span>{' '}
              {fatiar(opcao.texto).map((parte, i) => (
                <>
                  {i > 0 && <span class="pl-marca" data-marca>{LACUNA_MARCA}</span>}
                  {parte}
                </>
              ))}
            </span>
          </label>
        ))}
      </div>
      <CampoPlanner campo={pico.narrativa.propria} />

      {pico.id === 'pico1' && (
        <>
          <!-- Espelho do bloco 1: só de leitura, preenchido pela issue 301. -->
          <div class="pl-campo">
            <span class="pl-campo__rotulo">{pico.espelho.rotulo}</span>
            <div class="pl-campo__controle">
              <p class="pl-espelho pl-calculado" id={pico.espelho.id} data-espelho={pico.espelho.origem}>—</p>
              <span class="pl-campo__sufixo">{pico.espelho.sufixo}</span>
            </div>
          </div>

          <CampoPlanner campo={pico.minimoReduzido} />
          <CampoPlanner campo={pico.minimoAte} />

          <p class="pl-sub">{pico.progressivo.titulo}</p>
          <table class="pl-tabela pl-tabela--progressivo" data-progressivo={pico.progressivo.origem}>
            <thead>
              <tr>
                <th scope="col">Se comprar</th>
                <th scope="col">Desconto</th>
              </tr>
            </thead>
            <tbody>
              {pico.progressivo.faixas.map((faixa) => (
                <tr>
                  <td>
                    <span class="pl-calculado" id={faixa.alvoId} data-multiplo={faixa.multiplo}>—</span>
                    {' '}peças
                  </td>
                  <td>
                    <input type="number" name={faixa.chave} value={faixa.padrao} min="0" max="100" aria-label={`Desconto para ${faixa.multiplo}x o mínimo`} />
                    {' '}%
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="pl-campo__apoio">{pico.progressivo.apoio}</p>

          <!-- Aviso de margem: escondido até a issue 301 ter motivo para
               mostrá-lo. Avisa e não bloqueia — decisão de spec. -->
          <p class="pl-aviso" id={pico.progressivo.avisoId} role="status" aria-live="polite" hidden></p>
        </>
      )}

      <p class="pl-sub">{pico.extras.rotulo}</p>
      <p class="pl-campo__apoio">{pico.extras.apoio}</p>
      <div class="pl-opcoes">
        {pico.extras.opcoes.map((opcao) => (
          <label class="pl-opcao">
            <input type="checkbox" name={pico.extras.chave} value={opcao.valor} />
            <span>{opcao.texto}</span>
          </label>
        ))}
      </div>

      <CampoPlanner campo={pico.condicao} />

      {pico.id === 'pico2' && (
        <>
          <p class="pl-sub">{pico.vip.rotulo}</p>
          <p class="pl-campo__apoio">{pico.vip.apoio}</p>
          <div class="pl-opcoes">
            {pico.vip.opcoes.map((opcao) => (
              <label class="pl-opcao pl-opcao--linha">
                <input type="radio" name={pico.vip.chave} value={opcao.valor} />
                <span>{opcao.texto}</span>
              </label>
            ))}
          </div>

          <!-- Região condicional: responder "não" tira isto da tela e da
               impressão. Quem esconde é a issue 302. -->
          <div id={pico.vip.regiaoId} data-condicional={pico.vip.chave}>
            {pico.vip.detalhes.map((campo) => <CampoPlanner campo={campo} />)}
          </div>
        </>
      )}
    </div>
  ))}

  <PlannerAvancar depoisDe={BLOCO_2.id} />
</section>
