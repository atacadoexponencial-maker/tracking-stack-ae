---
/**
 * Conteúdo da LP perene do workshop quinzenal gratuito. Usado pela
 * /workshop-gratuito (A) e pela /workshop-gratuito-v2 (B, teste A/B dos
 * stories no hero): a copy é uma só e nunca diverge.
 *
 * Refeita em 29/09/2026 com os componentes de seção da home, para ter a cara
 * das outras páginas do site (a primeira versão usava uma paleta própria).
 * Estrutura inspirada na LP de lives da Orbyka: vende a tese (a Equação
 * Exponencial, atacado não é varejo) e a live aparece como o lugar onde ela é
 * ensinada.
 *
 * Não tem edição, data, material nem gravação. O formulário (LeadFormModal)
 * manda para o /tracker com funnel "workshop"; o backend cria o card no
 * ClickUp e devolve o destino (env LEAD_REDIRECT_WORKSHOP = grupo de WhatsApp
 * dos workshops). Os botões dos componentes de seção carregam
 * data-open-chat, que o LeadFormModal também escuta.
 *
 * Os números do hero seguem os da home. A pergunta "vai ter venda no final?"
 * ficou fora do FAQ por decisão da usuária (29/09).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Hero from './sections/Hero.astro';
import Pain from './sections/Pain.astro';
import Pillars from './sections/Pillars.astro';
import Fit from './sections/Fit.astro';
import HowItWorks from './sections/HowItWorks.astro';
import LogoWall from './sections/LogoWall.astro';
import VideoTestimonials from './sections/VideoTestimonials.astro';
import AboutFelipe from './sections/AboutFelipe.astro';
import Faq from './sections/Faq.astro';
import FinalCta from './sections/FinalCta.astro';
import StickyCta from './StickyCta.astro';
import LeadFormModal from './LeadFormModal.astro';
import StoriesDepoimentos from './StoriesDepoimentos.astro';

interface Props {
  /**
   * Versão B do teste A/B: stories de depoimento no hero, no lugar dos selos
   * (Gratuito, Ao vivo...). É a única diferença entre as duas páginas.
   */
  stories?: boolean;
  noindex?: boolean;
}
const { stories = false, noindex = false } = Astro.props;

const CTA = 'Quero participar do próximo workshop';

// Os mesmos depoimentos em vídeo da home.
const depoimentos = [
  { name: 'Jaque', videoId: '101c1525-fa13-4fe6-a61e-fe38600dec12' },
  { name: 'Barraca do Willinha', videoId: 'a7d5602a-4f1e-4d28-9b83-9cfc53fde08a' },
  { name: 'Adriana', videoId: '03f4e18a-1f52-40f5-844a-3f900f705126' },
  { name: 'Jossanclê', videoId: 'd8d67535-9b07-4713-a21f-14eb4cd70f6b' },
];

// Prints de depoimentos, os mesmos das páginas de lives (src/assets/proof/).
const proofModules = import.meta.glob('../assets/proof/*.{jpg,png}', { eager: true });
const proofImages = Object.entries(proofModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, m]) => (m as { default: ImageMetadata }).default);

// Stories da versão B: prints do workshop e vídeos da mentoria, intercalados
// (um vídeo a cada dois prints), como a usuária pediu em 29/09.
const storiesItens = [];
{
  const prints = proofImages.map((img) => ({ tipo: 'print' as const, img, rotulo: 'Workshop' }));
  const videos = depoimentos.map((d) => ({ tipo: 'video' as const, videoId: d.videoId, rotulo: d.name }));
  while (prints.length || videos.length) {
    if (videos.length) storiesItens.push(videos.shift()!);
    storiesItens.push(...prints.splice(0, 2));
  }
}

// Comparação no molde do "Pago x Gratuito" da Orbyka: o atacado vem primeiro,
// em cartão claro com etiqueta amarela; o varejo fica ao lado, apagado.
const varejoAtacado = [
  { tema: 'Quem compra', atacado: 'Lojista, em grade, com pedido mínimo', varejo: 'Consumidor final, uma peça' },
  { tema: 'O que conta', atacado: 'Revendedor novo e recompra', varejo: 'Seguidor e engajamento' },
  { tema: 'Onde vende', atacado: 'Catálogo e WhatsApp', varejo: 'Carrinho do site' },
  { tema: 'Quando dá lucro', atacado: 'Quando o revendedor volta', varejo: 'Na primeira compra' },
];
---

<BaseLayout
  title="Workshop gratuito quinzenal para marcas de atacado | Atacado Exponencial"
  description="A cada 15 dias, uma aula gratuita e ao vivo com Felipe Santos sobre um dos dois lados que fazem um atacado crescer: revendedor novo entrando e revendedor ativo voltando a comprar."
  showHeader={false}
  noindex={noindex}
>
  <Hero
    badge="Método aplicado em mais de 100 marcas de atacado"
    headline="A conta que faz um atacado crescer tem dois lados. A cada 15 dias, o Felipe abre um deles ao vivo."
    highlight="ao vivo"
    subheadline="Cada aula pega um lado e vai até o fim nele: como fazer entrar revendedor novo todo mês, ou como fazer quem já comprou voltar a comprar."
    navCtaLabel="Quero participar"
    ctaLabel={CTA}
    trust={['Gratuito', 'Ao vivo', 'A cada 15 dias', 'Para quem fatura acima de R$ 20 mil/mês']}
    stats={[
      { value: '+100', label: 'marcas de atacado atendidas' },
      { value: '1h', label: 'de aula ao vivo' },
      { value: 'R$ 0', label: 'para participar' },
      { value: '1º', label: 'método próprio para atacado' },
    ]}
  >
    {stories && <StoriesDepoimentos slot="abaixo-cta" itens={storiesItens} />}
  </Hero>

  <main>
    <Pain
      eyebrow="Reconhece?"
      title="Você já assistiu aula de marketing que só falava de seguidor e cliente final."
      sub="Anotou tudo. Na segunda abriu o WhatsApp da marca e não sabia por onde começar."
      points={[
        'Seu faturamento oscila todo mês e você não sabe dizer exatamente por quê',
        'Você manda o catálogo, a pessoa responde "vou ver com calma" e some',
        'O revendedor faz o primeiro pedido e nunca mais volta',
        'Você aplica estratégia de varejo e e-commerce que não funciona para atacado',
      ]}
    />

    <!-- Varejo x atacado -->
    <section class="section va">
      <div class="container">
        <span class="eyebrow va__eyebrow">Por que outra aula</span>
        <h2 class="va__titulo"><mark>Atacado</mark> <span class="va__x" aria-hidden="true">×</span><span class="sr-only"> contra </span> Varejo</h2>
        <div class="va__linhas">
          {varejoAtacado.map((l) => (
            <div class="va__linha">
              <h3 class="va__tema">{l.tema}</h3>
              <div class="va__cards">
                <div class="va__card va__card--atacado">
                  <span class="va__tag">Atacado</span>
                  <p>{l.atacado}</p>
                </div>
                <span class="va__vs" aria-hidden="true">×</span>
                <div class="va__card va__card--varejo">
                  <span class="va__tag">Varejo</span>
                  <p>{l.varejo}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
        <p class="va__fecho">Aqui o assunto é revendedor, pedido mínimo, grade e recompra. Mais nada.</p>
      </div>
    </section>

    <Pillars
      eyebrow="A Equação Exponencial"
      title="Um atacado cresce por dois lados"
      pillars={[
        {
          number: 'Pilar I',
          title: 'Novos revendedores de forma previsível',
          description: 'Revendedor novo entrando todo mês por um processo que você controla. Indicação e algoritmo viram bônus.',
        },
        {
          number: 'Pilar II',
          title: 'Alta retenção de revendedores ativos',
          description: 'No atacado, o cliente só vira seu quando compra a segunda vez. Esse lado cuida de quem já comprou voltar com pedido maior.',
        },
      ]}
      footer="Cada workshop pega um desses lados e vai até o fim nele."
    >
      <p slot="sub" class="section-sub">O tema de cada edição diz de qual lado você vai trabalhar.</p>
    </Pillars>

    <Fit
      eyebrow="Funciona para quem?"
      title="O workshop é para marca de atacado"
      sub="Moda, íntima, praia, fitness, infantil, calçados, acessórios, casa e o que mais você vender para lojista."
      yesTitle="Faz sentido se:"
      yes={[
        'Você vende para lojista, sacoleira ou revendedor',
        'Sua marca fatura acima de R$ 20 mil por mês',
        'Alguém da marca vai aplicar o que aprender',
      ]}
      noTitle="Não vai funcionar se:"
      no={[
        'Você vende peça avulsa para consumidor final',
        'Está começando e ainda não tem produto rodando',
        'Quer fórmula pronta sem mexer na operação',
      ]}
    />

    <HowItWorks
      title="Três passos até a aula"
      sub="Uma aula de cerca de 1 hora, ao vivo, a cada 15 dias."
      steps={[
        { number: '01', title: 'Inscrição', description: 'Você se inscreve e entra no grupo de WhatsApp dos workshops.' },
        { number: '02', title: 'Tema e link', description: 'A cada 15 dias, o tema e o link da aula chegam no grupo.' },
        { number: '03', title: 'Ao vivo', description: 'Você assiste ao vivo com o Felipe.' },
      ]}
      ctaLabel={CTA}
      ctaNote="Gratuito. A data de cada edição chega no grupo com antecedência."
    />

    <LogoWall
      title="Marcas de atacado de verdade, com operação de verdade"
      sub="Mais de 100 marcas já passaram pelo método. Moda festa, praia, infantil, lingerie, calçados, acessórios."
    />

    <VideoTestimonials
      title="O que acontece quando a marca arruma os dois lados"
      sub="Tem marca que chegou faturando dezenas de milhares por mês e hoje passa dos R$ 400 mil. Não foi rápido e não foi sorte. Foi arrumar a entrada e a recompra, nessa ordem."
      videos={depoimentos}
    />

    <!-- Depoimentos (prints) -->
    <section class="section prints">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Depoimentos</span>
          <h2 class="section-title">O que dizem quem já aplicou o método</h2>
        </div>
        <div class="prints__grid">
          {proofImages.map((img, i) => (
            <Image src={img} alt={`Depoimento ${i + 1}`} class="prints__img" loading="lazy" />
          ))}
        </div>
      </div>
    </section>

    <AboutFelipe
      bio={[
        'Comecei no varejo em 2013. Em 2018 me mudei para o Bom Retiro, no coração do atacado de São Paulo, a convite de uma grande influenciadora de moda do país, e passei quase dois anos gerenciando uma marca de atacado de moda feminina com uma missão só: fazer ela vender pela internet.',
        'Aquilo virou laboratório. Quase tudo que funcionava no varejo não funcionava ali, e eu tive que descobrir na prática o que funcionava.',
        'De lá pra cá foram mais de 100 marcas atendidas e um método construído do zero para o mercado atacado, que é o Atacado Exponencial.',
      ]}
    />

    <Faq
      sub="Ficou alguma dúvida de fora? Entra no grupo e pergunta direto para o nosso time."
      faqs={[
        { q: 'Preciso já vender no atacado?', a: 'Sim. É para marca que já tem base de revendedores e fatura acima de R$ 20 mil por mês.' },
        { q: 'Quanto custa?', a: 'Nada. O workshop é gratuito.' },
        { q: 'Quanto tempo dura?', a: 'Cerca de 1 hora, ao vivo.' },
        { q: 'E se eu não puder assistir ao vivo?', a: 'A aula não fica gravada. Por isso a data chega com antecedência no grupo, para você se organizar.' },
        { q: 'Vou receber muita mensagem no grupo?', a: 'O grupo só recebe aviso de workshop. Você pode sair quando quiser.' },
        { q: 'Serve para o meu nicho?', a: 'O método é de atacado, não de produto. Funciona para moda, íntima, praia, calçados, acessórios, casa e o que mais você vender para lojista.' },
      ]}
    />

    <FinalCta
      title="Você sabe de qual lado a conta do seu atacado está travando?"
      sub="A cada 15 dias, uma aula ao vivo sobre um dos dois lados. Você só precisa estar no grupo para receber o link."
      ctaLabel={CTA}
      notes={['Gratuito', 'Ao vivo com o Felipe']}
    />
  </main>

  <StickyCta label="Quero participar" note="grátis · ao vivo" />
  <LeadFormModal />
</BaseLayout>

<style is:global>
  /* As headlines do workshop são mais longas que a da home: no tamanho padrão
     do Hero o botão saía da primeira tela do celular (medido em 390x664).
     Global porque .hero__title é do componente Hero; só vale nas páginas que
     usam este componente. */
  @media (max-width: 767px) {
    /* Seletor reforçado: precisa vencer o estilo com escopo do Hero. */
    .hero h1.hero__title { font-size: 1.75rem; }
    /* O botão do topo some no celular e a logo ficava sozinha à esquerda,
       grande demais (pedido da usuária em 29/09): menor e centralizada. */
    .hero nav.hero__nav { justify-content: center; padding-block: 1rem; }
    .hero img.hero__logo { height: 1.5rem; }
  }
</style>

<style>
  /* Varejo x atacado. O título é o maior texto da página depois do hero:
     a seção precisa parar quem está rolando (pedido da usuária em 29/09). */
  .va .container { text-align: center; }
  .va__eyebrow { display: block; }
  .va__titulo {
    margin-top: 0.75rem;
    font-size: clamp(2.75rem, 12vw, 5.5rem);
    font-weight: 900; text-transform: uppercase; line-height: 1; letter-spacing: -0.02em;
  }
  .va__titulo mark {
    background: linear-gradient(180deg, transparent 12%, #ffe94d 12%, #ffe94d 90%, transparent 90%);
    color: #1e1e1e; padding: 0 0.08em;
  }
  .va__x { color: #ffe94d; font-weight: 400; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .va__linhas { margin: 3rem auto 0; max-width: 56rem; display: grid; gap: 2rem; text-align: left; }
  .va__tema { font-size: clamp(1.15rem, 4.5vw, 1.5rem); font-weight: 800; margin-bottom: 0.75rem; }
  .va__cards { display: grid; grid-template-columns: 1fr auto 1fr; align-items: stretch; gap: 0.5rem; }
  .va__vs { align-self: center; font-size: 1.5rem; font-weight: 700; }
  .va__card {
    border-radius: 0.75rem; padding: 0.75rem;
    display: flex; flex-direction: column; gap: 0.75rem; min-height: 7.5rem;
  }
  .va__card p { margin: auto 0; font-weight: 700; line-height: 1.3; font-size: clamp(0.95rem, 3.8vw, 1.15rem); }
  .va__tag {
    align-self: flex-start; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    padding: 0.25rem 0.5rem; border-radius: 0.375rem;
  }
  .va__card--atacado { background: hsl(var(--light-bg)); color: hsl(var(--light-fg)); }
  .va__card--atacado .va__tag { background: #ffe94d; color: #1e1e1e; }
  .va__card--varejo { background: hsl(var(--secondary)); color: hsl(var(--muted-foreground)); }
  .va__card--varejo .va__tag { background: rgba(255, 255, 255, 0.12); color: hsl(var(--muted-foreground)); }
  .va__card--varejo p { font-weight: 500; }

  @media (min-width: 768px) {
    .va__linha { display: grid; grid-template-columns: 1fr 2fr; align-items: center; gap: 2rem; }
    .va__tema { margin-bottom: 0; }
    .va__card { padding: 1rem; min-height: 9rem; }
  }

  .va__fecho { margin-top: 3rem; text-align: center; font-size: clamp(1.25rem, 3vw, 1.6rem); font-weight: 800; }

  .prints__grid { margin-top: 2.5rem; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .prints__img { width: 100%; height: auto; border-radius: 1rem; object-fit: cover; }
  @media (min-width: 768px) { .prints__grid { grid-template-columns: repeat(3, 1fr); } }
</style>
