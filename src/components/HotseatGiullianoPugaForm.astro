---
/**
 * Hotseat especial com Giulliano Puga: apresentação + formulário numa tela só.
 *
 * Visual da capa da /aplicacao-plano-ao-vivo (papel claro, cartão branco, selo
 * verde). Aqui não há etapas: são 4 campos e 2 perguntas de um toque, tudo
 * visível, para ninguém desistir no meio (pedido dela em 11/11).
 *
 * Não vira lead: o envio vai só para /api/hotseat-giulliano-puga, que grava na
 * planilha. Por isso não reaproveita o AplicacaoForm (amarrado ao /tracker).
 */
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-horizontal-preto.png';
import { PERGUNTAS, TEXTOS, MAX_TEXTO } from '../data/hotseat-giulliano-puga.js';

const TIPO_INPUT = { telefone: 'tel', email: 'email' };
const MODO = { telefone: 'tel', email: 'email' };
---

<main class="section hotseat">
  <div class="container hotseat__inner">
    <Image src={logo} alt="Atacado Exponencial" height={72} class="hotseat__logo" />

    <div class="hotseat__grade">
      <div class="hotseat__texto">
        <span class="hotseat__selo">{TEXTOS.selo}</span>
        <h1 class="hotseat__titulo">{TEXTOS.titulo}</h1>
        <p class="hotseat__sub">{TEXTOS.subtitulo}</p>
        <ul class="hotseat__numeros">
          {TEXTOS.numeros.map((n) => (
            <li>
              <strong>{n.valor}</strong>
              <span>{n.rotulo}</span>
            </li>
          ))}
        </ul>
        <dl class="hotseat__info">
          <div>
            <dt>
              <svg class="hotseat__icone" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16.5" rx="2.5"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/></svg>
              Quando
            </dt>
            <dd>{TEXTOS.quando}</dd>
          </div>
          <div>
            <dt>
              <svg class="hotseat__icone" viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="6" width="13" height="12" rx="2.5"/><path d="M15.5 10.5 21.5 7v10l-6-3.5"/></svg>
              Onde
            </dt>
            <dd>{TEXTOS.onde}</dd>
          </div>
        </dl>
      </div>

      <form class="hotseat__cartao" id="hs-form" novalidate>
        <div id="hs-campos" class="hotseat__campos">
          <p class="hotseat__cartao-titulo">{TEXTOS.formTitulo}</p>
          {PERGUNTAS.map((p) => (
            p.tipo === 'uma' ? (
              <fieldset class="hotseat__campo hotseat__grupo" data-campo={p.name}>
                <legend>{p.rotulo}</legend>
                <div class="hotseat__opcoes">
                  {p.opcoes.map((o) => (
                    <label class="hotseat__opcao">
                      <input type="radio" name={p.name} value={o} />
                      <span>{o}</span>
                    </label>
                  ))}
                </div>
                <small class="hotseat__campo-erro" hidden></small>
              </fieldset>
            ) : (
              <label class="hotseat__campo" data-campo={p.name}>
                <span>{p.rotulo}</span>
                <input
                  name={p.name}
                  type={TIPO_INPUT[p.tipo] ?? 'text'}
                  inputmode={MODO[p.tipo]}
                  maxlength={MAX_TEXTO}
                  placeholder={p.placeholder}
                  autocomplete={p.autocomplete ?? 'off'}
                  autocapitalize={p.name === 'nome' ? 'words' : 'none'}
                />
                <small class="hotseat__campo-erro" hidden></small>
              </label>
            )
          ))}
          <p id="hs-erro" class="hotseat__erro" role="alert" hidden></p>
          <button type="submit" id="hs-enviar" class="btn-cta hotseat__cta">{TEXTOS.cta}</button>
          <p class="hotseat__nota">{TEXTOS.nota} {TEXTOS.privacidade}</p>
        </div>

        <div id="hs-obrigado" class="hotseat__obrigado" hidden>
          <span class="hotseat__check" aria-hidden="true">✓</span>
          <p class="hotseat__obrigado-titulo">{TEXTOS.obrigado.titulo}</p>
          <p class="hotseat__obrigado-texto">{TEXTOS.obrigado.texto}</p>
          <p class="hotseat__obrigado-texto" id="hs-obrigado-analise" hidden>{TEXTOS.obrigado.analise}</p>
        </div>
      </form>
    </div>
  </div>
</main>

<style>
  /* Página clara, como a /aplicacao-plano-ao-vivo. As cores são locais. */
  :global(body) { background: #f5f0eb; }
  .hotseat {
    --hs-papel: #f5f0eb; --hs-cartao: #ffffff; --hs-texto: #1e1e1e; --hs-suave: #5c5650;
    --hs-linha: rgba(30, 30, 30, 0.14); --hs-verde: #1f7a45; --hs-verde-fundo: rgba(31, 122, 69, 0.08);
    --hs-erro: #b42318;
    background: var(--hs-papel); color: var(--hs-texto);
    min-height: 100dvh; padding-block: 1.25rem 2rem;
  }
  .hotseat__inner { display: flex; flex-direction: column; gap: 1.25rem; max-width: 34rem; margin-inline: auto; }
  .hotseat__logo { height: 1.75rem; width: auto; align-self: center; }
  .hotseat__grade { display: grid; gap: 1.5rem; align-items: start; }

  .hotseat__texto { display: flex; flex-direction: column; align-items: flex-start; text-align: left; }
  .hotseat__selo {
    align-self: center;
    font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em;
    color: var(--hs-verde); background: var(--hs-verde-fundo);
    border: 1px solid rgba(31, 122, 69, 0.35); border-radius: 999px; padding: 0.4rem 0.95rem;
  }
  .hotseat__titulo { margin: 1rem 0 0; font-size: 1.9rem; line-height: 1.1; font-weight: 700; text-wrap: balance; }
  .hotseat__sub { margin: 0.75rem 0 0; font-size: 1.05rem; line-height: 1.5; text-wrap: pretty; }

  .hotseat__numeros {
    list-style: none; margin: 1.25rem 0 0; padding: 0; width: 100%;
    display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;
  }
  .hotseat__numeros li {
    display: flex; flex-direction: column; gap: 0.15rem;
    background: var(--hs-cartao); border: 1px solid var(--hs-linha); border-radius: 0.75rem; padding: 0.75rem 0.9rem;
  }
  .hotseat__numeros strong { font-size: 1.1rem; line-height: 1.2; font-weight: 700; }
  .hotseat__numeros span { font-size: 0.8rem; line-height: 1.35; color: var(--hs-suave); }

  .hotseat__info {
    margin: 0.75rem 0 0; width: 100%; display: grid; grid-template-columns: 1fr 1fr;
    border: 1px solid var(--hs-linha); border-radius: 0.75rem; background: var(--hs-cartao);
  }
  .hotseat__info > div { padding: 0.75rem 0.9rem; }
  .hotseat__info > div + div { border-left: 1px solid var(--hs-linha); }
  .hotseat__info dt {
    display: flex; align-items: center; gap: 0.4rem;
    font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--hs-suave);
  }
  .hotseat__icone {
    width: 1.05rem; height: 1.05rem; flex: none;
    fill: none; stroke: var(--hs-verde); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
  }
  .hotseat__info dd { margin: 0.3rem 0 0; font-size: 0.95rem; font-weight: 700; line-height: 1.35; }

  .hotseat__cartao {
    background: var(--hs-cartao); border: 1px solid var(--hs-linha); border-radius: 1rem;
    box-shadow: 0 1px 2px rgba(30, 30, 30, 0.04), 0 8px 24px rgba(30, 30, 30, 0.06);
    padding: 1.5rem 1.25rem; text-align: left;
  }
  .hotseat__campos { display: flex; flex-direction: column; gap: 0.9rem; }
  .hotseat__campos[hidden], .hotseat__obrigado[hidden] { display: none; }
  .hotseat__cartao-titulo { margin: 0; font-size: 1.25rem; font-weight: 700; line-height: 1.2; }

  .hotseat__campo { display: flex; flex-direction: column; gap: 0.4rem; border: 0; margin: 0; padding: 0; min-width: 0; }
  .hotseat__campo > span,
  .hotseat__campo > legend { font-size: 0.9rem; font-weight: 700; line-height: 1.35; padding: 0; }
  .hotseat__campo > legend { margin-bottom: 0.4rem; }
  .hotseat__campo input:not([type="radio"]) {
    width: 100%; padding: 0.8rem 1rem; border: 1px solid var(--hs-linha); border-radius: 0.75rem;
    background: #ffffff; color: var(--hs-texto); font-family: inherit; font-size: 1rem;
  }
  .hotseat__campo input::placeholder { color: #8a837c; }
  .hotseat__campo input:not([type="radio"]):focus { outline: none; border-color: var(--hs-texto); }
  .hotseat__campo[data-invalido] input:not([type="radio"]) { border-color: var(--hs-erro); }

  .hotseat__opcoes { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .hotseat__opcao {
    display: flex; align-items: center; justify-content: center; text-align: center; cursor: pointer;
    padding: 0.6rem 0.75rem; min-height: 48px;
    border: 1px solid var(--hs-linha); border-radius: 0.75rem;
    font-size: 0.95rem; line-height: 1.25; background: #ffffff;
    transition: border-color 0.15s, background-color 0.15s;
  }
  .hotseat__opcao:hover { border-color: rgba(30, 30, 30, 0.35); }
  /* O toque marca o cartão inteiro; a bolinha some sem sair do teclado. */
  .hotseat__opcao input { position: absolute; opacity: 0; pointer-events: none; }
  .hotseat__opcao:has(input:checked) { border-color: var(--hs-verde); background: var(--hs-verde-fundo); font-weight: 700; }
  .hotseat__opcao:has(input:focus-visible) { outline: 2px solid var(--hs-texto); outline-offset: 2px; }

  .hotseat__campo-erro, .hotseat__erro { color: var(--hs-erro); font-size: 0.85rem; margin: 0; }
  .hotseat__erro[hidden] { display: none; }
  .hotseat__cta {
    margin-top: 0.35rem; width: 100%; justify-content: center;
    background: var(--hs-texto); color: #ffffff; padding: 1.1rem 1rem; min-height: 3.25rem;
  }
  .hotseat__cta:disabled { opacity: 0.7; cursor: default; }
  .hotseat__nota { margin: 0; font-size: 0.8rem; color: var(--hs-suave); text-align: center; }

  .hotseat__obrigado { display: flex; flex-direction: column; align-items: center; text-align: center; padding-block: 1.5rem; }
  .hotseat__obrigado p { margin: 0; }
  .hotseat__check {
    width: 3rem; height: 3rem; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center;
    background: var(--hs-verde-fundo); color: var(--hs-verde); font-size: 1.5rem; font-weight: 700;
  }
  .hotseat__obrigado .hotseat__obrigado-titulo { margin-top: 0.9rem; font-size: 1.6rem; font-weight: 700; line-height: 1.15; }
  .hotseat__obrigado .hotseat__obrigado-texto { margin-top: 0.75rem; font-size: 1rem; line-height: 1.5; text-wrap: pretty; }
  .hotseat__obrigado-texto[hidden] { display: none; }

  /* Tela larga: apresentação à esquerda, formulário à direita. */
  @media (min-width: 900px) {
    .hotseat { display: flex; align-items: center; padding-block: 1.5rem; }
    .hotseat__inner { width: 100%; max-width: 68rem; }
    .hotseat__logo, .hotseat__selo { align-self: flex-start; }
    .hotseat__grade { grid-template-columns: 1.1fr 1fr; gap: 4rem; align-items: center; }
    .hotseat__titulo { font-size: 2.6rem; }
    .hotseat__cartao { padding: 1.75rem; }
    .hotseat__campos { gap: 0.8rem; }
    .hotseat__campo input:not([type="radio"]) { padding-block: 0.65rem; }
    .hotseat__opcao { min-height: 44px; }
  }
</style>

<script>
  import { telefoneValido, aplicarMascaraTelefone } from '../scripts/lead-validacao';
  import { PERGUNTAS, emailValido } from '../data/hotseat-giulliano-puga.js';

  const ENDPOINT = '/api/hotseat-giulliano-puga';
  const TELEFONE_ERRO = 'Digite um WhatsApp válido com DDD.';
  const ERRO_ENVIO = 'Não conseguimos enviar agora. Confira a internet e toque em confirmar de novo.';

  type Pergunta = { name: string; tipo: string };

  const form = document.getElementById('hs-form') as HTMLFormElement | null;

  if (form) {
    const campos = document.getElementById('hs-campos') as HTMLElement;
    const obrigado = document.getElementById('hs-obrigado') as HTMLElement;
    const obrigadoAnalise = document.getElementById('hs-obrigado-analise') as HTMLElement;
    const enviarBtn = document.getElementById('hs-enviar') as HTMLButtonElement;
    const erroGeral = document.getElementById('hs-erro') as HTMLElement;
    const textoEnviar = enviarBtn.textContent ?? '';
    const perguntas = PERGUNTAS as Pergunta[];
    let enviando = false;

    const caixa = (name: string) => form.querySelector<HTMLElement>(`[data-campo="${name}"]`);

    function valor(p: Pergunta): string {
      if (p.tipo === 'uma') return form!.querySelector<HTMLInputElement>(`input[name="${p.name}"]:checked`)?.value ?? '';
      return form!.querySelector<HTMLInputElement>(`[name="${p.name}"]`)?.value.trim() ?? '';
    }

    function mensagemDeErro(p: Pergunta): string | null {
      const v = valor(p);
      if (p.tipo === 'uma') return v ? null : 'Escolha uma opção.';
      if (p.tipo === 'telefone') return telefoneValido(v) ? null : TELEFONE_ERRO;
      if (p.tipo === 'email') return emailValido(v) ? null : 'Digite um e-mail válido.';
      return v.length < 2 ? 'Preencha este campo.' : null;
    }

    function mostrarErro(name: string, msg: string | null) {
      const c = caixa(name);
      const err = c?.querySelector<HTMLElement>('.hotseat__campo-erro');
      if (!c || !err) return;
      err.textContent = msg ?? '';
      err.hidden = !msg;
      c.toggleAttribute('data-invalido', !!msg);
      c.querySelectorAll('input').forEach((el) => {
        if (msg) el.setAttribute('aria-invalid', 'true'); else el.removeAttribute('aria-invalid');
      });
    }

    const focar = (name: string) => caixa(name)?.querySelector<HTMLElement>('input')?.focus();

    const telefoneEl = form.querySelector<HTMLInputElement>('input[name="telefone"]');
    if (telefoneEl) aplicarMascaraTelefone(telefoneEl);

    // O erro some assim que o campo fica válido (erro novo só ao enviar).
    for (const p of perguntas) {
      caixa(p.name)?.addEventListener(p.tipo === 'uma' ? 'change' : 'input', () => {
        if (caixa(p.name)?.hasAttribute('data-invalido') && !mensagemDeErro(p)) mostrarErro(p.name, null);
      });
    }

    function origem(): string {
      const q = new URLSearchParams(window.location.search);
      return ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term']
        .filter((k) => q.get(k))
        .map((k) => `${k}=${q.get(k)}`)
        .join('; ');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (enviando) return;

      let primeiro: string | null = null;
      for (const p of perguntas) {
        const msg = mensagemDeErro(p);
        mostrarErro(p.name, msg);
        if (msg && !primeiro) primeiro = p.name;
      }
      if (primeiro) { focar(primeiro); return; }

      const respostas: Record<string, string> = {};
      for (const p of perguntas) respostas[p.name] = valor(p);

      enviando = true;
      enviarBtn.disabled = true;
      enviarBtn.textContent = 'Enviando…';
      erroGeral.hidden = true;
      try {
        const r = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ respostas, origem: origem() }),
        });
        const j = await r.json().catch(() => ({}));
        if (r.ok && j.ok) {
          obrigadoAnalise.hidden = respostas.analise !== 'Sim, quero';
          campos.hidden = true;
          obrigado.hidden = false;
          form.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }
        const p = j.campo ? perguntas.find((x) => x.name === j.campo) : null;
        if (p) {
          mostrarErro(p.name, p.tipo === 'telefone' ? TELEFONE_ERRO : 'Confira esta resposta.');
          focar(p.name);
          return;
        }
        throw new Error('envio');
      } catch {
        erroGeral.textContent = ERRO_ENVIO;
        erroGeral.hidden = false;
      } finally {
        enviando = false;
        enviarBtn.disabled = false;
        enviarBtn.textContent = textoEnviar;
      }
    });
  }
</script>
