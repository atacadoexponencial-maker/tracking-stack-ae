---
/**
 * Cartão da aplicação para o plano de ação ao vivo (issues 370–372,
 * spec-aplicacao-plano-ao-vivo.md).
 *
 * Folha de rosto + 4 etapas montadas a partir de src/data/aplicacao-plano-ao-vivo.js,
 * agradecimento e aviso de encerradas. Visual copiado do AplicacaoForm (cartão,
 * campos, nav) e da folha de rosto das iscas (/materiais/[slug]).
 *
 * Por que não reaproveita o AplicacaoForm: ele é amarrado ao /tracker (Lead,
 * FormStart, FormStep, fbq, redirect) e serve à mentoria e às iscas, que estão
 * no ar. Esta aplicação não vira lead: o envio vai só para
 * /api/aplicacao-plano-ao-vivo, que grava na planilha. Se as aplicações estão
 * abertas quem diz é o servidor (GET no mesmo endereço), nunca o relógio do
 * aparelho.
 */
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-horizontal-preto.png';
import { PERGUNTAS, TEXTOS, TOTAL_ETAPAS, MAX_TEXTO, MAX_CAIXA } from '../data/aplicacao-plano-ao-vivo.js';

const etapas = Array.from({ length: TOTAL_ETAPAS }, (_, i) => PERGUNTAS.filter((p) => p.etapa === i + 1));
---

<main class="section aplicacao">
  <div class="container aplicacao__inner">
    <Image src={logo} alt="Atacado Exponencial" height={72} class="aplicacao__logo" />

    <form class="aplicacao__form" id="apv-form" novalidate>
      <div class="aplicacao__etapa aplicacao__rosto" data-etapa="0">
        <span class="rosto__badge">{TEXTOS.selo}</span>
        <h1 class="rosto__titulo">{TEXTOS.titulo}</h1>
        <p class="rosto__sub">{TEXTOS.subtitulo}</p>
        <dl class="rosto__info">
          <div><dt>Quando</dt><dd>{TEXTOS.quando}</dd></div>
          <div><dt>Onde</dt><dd>{TEXTOS.onde}</dd></div>
        </dl>
        <div id="apv-rosto-aberta">
          <button type="button" class="btn-cta rosto__cta" id="apv-comecar" disabled>{TEXTOS.cta}</button>
          <p class="rosto__nota">{TEXTOS.nota}</p>
        </div>
        <div id="apv-rosto-encerrada" class="rosto__encerrada" hidden>
          <p class="rosto__encerrada-titulo">{TEXTOS.encerradas}</p>
          <p class="rosto__nota">{TEXTOS.encerradasLembrete}</p>
        </div>
      </div>

      <p class="aplicacao__card-titulo" id="apv-titulo" hidden>APLICAÇÃO <span class="aplicacao__card-etapa" id="apv-indicador">1 de {TOTAL_ETAPAS}</span></p>

      {etapas.map((perguntas, i) => (
        <div class="aplicacao__etapa" data-etapa={i + 1} hidden>
          {perguntas.map((p) => (
            p.tipo === 'uma' || p.tipo === 'varias' ? (
              <fieldset class="aplicacao__field apv-grupo" data-campo={p.name} data-tipo={p.tipo}>
                <legend>{p.rotulo} *</legend>
                {p.dica && <p class="apv-dica">{p.dica}</p>}
                <div class="apv-opcoes">
                  {p.opcoes.map((o) => (
                    <label class="apv-opcao">
                      <input type={p.tipo === 'uma' ? 'radio' : 'checkbox'} name={p.name} value={o} />
                      <span>{o}</span>
                    </label>
                  ))}
                </div>
                <small class="aplicacao__field-erro" hidden></small>
              </fieldset>
            ) : (
              <label class="aplicacao__field" data-campo={p.name} data-tipo={p.tipo}>
                <span>{p.rotulo} *</span>
                {p.tipo === 'caixa'
                  ? <textarea name={p.name} rows="4" maxlength={MAX_CAIXA} placeholder={p.placeholder}></textarea>
                  : <input name={p.name} type={p.tipo === 'telefone' ? 'tel' : 'text'} maxlength={MAX_TEXTO} placeholder={p.placeholder} autocomplete={p.autocomplete} />}
                <small class="aplicacao__field-erro" hidden></small>
              </label>
            )
          ))}
        </div>
      ))}

      <div class="aplicacao__etapa apv-obrigado" data-etapa="fim" hidden>
        <span class="apv-obrigado__check" aria-hidden="true">✓</span>
        <p class="apv-obrigado__titulo">{TEXTOS.obrigado.titulo}</p>
        <div class="apv-obrigado__blocos">
          <div class="apv-obrigado__bloco">
            <p class="apv-obrigado__rotulo">{TEXTOS.obrigado.escolhidaRotulo}</p>
            <p>{TEXTOS.obrigado.escolhida}</p>
          </div>
          <div class="apv-obrigado__bloco">
            <p class="apv-obrigado__rotulo">{TEXTOS.obrigado.naoEscolhidaRotulo}</p>
            <p>{TEXTOS.obrigado.naoEscolhida}</p>
          </div>
        </div>
        <span class="rosto__pilula apv-obrigado__data">{TEXTOS.obrigado.data}</span>
        <p class="apv-obrigado__link">{TEXTOS.obrigado.link}</p>
      </div>

      <p id="apv-erro" class="aplicacao__erro" role="alert" hidden></p>

      <div class="aplicacao__nav" id="apv-nav" hidden>
        <button type="button" id="apv-voltar" aria-label="Voltar" hidden>←</button>
        <button type="button" id="apv-avancar" aria-label="Avançar">→</button>
        <button type="submit" id="apv-enviar" class="btn-cta aplicacao__submit" hidden>ENVIAR APLICAÇÃO →</button>
      </div>
    </form>

    <p class="aplicacao__privacidade">Suas respostas ficam só com a equipe e servem para escolher as marcas do plano ao vivo.</p>
  </div>
</main>

<style>
  /* Página clara (pedido dela em 03/10): papel do site (#f5f0eb), cartão branco,
     texto grafite. As cores são locais: o resto do site segue escuro. */
  :global(body) { background: #f5f0eb; }
  .aplicacao {
    --apv-papel: #f5f0eb; --apv-cartao: #ffffff; --apv-texto: #1e1e1e; --apv-suave: #5c5650;
    --apv-linha: rgba(30, 30, 30, 0.14); --apv-verde: #1f7a45; --apv-verde-fundo: rgba(31, 122, 69, 0.08);
    --apv-erro: #b42318;
    background: var(--apv-papel); color: var(--apv-texto);
    min-height: 100dvh; padding-block: 1.25rem 2rem;
  }
  .aplicacao__inner { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1rem; max-width: 32rem; margin-inline: auto; }
  .aplicacao__logo { height: 1.75rem; width: auto; }

  .aplicacao__form {
    margin-top: 0.25rem; width: 100%; display: flex; flex-direction: column; gap: 1rem; text-align: left;
    background: var(--apv-cartao); border: 1px solid var(--apv-linha); border-radius: 1rem;
    box-shadow: 0 1px 2px rgba(30, 30, 30, 0.04), 0 8px 24px rgba(30, 30, 30, 0.06);
    overflow: hidden; padding: 0;
  }
  .aplicacao__card-titulo {
    margin: 0; padding: 1.25rem 1.25rem 0; font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.12em; color: var(--apv-suave);
    display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem;
  }
  .aplicacao__card-etapa { color: var(--apv-suave); }
  .aplicacao__etapa { display: flex; flex-direction: column; gap: 1.25rem; padding: 0 1.25rem; }
  .aplicacao__etapa[hidden],
  .aplicacao__card-titulo[hidden],
  .aplicacao__nav[hidden],
  #apv-rosto-aberta[hidden],
  .rosto__encerrada[hidden] { display: none; }

  /* Folha de rosto: mesma linguagem das iscas, sem a capa. */
  .aplicacao__rosto { padding: 1.75rem 1.25rem; align-items: center; text-align: center; gap: 0; }
  .rosto__badge {
    font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em;
    color: var(--apv-verde); background: var(--apv-verde-fundo);
    border: 1px solid rgba(31, 122, 69, 0.35); border-radius: 999px;
    padding: 0.4rem 0.95rem;
  }
  .rosto__titulo { margin: 1.25rem 0 0; font-size: 1.9rem; line-height: 1.1; font-weight: 700; color: var(--apv-texto); }
  .rosto__sub { margin: 0.75rem 0 0; font-size: 1rem; line-height: 1.5; color: var(--apv-texto); }
  .rosto__pilula {
    margin-top: 1.1rem; font-size: 0.85rem; font-weight: 700; color: var(--apv-texto);
    border: 1px solid var(--apv-linha); border-radius: 999px; padding: 0.45rem 1rem;
  }
  /* Quando e onde juntos, num quadro de duas colunas. */
  .rosto__info {
    margin: 1.5rem 0 0; width: 100%; display: grid; grid-template-columns: 1fr 1fr;
    border: 1px solid var(--apv-linha); border-radius: 0.75rem; text-align: left;
  }
  .rosto__info > div { padding: 0.85rem 1rem; }
  .rosto__info > div + div { border-left: 1px solid var(--apv-linha); }
  .rosto__info dt {
    font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--apv-suave);
  }
  .rosto__info dd { margin: 0.3rem 0 0; font-size: 1rem; font-weight: 700; line-height: 1.35; color: var(--apv-texto); }
  #apv-rosto-aberta, .rosto__encerrada { width: 100%; }
  .rosto__cta {
    margin-top: 1.5rem; width: 100%; justify-content: center;
    background: var(--apv-texto); color: #ffffff;
    padding: 1.1rem 1rem; min-height: 3.25rem;
  }
  .rosto__cta:disabled { opacity: 0.6; cursor: default; }
  .rosto__nota { margin: 0.75rem 0 0; font-size: 0.8rem; color: var(--apv-suave); text-align: center; }
  .rosto__encerrada { margin-top: 1.5rem; }
  .rosto__encerrada-titulo { margin: 0; font-size: 1.15rem; font-weight: 700; color: var(--apv-texto); text-align: center; }

  .aplicacao__field { display: flex; flex-direction: column; gap: 0.5rem; border: 0; margin: 0; padding: 0; min-width: 0; }
  .aplicacao__field > span { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--apv-texto); }
  /* Pergunta sozinha na tela: vira o título da tela. */
  .aplicacao__field > legend {
    font-size: 1.15rem; font-weight: 700; line-height: 1.35; color: var(--apv-texto);
    padding: 0; margin-bottom: 0.75rem;
  }
  .aplicacao__field[data-tipo="caixa"] > span { font-size: 1.15rem; line-height: 1.35; text-transform: none; letter-spacing: 0; }
  .apv-grupo .apv-dica { margin: -0.5rem 0 0.25rem; }
  .aplicacao__field input[type="text"],
  .aplicacao__field input[type="tel"],
  .aplicacao__field textarea {
    width: 100%; padding: 0.9rem 1.1rem; border: 1px solid var(--apv-linha); border-radius: 0.75rem;
    background: #ffffff; color: var(--apv-texto); font-family: inherit; font-size: 1rem;
  }
  .aplicacao__field textarea { resize: vertical; line-height: 1.5; }
  .aplicacao__field input::placeholder,
  .aplicacao__field textarea::placeholder { color: #8a837c; }
  .aplicacao__field input:focus,
  .aplicacao__field textarea:focus { outline: none; border-color: var(--apv-texto); }

  .apv-dica { margin: 0; font-size: 0.85rem; color: var(--apv-suave); }
  .apv-opcoes { display: flex; flex-direction: column; gap: 0.5rem; }
  .apv-opcao {
    display: flex; align-items: center; gap: 0.75rem; cursor: pointer;
    padding: 0.8rem 1rem; min-height: 48px;
    border: 1px solid var(--apv-linha); border-radius: 0.75rem;
    font-size: 1rem; color: var(--apv-texto); background: #ffffff;
    transition: border-color 0.15s, background-color 0.15s;
  }
  .apv-opcao:hover { border-color: rgba(30, 30, 30, 0.35); }
  .apv-opcao input { width: 1.1rem; height: 1.1rem; margin: 0; flex: none; accent-color: var(--apv-verde); }
  .apv-opcao:has(input:checked) { border-color: var(--apv-verde); background: var(--apv-verde-fundo); }
  .apv-opcao:has(input:focus-visible) { outline: 2px solid var(--apv-texto); outline-offset: 2px; }

  /* Agradecimento: um bloco por informação, para ler de relance. */
  .apv-obrigado { padding: 2rem 1.25rem; align-items: center; text-align: center; gap: 0; }
  .apv-obrigado p { margin: 0; }
  .apv-obrigado__check {
    width: 3rem; height: 3rem; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center;
    background: var(--apv-verde-fundo); color: var(--apv-verde); font-size: 1.5rem; font-weight: 700;
  }
  .apv-obrigado .apv-obrigado__titulo { margin-top: 0.9rem; font-size: 1.6rem; font-weight: 700; line-height: 1.15; color: var(--apv-texto); }
  .apv-obrigado__bloco {
    width: 100%; text-align: left;
    border: 1px solid var(--apv-linha); border-radius: 0.75rem; padding: 1rem 1.1rem;
  }
  .apv-obrigado__blocos { margin-top: 1.5rem; width: 100%; display: grid; gap: 0.75rem; }
  .apv-obrigado__bloco p { font-size: 1rem; line-height: 1.5; color: var(--apv-texto); }
  .apv-obrigado__bloco .apv-obrigado__rotulo {
    margin-bottom: 0.35rem; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--apv-suave);
  }
  .apv-obrigado__data { margin-top: 1.5rem; }
  .apv-obrigado .apv-obrigado__link { margin-top: 0.6rem; font-size: 0.9rem; line-height: 1.5; color: var(--apv-suave); }

  .aplicacao__erro { color: var(--apv-erro); font-size: 0.9rem; padding: 0 1.25rem; margin: 0; }
  .aplicacao__erro[hidden] { display: none; }
  .aplicacao__field-erro { color: var(--apv-erro); font-size: 0.85rem; }

  .aplicacao__nav {
    display: flex; justify-content: space-between; align-items: center;
    border-top: 1px solid var(--apv-linha); background: #faf8f5; padding: 0.75rem 1.25rem;
  }
  #apv-voltar[hidden],
  #apv-avancar[hidden],
  .aplicacao__submit[hidden] { display: none; }
  #apv-voltar,
  #apv-avancar {
    background: none; border: none; cursor: pointer; color: var(--apv-texto);
    font-size: 1.5rem; line-height: 1; min-width: 44px; min-height: 44px;
    display: inline-flex; align-items: center; justify-content: center; border-radius: 0.5rem;
  }
  #apv-avancar,
  .aplicacao__submit { margin-left: auto; }
  .aplicacao__submit { background: var(--apv-texto); color: #ffffff; }
  .aplicacao__submit:disabled { opacity: 0.7; cursor: default; }
  .aplicacao__privacidade { margin: 0; color: var(--apv-suave); font-size: 0.8rem; max-width: 36rem; }
  /* A nota de privacidade só faz sentido enquanto a pessoa preenche. */
  .aplicacao__inner:has(.aplicacao__rosto:not([hidden])) .aplicacao__privacidade,
  .aplicacao__inner:has(.apv-obrigado:not([hidden])) .aplicacao__privacidade { display: none; }

  /* Desktop: tudo cabe numa tela, sem rolagem. Cartão centrado na altura. */
  @media (min-width: 640px) {
    .aplicacao { display: flex; align-items: center; padding-block: 1.5rem; }
    .aplicacao__inner { width: 100%; }
    .aplicacao__rosto { padding: 2rem 2.5rem 1.75rem; }
    .rosto__titulo { font-size: 2.3rem; }
    .aplicacao__etapa:not(.aplicacao__rosto):not(.apv-obrigado) { padding-inline: 1.75rem; }
    .aplicacao__card-titulo { padding-inline: 1.75rem; }
    .aplicacao__nav { padding-inline: 1.75rem; }
    .apv-obrigado { padding: 1.75rem 2.25rem; }
    /* Compacto o bastante para caber numa janela de notebook (~600px úteis). */
    .aplicacao { padding-block: 1rem; }
    .aplicacao__inner { gap: 0.75rem; }
    .aplicacao__form { gap: 0.85rem; }
    .aplicacao__etapa { gap: 0.9rem; }
    .aplicacao__field input[type="text"],
    .aplicacao__field input[type="tel"] { padding-block: 0.7rem; }
    .apv-opcoes { gap: 0.4rem; }
    .apv-opcao { min-height: 44px; padding-block: 0.6rem; }
    .aplicacao__nav { padding-block: 0.5rem; }
    .rosto__titulo { margin-top: 1rem; }
    .rosto__info { margin-top: 1.25rem; }
    .rosto__cta { margin-top: 1.1rem; }
    .apv-obrigado__blocos { margin-top: 1.1rem; grid-template-columns: 1fr 1fr; }
    .aplicacao__inner:has(.aplicacao__rosto:not([hidden])),
    .aplicacao__inner:has(.apv-obrigado:not([hidden])) { max-width: 42rem; }
    .apv-obrigado__check { width: 2.5rem; height: 2.5rem; font-size: 1.25rem; }
    .apv-obrigado__data { margin-top: 1.1rem; }
  }
</style>

<script>
  import { telefoneValido, aplicarMascaraTelefone } from '../scripts/lead-validacao';
  import { PERGUNTAS, TOTAL_ETAPAS } from '../data/aplicacao-plano-ao-vivo.js';

  const ENDPOINT = '/api/aplicacao-plano-ao-vivo';
  // Mensagem própria: a compartilhada (TELEFONE_ERRO) tem travessão, fora do padrão de copy.
  const TELEFONE_ERRO = 'Digite um WhatsApp válido com DDD.';
  const ERRO_ENVIO = 'Não conseguimos enviar agora. Confira a internet e toque em enviar de novo.';

  type Pergunta = { name: string; etapa: number; tipo: string };

  const form = document.getElementById('apv-form') as HTMLFormElement | null;

  if (form) {
    const comecarBtn = document.getElementById('apv-comecar') as HTMLButtonElement;
    const rostoAberta = document.getElementById('apv-rosto-aberta') as HTMLElement;
    const rostoEncerrada = document.getElementById('apv-rosto-encerrada') as HTMLElement;
    const titulo = document.getElementById('apv-titulo') as HTMLElement;
    const indicador = document.getElementById('apv-indicador') as HTMLElement;
    const nav = document.getElementById('apv-nav') as HTMLElement;
    const voltarBtn = document.getElementById('apv-voltar') as HTMLButtonElement;
    const avancarBtn = document.getElementById('apv-avancar') as HTMLButtonElement;
    const enviarBtn = document.getElementById('apv-enviar') as HTMLButtonElement;
    const erroGeral = document.getElementById('apv-erro') as HTMLElement;
    const etapaEls = form.querySelectorAll<HTMLElement>('.aplicacao__etapa[data-etapa]');
    const textoEnviar = enviarBtn.textContent ?? '';

    let etapaAtual: number | 'fim' = 0;
    let enviando = false;

    const caixaDoCampo = (name: string) => form.querySelector<HTMLElement>(`[data-campo="${name}"]`);

    function valor(p: Pergunta): string | string[] {
      if (p.tipo === 'uma') return form!.querySelector<HTMLInputElement>(`input[name="${p.name}"]:checked`)?.value ?? '';
      if (p.tipo === 'varias') return Array.from(form!.querySelectorAll<HTMLInputElement>(`input[name="${p.name}"]:checked`)).map((i) => i.value);
      return form!.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${p.name}"]`)?.value ?? '';
    }

    function mensagemDeErro(p: Pergunta): string | null {
      const v = valor(p);
      if (p.tipo === 'uma') return v ? null : 'Escolha uma opção.';
      if (p.tipo === 'varias') return (v as string[]).length ? null : 'Marque pelo menos uma opção.';
      const t = (v as string).trim();
      if (p.tipo === 'telefone') return telefoneValido(t) ? null : TELEFONE_ERRO;
      if (t.length < 2) return p.tipo === 'caixa' ? 'Conte um pouquinho pra gente.' : 'Preencha este campo.';
      return null;
    }

    function mostrarErro(name: string, msg: string | null) {
      const caixa = caixaDoCampo(name);
      const err = caixa?.querySelector<HTMLElement>('.aplicacao__field-erro');
      if (!caixa || !err) return;
      err.textContent = msg ?? '';
      err.hidden = !msg;
      caixa.toggleAttribute('data-invalido', !!msg);
      caixa.querySelectorAll('input, textarea').forEach((el) => {
        if (msg) el.setAttribute('aria-invalid', 'true'); else el.removeAttribute('aria-invalid');
      });
    }

    function focar(name: string) {
      const el = caixaDoCampo(name)?.querySelector<HTMLElement>('input, textarea');
      el?.focus();
    }

    // Valida os campos da etapa n; devolve o name do primeiro inválido (ou null).
    function validarEtapa(n: number): string | null {
      let primeiro: string | null = null;
      for (const p of PERGUNTAS as Pergunta[]) {
        if (p.etapa !== n) continue;
        const msg = mensagemDeErro(p);
        mostrarErro(p.name, msg);
        if (msg && !primeiro) primeiro = p.name;
      }
      return primeiro;
    }

    function mostrarEtapa(n: number | 'fim') {
      etapaEls.forEach((el) => { el.hidden = el.dataset.etapa !== String(n); });
      const noForm = typeof n === 'number' && n >= 1;
      titulo.hidden = !noForm;
      nav.hidden = !noForm;
      voltarBtn.hidden = !(noForm && (n as number) > 1);
      avancarBtn.hidden = !(noForm && (n as number) < TOTAL_ETAPAS);
      enviarBtn.hidden = n !== TOTAL_ETAPAS;
      if (noForm) indicador.textContent = `${n} de ${TOTAL_ETAPAS}`;
      erroGeral.hidden = true;
      etapaAtual = n;
      if (n !== 0 && form!.getBoundingClientRect().top < 0) form!.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function mostrarEncerradas() {
      mostrarEtapa(0);
      rostoAberta.hidden = true;
      rostoEncerrada.hidden = false;
    }

    function avancar() {
      if (typeof etapaAtual !== 'number' || etapaAtual < 1 || etapaAtual >= TOTAL_ETAPAS) return;
      const invalido = validarEtapa(etapaAtual);
      if (invalido) { focar(invalido); return; }
      mostrarEtapa(etapaAtual + 1);
    }

    // Aberto ou encerrado: decide o servidor. Sem resposta, o botão libera
    // (o servidor recusa o envio de qualquer jeito se já tiver encerrado).
    fetch(ENDPOINT, { headers: { Accept: 'application/json' } })
      .then((r) => r.json())
      .then((j) => { if (j && j.aberta === false) mostrarEncerradas(); })
      .catch(() => {})
      .finally(() => { comecarBtn.disabled = false; });

    comecarBtn.addEventListener('click', () => mostrarEtapa(1));
    avancarBtn.addEventListener('click', avancar);
    voltarBtn.addEventListener('click', () => { if (typeof etapaAtual === 'number' && etapaAtual > 1) mostrarEtapa(etapaAtual - 1); });

    const telefoneEl = form.querySelector<HTMLInputElement>('input[name="telefone"]');
    if (telefoneEl) aplicarMascaraTelefone(telefoneEl);

    // Uma pergunta por tela: tocar na opção de uma pergunta de uma opção já
    // passa para a próxima. Na última tela quem envia é o botão.
    for (const p of PERGUNTAS as Pergunta[]) {
      if (p.tipo !== 'uma' || p.etapa >= TOTAL_ETAPAS) continue;
      caixaDoCampo(p.name)?.addEventListener('change', () => {
        const etapa = p.etapa;
        setTimeout(() => { if (etapaAtual === etapa) avancar(); }, 220);
      });
    }

    // O erro some assim que o campo fica válido (erro novo só ao avançar/enviar).
    for (const p of PERGUNTAS as Pergunta[]) {
      caixaDoCampo(p.name)?.addEventListener(p.tipo === 'uma' || p.tipo === 'varias' ? 'change' : 'input', () => {
        if (caixaDoCampo(p.name)?.hasAttribute('data-invalido') && !mensagemDeErro(p)) mostrarErro(p.name, null);
      });
    }

    function origem(): string {
      const q = new URLSearchParams(window.location.search);
      return ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term']
        .filter((k) => q.get(k))
        .map((k) => `${k}=${q.get(k)}`)
        .join('; ');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Enter num campo das etapas 1 a 3 chega aqui: vale como →.
      if (typeof etapaAtual !== 'number' || etapaAtual < 1) return;
      if (etapaAtual < TOTAL_ETAPAS) { avancar(); return; }
      if (enviando) return;

      for (let n = 1; n <= TOTAL_ETAPAS; n++) {
        const invalido = validarEtapa(n);
        if (invalido) { if (n !== etapaAtual) { mostrarEtapa(n); validarEtapa(n); } focar(invalido); return; }
      }

      const respostas: Record<string, string | string[]> = {};
      for (const p of PERGUNTAS as Pergunta[]) respostas[p.name] = valor(p);

      enviando = true;
      enviarBtn.disabled = true;
      enviarBtn.textContent = 'Enviando…';
      erroGeral.hidden = true;
      try {
        const r = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ respostas, origem: origem() }),
        });
        const j = await r.json().catch(() => ({}));
        if (r.ok && j.ok) { mostrarEtapa('fim'); return; }
        if (j.encerrada) { mostrarEncerradas(); return; }
        if (j.campo) {
          const p = (PERGUNTAS as Pergunta[]).find((x) => x.name === j.campo);
          if (p) {
            mostrarEtapa(p.etapa);
            mostrarErro(p.name, p.tipo === 'telefone' ? TELEFONE_ERRO : 'Confira esta resposta.');
            focar(p.name);
            return;
          }
        }
        throw new Error('envio');
      } catch {
        erroGeral.textContent = ERRO_ENVIO;
        erroGeral.hidden = false;
      } finally {
        enviando = false;
        enviarBtn.disabled = false;
        enviarBtn.textContent = textoEnviar;
      }
    });
  }
</script>
