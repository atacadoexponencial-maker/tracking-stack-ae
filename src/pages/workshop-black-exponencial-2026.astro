    border-radius: 1rem;
    object-fit: cover;
  }

  /* ---- 3. Dor ------------------------------------------------------------ */
  .wbe-dor__inner {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: clamp(1.05rem, 2.5vw, 1.35rem);
    color: hsl(var(--muted-foreground));
  }
  .wbe-dor__inner p:last-child {
    color: hsl(var(--foreground));
    font-weight: 700;
  }

  /* ---- 4. Problema real --------------------------------------------------- */
  .wbe-problema__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .wbe-problema__texto {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  .wbe-problema__texto .section-sub {
    text-align: left;
  }
  .wbe-linha {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
  }
  .wbe-linha::before {
    content: '';
    position: absolute;
    inset-block: 1.5rem;
    inset-inline-start: 0.5rem;
    width: 2px;
    background: rgba(30, 30, 30, 0.15);
  }
  .wbe-linha__marco {
    position: relative;
    padding: 1rem 1.25rem 1rem 2.25rem;
    border: 1px solid rgba(30, 30, 30, 0.12);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.5);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .wbe-linha__marco::before {
    content: '';
    position: absolute;
    inset-inline-start: -0.25rem;
    top: 1.5rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 9999px;
    background: #1e1e1e;
  }
  .wbe-linha__marco--apagado {
    opacity: 0.6;
  }
  .wbe-linha__marco--apagado::before {
    background: rgba(30, 30, 30, 0.35);
  }
  .wbe-linha__mes {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .wbe-linha__desc {
    font-size: 0.95rem;
    color: rgba(30, 30, 30, 0.7);
  }

  /* ---- 5. Antes e depois --------------------------------------------------- */
  .wbe-comparativo__cols {
    margin-top: 2.5rem;
    display: grid;
    gap: 1.5rem;
  }
  .wbe-comparativo__col {
    border: 1px solid hsl(var(--border));
    border-radius: 0.75rem;
    padding: 1.75rem 1.5rem;
  }
  .wbe-comparativo__col--apagado {
    opacity: 0.65;
  }
  .wbe-comparativo__col--destaque {
    background: rgba(255, 255, 255, 0.05);
    border-color: hsl(var(--foreground));
  }
  .wbe-comparativo__h {
    font-size: 1.1rem;
    margin-bottom: 1.25rem;
  }
  .wbe-comparativo__lista {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .wbe-comparativo__lista li {
    display: flex;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: hsl(var(--muted-foreground));
  }
  .wbe-comparativo__col--destaque .wbe-comparativo__lista li {
    color: hsl(var(--foreground));
  }
  .wbe-comparativo__marca {
    flex: none;
    font-weight: 700;
  }
  .wbe-comparativo__marca--sim {
    color: #4ade80;
  }
  .wbe-comparativo__marca--nao {
    color: #f87171;
  }
  .wbe-comparativo__fecho {
    margin-top: 2rem;
    text-align: center;
    font-size: clamp(1.15rem, 3vw, 1.5rem);
    font-weight: 700;
  }

  /* ---- 6, 10, 17. CTAs do corpo -------------------------------------------- */
  .wbe-cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    max-width: 40rem;
    margin-inline: auto;
  }
  .wbe-cta__titulo {
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
  }
  /* O .eyebrow global é 0.7rem (11px) — pequeno demais nesta página. Todos os
     rótulos daqui sobem juntos, para "Próximo passo" não ficar maior que os
     rótulos de seção.
     `:global()` é necessário porque dois rótulos vêm de componentes
     compartilhados (Faq.astro e FinalCta.astro) e o escopo do Astro não os
     alcança. O `.wbe` na frente prende a regra a esta página: as demais LPs
     que usam .eyebrow continuam intactas. Não mexer no global.css. */
  /* O `.btn-cta` do global.css nasce escuro (fundo --primary-foreground, que é
     #1e1e1e) porque foi desenhado para as seções BEGE das outras LPs. Esta
     página é majoritariamente escura, e ali o botão virava preto sobre preto:
     sobrava só o texto, sem forma de botão. Nas seções escuras daqui ele
     inverte para pílula clara.
     `:global()` porque o botão do bloco de fechamento vem do FinalCta.astro,
     componente compartilhado que não pode ser alterado. Não mexer no
     global.css: as outras LPs dependem do comportamento atual. */
  .wbe :global(.section:not(.section--light) .btn-cta) {
    background: hsl(var(--foreground));
    color: hsl(var(--background));
  }

  /* O botão da oferta carrega o preço num <span>. Como `.btn-cta` é
     inline-flex com gap, o span virava item de flex e quebrava em coluna
     separada ("GARANTIR MINHA / VAGA POR    R$ / 47"). Como inline-block o
     texto volta a fluir e quebrar normalmente. */
  .wbe-oferta__cta {
    display: inline-block;
    text-align: center;
    line-height: 1.4;
  }

  .wbe :global(.eyebrow) {
    font-size: clamp(0.875rem, 2vw, 1rem);
    letter-spacing: 0.12em;
  }

  /* ---- 7. Solução ----------------------------------------------------------- */
  .wbe-solucao__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    max-width: 42rem;
    margin-inline: auto;
  }
  .wbe-solucao__meta {
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  /* ---- 9. Entregáveis --------------------------------------------------------- */
  .wbe-card {
    border: 1px solid rgba(30, 30, 30, 0.12);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.5);
    overflow: hidden;
