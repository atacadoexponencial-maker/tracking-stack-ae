---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import felipe from '../assets/brand/felipe.webp';
import { LOTES, textoProximo } from '../data/lotes-workshop.js';

// ---------------------------------------------------------------------------
// Destino de compra — PONTO ÚNICO de configuração (issue 185, formalizado na 187)
//
// Checkout da Greenn (produto "Workshop Black Exponencial Atacado 2026").
// Substituiu o link de WhatsApp que servia de fallback enquanto o checkout não
// existia. Todos os botões de compra da página leem estas duas constantes:
// trocar de destino é editar AQUI e em mais lugar nenhum.
//
// Regra para CTAs futuros: todo botão de compra leva `href={CHECKOUT_URL}` E
// `data-checkout`. Sem o atributo o botão continua funcionando, mas some do
// rastreamento — falha silenciosa.
//
// Restrições de CHECKOUT_URL (a issue 188 concatena o parâmetro no fim):
//   - nunca vazia (href="" recarregaria a própria página);
//   - não pode terminar em `?` nem em `&` (geraria `?&trk=` / `&&trk=`);
//   - não pode conter fragmento `#` (o parâmetro cairia depois do hash e o
//     checkout não o receberia).
// ---------------------------------------------------------------------------
const CHECKOUT_URL = 'https://payfast.greenn.com.br/ecx6tpu';

// Nome do parâmetro que carrega o identificador de compra na URL do checkout.
// Muda conforme a plataforma (fonte: docs/page-types/sales-page.md):
//   Eduzz `trk` · Hotmart `xcod` · Kiwify `sck` · Greenn `sf_trk`
// Trocar de plataforma significa SUBSTITUIR este valor, nunca esvaziá-lo: em
// branco a 188 montaria `...&=uuid`, que a plataforma descarta, e a venda
// deixaria de ser atribuída sem nada quebrar visivelmente.
//
// ATENÇÃO — `sf_trk` é INFERIDO, não confirmado. A doc da Greenn não documenta
// os parâmetros que o checkout aceita; ela só mostra, no webhook de venda, um
// campo `sf_trk` descrito como "valor da meta sf_trk da venda (rastreamento)",
// e um `saleMetas` que recebe as UTMs da URL. Procurei o nome nos 21 chunks JS
// do checkout em 2026-08-12 e não achei — a captura acontece no servidor deles.
// COMO CONFIRMAR: na primeira venda real, procurar o valor em
// `greenn_webhook_event.raw_json` (campo `sf_trk` ou dentro de `saleMetas`).
// Se não estiver lá, o parâmetro é outro — e o raw_json mostra qual chegou.
const CHECKOUT_PARAM = 'sf_trk';

// ---------------------------------------------------------------------------
// Preço e lote: o HTML NASCE NO PRIMEIRO LOTE, de propósito.
//
// O site é estático (output: 'static'), então o frontmatter roda no build e
// congelaria o valor do dia do deploy — quem decide o lote vigente é o
// <script> no fim deste arquivo, no acesso do visitante. O que se renderiza
// aqui é o fallback: se o JavaScript não rodar, a página exibe o Lote 0
// legível em vez de espaço em branco, `undefined` ou placeholder.
//
// Os valores vêm de LOTES[0] (mesma tabela que o script lê) para o HTML
// inicial e a lógica não poderem divergir.
// ---------------------------------------------------------------------------
const VALOR_INICIAL = LOTES[0].valor;
const LOTE_INICIAL = LOTES[0].rotulo;
const PROXIMO_VALOR_INICIAL = textoProximo(LOTES[1]?.valor ?? null, LOTES[0].rotulo);

const maioriaFaz = [
  'Anuncia junto com o varejo, em novembro',
  'Dá desconto para quem já era cliente',
  'Termina o mês com o mesmo número de revendedores',
  'Dezembro e janeiro parados',
];

const duploPico = [
  'Pico 1 em outubro, quando o lojista ainda está decidindo de quem comprar',
  'Oferta desenhada para primeira compra, com mínimo reduzido e prazo',
  'Pico 2 em novembro, para a base repor o que já vendeu',
  'Entra revendedor novo, e ele volta a comprar em dezembro',
];

const entregaveisCards = [
  {
    titulo: 'Mapa mental do método completo',
    desc: 'O duplo pico inteiro em um documento: ranqueamento de datas, ofertas dos dois picos, fases do pico e checklists.',
  },
  {
    titulo: 'Calendário Black Atacado 2026',
    desc: 'Todas as datas do período já posicionadas, com a janela de antecipação calculada para cada uma.',
  },
  {
    titulo: 'Pack de mensagens de WhatsApp',
    desc: 'Os textos dos quatro momentos: convite para o grupo VIP, abertura do pico 1, urgência da Black Week e reposição do pico 2.',
  },
];

const ofertaItens = [
  '2 horas ao vivo com Felipe Santos',
  'Planner da Black Atacado',
  'Mapa mental do método',
  'Calendário Black Atacado 2026',
  'Pack de mensagens de WhatsApp',
  'Os 3 checklists de execução',
];

const bioFelipe = [
  '12 anos de Marketing Digital. Em 2019, assumi a direção de marketing de uma marca atacado no Bom Retiro e aprendi na prática que atacado não é varejo com outra embalagem.',
  'Em 2021, fundei a Sete Aceleradora, especializada em marcas atacado. Desde então, trabalhei com centenas de marcas que queriam estruturar o digital sem copiar o jeito do e-commerce varejo.',
  'O Atacado Exponencial nasceu dessa vivência: um método criado para o atacado, testado no atacado.',
];

const faqs = [
  {
    q: 'Preciso já vender no atacado?',
    a: 'Sim. O workshop é para marca que já tem base de revendedores e quer aumentar ela na Black.',
  },
  {
    q: 'E se eu não puder assistir ao vivo?',
    a: 'A gravação vitalícia está disponível como adicional no checkout, por R$ 27. O planner é preenchido durante a aula, então quem assiste ao vivo sai com ele pronto.',
  },
  {
    q: 'Serve para o meu nicho?',
    a: 'O método é de atacado, não de produto. Funciona para moda feminina, infantil, íntima, praia, calçados, acessórios, casa e o que mais você vender por atacado.',
  },
  {
    q: 'Já estou atrasada?',
    a: 'Não. A antecipação recomendada é de 30 a 45 dias antes da data do varejo. Em 09 de setembro você está no prazo.',
  },
  {
    q: 'Quanto tempo dura?',
    a: '2 horas, das 19h às 21h.',
  },
  {
    q: 'E se eu não gostar?',
    a: 'Você tem até 16 de setembro, 7 dias depois do workshop, para pedir reembolso integral.',
  },
];

// Prints de depoimentos — reaproveita as imagens de src/assets/proof/
// (mesmo padrão de src/pages/lives-semanais-v2.astro e video-workshop-instagram.astro).
const proofModules = import.meta.glob('../assets/proof/*.{jpg,png}', { eager: true });
const proofImages = Object.entries(proofModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, m]) => (m as { default: ImageMetadata }).default);
---

<BaseLayout
  title="Workshop Black Exponencial — 09/09 às 19h | Monte a Black Friday da sua marca atacado"
  description="Workshop ao vivo de Black Friday para marcas de atacado. Dia 09/09, às 19h, em 2 horas você monta metas, oferta e calendário semana a semana da sua campanha."
  showHeader={false}
>
  <!-- Gancho de estado das vendas: nasce em "abertas". Quem muda para
       "encerradas" (depois de 09/09 às 18h, fuso de Brasília) é a issue 186.
       `data-checkout-param` publica CHECKOUT_PARAM para o cliente: um <script>
       do Astro é bundlado à parte e não enxerga o frontmatter, então a 188 lê
       `document.querySelector('.wbe').dataset.checkoutParam` em vez de repetir
       o literal. A URL base não precisa ser publicada — cada botão já a carrega
       no próprio `href`. -->
  <div class="wbe" data-vendas="abertas" data-checkout-param={CHECKOUT_PARAM}>
    <!-- 1. Barra fixa ------------------------------------------------------ -->
    <div class="wbe-barra">
      <div class="container wbe-barra__inner">
        <Image src={logo} alt="Atacado Exponencial" height={72} class="wbe-barra__logo" />
        <p class="wbe-barra__texto">
          <span class="wbe-barra__evento">BLACK EXPONENCIAL</span>
          <span class="wbe-barra__sep" aria-hidden="true">·</span>
          <span class="wbe-barra__data"
            >09/09 · 19h<span class="wbe-barra__aovivo"> · ao vivo</span></span
          >
        </p>
        <a class="wbe-barra__cta" href={CHECKOUT_URL} data-checkout>Garantir vaga</a>
      </div>
    </div>

    <!-- Aviso de vendas encerradas — presente no DOM, oculto. A issue 186
         remove o `hidden` e vira o gancho do wrapper para "encerradas". -->
    <div class="wbe-encerrado" hidden>
      <div class="container">
        <p class="wbe-encerrado__texto">
          As vendas do Workshop Black Exponencial estão encerradas.
        </p>
      </div>
    </div>

    <!-- 2. Hero ------------------------------------------------------------ -->
    <header class="wbe-hero">
      <div class="container wbe-hero__body">
        <div class="wbe-hero__texto">
          <span class="wbe-hero__selo">Exclusivo para marcas atacado</span>
          <h1 class="wbe-hero__titulo">
            Monte a Black Friday da sua marca atacado em <em class="wbe-hero__destaque">2 horas</em>,
            com metas, oferta e calendário semana a semana definidos.
          </h1>
          <p class="wbe-hero__sub">
            Ao vivo com Felipe Santos em 09/09, às 19h. A estratégia do duplo pico de vendas:
            outubro traz revendedor novo, novembro faz a base repor. Sua Black Friday montada na
            própria aula, do início ao fim.
          </p>
          <a class="btn-cta wbe-hero__cta" href={CHECKOUT_URL} data-checkout>Garantir minha vaga</a>
          <p class="wbe-hero__preco wbe-preco-bloco">
            <strong data-preco="hero">{VALOR_INICIAL}</strong>
            <span class="wbe-hero__lote" data-lote="hero">{LOTE_INICIAL}</span>
          </p>
        </div>
        <div class="wbe-hero__visual">
          <Image src={felipe} alt="Felipe Santos" class="wbe-hero__img" loading="eager" />
        </div>
      </div>
    </header>

    <main>
      <!-- 3. Dor ----------------------------------------------------------- -->
      <section class="section wbe-dor">
        <div class="container wbe-dor__inner">
          <p class="wbe-dor__abre">Lembra da sua última Black?</p>
          <p>Você deu desconto. Vendeu. O faturamento do mês até que ficou bom.</p>
          <p>
            Só que era tudo cliente da casa. Os mesmos lojistas de sempre, levando o mesmo de
            sempre por menos.
          </p>
          <p>Nenhum nome novo entrou na sua base.</p>
          <p>
            E quando o movimento caiu, você tinha exatamente os mesmos clientes de antes, agora
            acostumados com o seu preço promocional.
          </p>
        </div>
      </section>

      <!-- 4. Problema real -------------------------------------------------- -->
      <section class="section section--light wbe-problema">
        <div class="container wbe-problema__grid">
          <div class="wbe-problema__texto">
            <span class="eyebrow">O problema real</span>
            <h2 class="section-title">
              O lojista não decide na Black. Ele decide quando monta a grade dele, e isso acontece
              em outubro.
            </h2>
            <p class="section-sub">
              Quando a sua Black sai em novembro, junto com a do varejo, você está oferecendo
              mercadoria para alguém que já comprou de outro fornecedor 30 dias antes. A verba dele
              acabou. A grade dele está fechada.
            </p>
            <p class="section-sub">
              Enquanto isso você briga por espaço no mês mais caro do ano para anunciar, contra o
              Magalu, contra a Shopee, contra todo mundo.
            </p>
            <p class="section-sub">
              A Black Friday do varejo é em novembro. A do atacado precisa acontecer antes, porque
              quem vende para lojista vende antes do lojista vender.
            </p>
            <p class="section-sub">
              Essa é a diferença que separa a marca que termina a Black maior da marca que termina
              a Black no mesmo tamanho.
            </p>
          </div>
          <div class="wbe-linha">
            <div class="wbe-linha__marco wbe-linha__marco--destaque">
              <span class="wbe-linha__mes">OUT</span>
              <span class="wbe-linha__desc">decisão do lojista</span>
            </div>
            <div class="wbe-linha__marco wbe-linha__marco--apagado">
              <span class="wbe-linha__mes">NOV</span>
              <span class="wbe-linha__desc">você anuncia (tarde)</span>
            </div>
          </div>
        </div>
      </section>

      <!-- 5. Antes e depois ------------------------------------------------- -->
      <section class="section wbe-comparativo">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Antes e depois</span>
            <h2 class="section-title">Duas formas de encarar a Black</h2>
          </div>
          <div class="wbe-comparativo__cols">
            <div class="wbe-comparativo__col wbe-comparativo__col--apagado">
              <h3 class="wbe-comparativo__h">Como a maioria faz</h3>
              <ul class="wbe-comparativo__lista">
                {maioriaFaz.map((item) => (
                  <li>
                    <span class="wbe-comparativo__marca wbe-comparativo__marca--nao" aria-hidden="true">✕</span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
            <div class="wbe-comparativo__col wbe-comparativo__col--destaque">
              <h3 class="wbe-comparativo__h">Como funciona o duplo pico</h3>
              <ul class="wbe-comparativo__lista">
                {duploPico.map((item) => (
                  <li>
                    <span class="wbe-comparativo__marca wbe-comparativo__marca--sim" aria-hidden="true">✓</span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <p class="wbe-comparativo__fecho">No dia 09/09 você monta os dois.</p>
        </div>
      </section>

      <!-- 6. CTA ------------------------------------------------------------ -->
      <section class="section wbe-cta">
        <div class="container wbe-cta__inner">
          <span class="eyebrow">Próximo passo</span>
          <h2 class="wbe-cta__titulo">Sua Black de 2026 começa no dia 09/09.</h2>
          <a class="btn-cta" href={CHECKOUT_URL} data-checkout>Garantir minha vaga</a>
        </div>
      </section>

      <!-- 7. Solução -------------------------------------------------------- -->
      <section class="section section--light wbe-solucao">
        <div class="container wbe-solucao__inner">
          <span class="eyebrow">A solução</span>
          <h2 class="section-title">Workshop Black Exponencial</h2>
          <p class="wbe-solucao__meta">
            09 de setembro · 19h · 2 horas ao vivo com Felipe Santos
          </p>
          <p class="section-sub">
            Não é aula para assistir e anotar. Você entra com o planner em branco e sai com ele
            preenchido: suas metas, sua oferta dos dois picos, seu calendário semana a semana e
            seus canais definidos.
          </p>
          <p class="section-sub">
            Quem sai do dia 09 tem a Black pronta com quase um mês de folga para executar.
          </p>
        </div>
      </section>

      <!-- 9. Entregáveis ---------------------------------------------------- -->
      <section class="section section--light wbe-entregaveis">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">O que você leva</span>
            <h2 class="section-title">Você sai da sala com material pronto para executar</h2>
          </div>

          <!-- Card largo — sem imagem enquanto o mockup do planner não existir
               (importar asset inexistente quebra o build do astro:assets). -->
          <article class="wbe-card wbe-card--largo wbe-card--sem-imagem">
            <div class="wbe-card__corpo">
              <span class="wbe-card__tag">Principal</span>
              <h3 class="wbe-card__titulo">Planner da Black Atacado</h3>
              <p class="wbe-card__desc">
                Você preenche durante a aula e imprime no fim. Suas metas, sua oferta, seu
                calendário e seus canais, tudo em um lugar só.
              </p>
            </div>
          </article>

          <div class="wbe-entregaveis__grid">
            {entregaveisCards.map((card) => (
              <article class="wbe-card">
                <div class="wbe-card__corpo">
                  <h3 class="wbe-card__titulo">{card.titulo}</h3>
                  <p class="wbe-card__desc">{card.desc}</p>
                </div>
              </article>
            ))}
          </div>

          <article class="wbe-card wbe-card--largo wbe-card--sem-imagem">
            <div class="wbe-card__corpo">
              <h3 class="wbe-card__titulo">Os 3 checklists de execução</h3>
              <p class="wbe-card__desc">
                Planejamento estratégico, planejamento criativo e execução.
              </p>
            </div>
          </article>
        </div>
      </section>

      <!-- 10. CTA ----------------------------------------------------------- -->
      <section class="section wbe-cta">
        <div class="container wbe-cta__inner">
          <span class="eyebrow">Próximo passo</span>
          <h2 class="wbe-cta__titulo">Duas horas agora valem os dois meses inteiros.</h2>
          <a class="btn-cta" href={CHECKOUT_URL} data-checkout>Garantir minha vaga</a>
        </div>
      </section>

      <!-- 11. Autoridade ----------------------------------------------------- -->
      <section class="section wbe-autoridade">
        <div class="container wbe-autoridade__grid">
          <div class="wbe-autoridade__foto">
            <Image src={felipe} alt="Felipe Santos" class="wbe-autoridade__img" loading="lazy" />
          </div>
          <div class="wbe-autoridade__texto">
            <span class="eyebrow">Quem conduz</span>
            <h2 class="section-title">Felipe Santos</h2>
            <p class="wbe-autoridade__papel">Fundador do Atacado Exponencial</p>
            {bioFelipe.map((frase) => <p class="wbe-autoridade__bio">{frase}</p>)}
          </div>
        </div>
      </section>

      <!-- 12. Prova social --------------------------------------------------- -->
      {proofImages.length > 0 && (
        <section class="section section--light wbe-prova">
          <div class="container">
            <div class="section-head">
              <span class="eyebrow">Depoimentos</span>
              <h2 class="section-title">O que diz quem já aplicou o método</h2>
            </div>
            <div class="wbe-prova__grid">
              {proofImages.map((img, i) => (
                <Image src={img} alt={`Depoimento ${i + 1}`} class="wbe-prova__img" loading="lazy" />
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- 13. Ancoragem ------------------------------------------------------ -->
      <section class="section wbe-ancoragem">
        <div class="container wbe-ancoragem__inner">
          <h2 class="section-title">Quanto custa uma Black mal planejada?</h2>
          <p class="section-sub wbe-ancoragem__intro">
            Some o desconto que você deu no ano passado para clientes que iam comprar de qualquer
            jeito. Depois some o que você gastou anunciando em novembro, no mês mais caro do ano.
          </p>
          <dl class="wbe-ancoragem__conta">
            <div class="wbe-ancoragem__linha">
              <dt>Desconto dado para quem ia comprar de qualquer jeito</dt>
              <dd class="wbe-ancoragem__valor" aria-label="valor em branco">R$ _______</dd>
            </div>
            <div class="wbe-ancoragem__linha">
              <dt>Anúncio no mês mais caro do ano</dt>
              <dd class="wbe-ancoragem__valor" aria-label="valor em branco">R$ _______</dd>
            </div>
          </dl>
          <p class="wbe-ancoragem__fecho">
            Esse é o valor que uma tarde de planejamento economiza.<br />
            O workshop custa menos que um pedido mínimo da sua marca.
          </p>
        </div>
      </section>

      <!-- 14. Caixa de oferta ------------------------------------------------ -->
      <section class="section wbe-oferta">
        <div class="container">
          <div class="wbe-oferta__caixa">
            <h2 class="wbe-oferta__titulo">
              WORKSHOP BLACK EXPONENCIAL — 09/09 · 19h · 2 horas ao vivo
            </h2>
            <ul class="wbe-oferta__itens">
              {ofertaItens.map((item) => (
                <li>
                  <span class="wbe-oferta__check" aria-hidden="true">✓</span>
                  {item}
                </li>
              ))}
            </ul>
            <div class="wbe-oferta__precos wbe-preco-bloco">
              <span class="wbe-oferta__cheio">R$ 297</span>
              <strong class="wbe-oferta__valor" data-preco="oferta">{VALOR_INICIAL}</strong>
              <span class="wbe-oferta__lote" data-lote="oferta">{LOTE_INICIAL}</span>
            </div>
            <a class="btn-cta wbe-oferta__cta" href={CHECKOUT_URL} data-checkout>
              Garantir minha vaga por <span data-preco="botao-oferta">{VALOR_INICIAL}</span>
            </a>
            <p class="wbe-oferta__proximo wbe-preco-bloco" data-preco="proximo">
              {PROXIMO_VALOR_INICIAL}
            </p>
          </div>
        </div>
      </section>

      <!-- 15. Garantia -------------------------------------------------------- -->
      <section class="section section--light wbe-garantia">
        <div class="container">
          <div class="wbe-garantia__bloco">
            <div class="wbe-garantia__topo">
              <div class="wbe-garantia__selo" aria-hidden="true">
                <span class="wbe-garantia__selo-num">7</span>
                <span class="wbe-garantia__selo-txt">dias</span>
              </div>
              <h2 class="wbe-garantia__titulo">
                Você tem 7 dias depois do workshop para pedir seu dinheiro de volta.
              </h2>
            </div>
            <p class="wbe-garantia__corpo">
              Participe do dia 09, preencha o planner, leve os materiais. Se até o dia 16 de
              setembro você achar que aquilo não serve para a sua marca, manda uma mensagem e
              devolvemos o valor integral. Sem formulário, sem pergunta.
            </p>
            <p class="wbe-garantia__fecho">
              O risco de montar a sua Black com a gente é zero. O de entrar em outubro sem campanha
              nenhuma, não.
            </p>
          </div>
        </div>
      </section>

      <!-- 16. Urgência --------------------------------------------------------- -->
      <section class="section wbe-urgencia">
        <div class="container wbe-urgencia__inner">
          <span class="eyebrow">Por que existe prazo</span>
          <h2 class="section-title">O pico 1 acontece na primeira quinzena de outubro</h2>
          <p class="section-sub">
            Para rodar em outubro, você precisa ter a campanha montada em setembro. Dia 09 dá
            tempo. Dia 30 de setembro já é aperto.
          </p>
          <p class="section-sub">
            Cada lote que passa, o valor sobe. O conteúdo e os materiais são os mesmos.
          </p>
          <p class="section-sub">Setembro é o mês de montar. Outubro é o mês de colher.</p>
          <a class="btn-cta" href={CHECKOUT_URL} data-checkout>Quero garantir minha vaga</a>
        </div>
      </section>

      <!-- 17. FAQ -------------------------------------------------------------- -->
      <Faq
        sub="As dúvidas que mais chegam sobre o Workshop Black Exponencial."
        faqs={faqs}
      />
    </main>

    <!-- 18. Fechamento + CTA — reaproveita FinalCta.astro, arquivo COMPARTILHADO
         (index, se-v1, trafego-atacado, vsl) e por isso NÃO alterado aqui. O
         botão dele já nasce com o `href` certo, mas sem `data-checkout`: o
         <script> do fim desta página marca `.wbe-fechamento .btn-cta` em tempo
         de execução. A partir daí o seletor ÚNICO de botão de compra da página
         é `[data-checkout]` — 7 de 7.
         Dependência a vigiar: se o FinalCta perder a classe `.btn-cta`, o
         seletor deixa de casar e este botão sai do rastreamento sem erro
         visível. Conferir a contagem 7 ao mexer no componente. -->
    <div class="wbe-fechamento">
      <FinalCta
        title="Duas opções para outubro:"
        sub="Chegar com a campanha montada em setembro ou improvisar quando o lojista já tiver comprado."
        ctaLabel="Quero minha vaga"
        ctaHref={CHECKOUT_URL}
        notes={['09/09 · 19h · ao vivo', '2 horas de duração', 'Garantia de 7 dias']}
      />
    </div>
  </div>
  <!-- 20. Rodapé padrão do site: showFooter fica no default (true). -->
</BaseLayout>

<style>
  /* Altura da barra fixa — usada para compensar o topo do hero e a rolagem
     por âncora. Muda junto no breakpoint do celular. */
  .wbe {
    --wbe-barra-h: 3.25rem;
  }
  :global(html) {
    scroll-padding-top: 3.25rem;
  }

  /* ---- 1. Barra fixa ---------------------------------------------------- */
  .wbe-barra {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 50;
    background: hsl(var(--background));
    border-bottom: 1px solid hsl(var(--border));
    min-height: var(--wbe-barra-h);
    display: flex;
    align-items: center;
  }
  .wbe-barra__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: 0.4rem;
  }
  /* O logo mora aqui, e não numa faixa própria no topo do hero: a faixa
     empurrava a headline para baixo da dobra e o logo centralizado no meio da
     página cortava a leitura. O `brightness(0) invert(1)` deixa a marca em
     branco sobre o fundo escuro da barra. */
  .wbe-barra__logo {
    flex: none;
    height: 1.5rem;
    width: auto;
    filter: brightness(0) invert(1);
  }
  .wbe-barra__texto {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1.3;
  }
  .wbe-barra__sep {
    color: hsl(var(--muted-foreground));
    margin-inline: 0.25rem;
  }
  .wbe-barra__cta {
    flex: none;
    background: hsl(var(--foreground));
    color: hsl(var(--background));
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.55rem 1.1rem;
    border-radius: 9999px;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }
  .wbe-barra__cta:hover {
    opacity: 0.85;
  }

  /* ---- Aviso de vendas encerradas (issue 186 liga o gancho) -------------- */
  .wbe-encerrado {
    padding-block: 1rem;
    background: hsl(var(--secondary));
    text-align: center;
  }
  .wbe-encerrado__texto {
    font-weight: 700;
    font-size: 0.95rem;
  }
  /* Quando o gancho virar "encerradas": some o preço e todo botão de compra,
     e o aviso aparece mesmo com o atributo `hidden`.

     Os DOIS seletores de botão são intencionais. `[data-checkout]` cobre os 6
     botões do HTML; `.wbe-fechamento .btn-cta` é a rede de proteção do 7º, que
     só ganha `data-checkout` via JavaScript. Com JS desligado a marcação nunca
     acontece e, sem esta segunda regra, o botão do fechamento continuaria à
     mostra numa página de vendas encerradas. Não remover. */
  .wbe[data-vendas='encerradas'] .wbe-encerrado[hidden] {
    display: block;
  }
  .wbe[data-vendas='encerradas'] .wbe-preco-bloco,
  .wbe[data-vendas='encerradas'] :global([data-checkout]),
  .wbe[data-vendas='encerradas'] :global(.wbe-fechamento .btn-cta) {
    display: none;
  }

  /* ---- 2. Hero ----------------------------------------------------------- */
  .wbe-hero {
    background: hsl(var(--light-bg));
    color: hsl(var(--light-fg));
    /* Compensa a barra fixa para ela não comer o topo do hero */
    padding-top: var(--wbe-barra-h);
  }
  .wbe-hero__body {
    display: grid;
    gap: 2.5rem;
    padding-block: 2rem 4rem;
    align-items: center;
  }
  .wbe-hero__texto {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .wbe-hero__selo {
    display: inline-block;
    border: 1px solid rgba(30, 30, 30, 0.15);
    border-radius: 9999px;
    padding: 0.5rem 1.25rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(30, 30, 30, 0.7);
  }
  .wbe-hero__titulo {
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
