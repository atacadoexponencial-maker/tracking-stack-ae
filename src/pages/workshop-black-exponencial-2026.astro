    max-width: 24rem;
  }
  .wbe-oferta__itens li {
    display: flex;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: hsl(var(--muted-foreground));
  }
  .wbe-oferta__check {
    flex: none;
    color: #4ade80;
    font-weight: 700;
  }
  .wbe-oferta__precos {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }
  .wbe-oferta__cheio {
    font-size: 0.95rem;
    color: hsl(var(--muted-foreground));
    text-decoration: line-through;
  }
  .wbe-oferta__valor {
    font-size: clamp(2.5rem, 8vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .wbe-oferta__lote {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: hsl(var(--muted-foreground));
  }
  .wbe-oferta__cta {
    text-align: center;
  }
  .wbe-oferta__proximo {
    font-size: 0.8rem;
    color: hsl(var(--muted-foreground));
  }

  /* ---- 15. Garantia -------------------------------------------------------------------- */
  /* Bloco escuro dentro da seção bege. É o momento em que a página quebra a
     objeção do dinheiro, e antes ele passava batido: círculo e texto soltos
     sobre o bege, sem moldura nem hierarquia. O contraste sai da paleta que a
     página já usa — nada de dourado de "selo de garantia", que destoaria de
     todo o resto. */
  .wbe-garantia__bloco {
    background: hsl(var(--background));
    color: hsl(var(--foreground));
    border-radius: 1rem;
    padding: clamp(1.75rem, 5vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .wbe-garantia__topo {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .wbe-garantia__selo {
    flex: none;
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 9999px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  .wbe-garantia__selo-num {
    font-size: 2rem;
    font-weight: 700;
  }
  .wbe-garantia__selo-txt {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.7);
  }
  /* `flex: 1 1 16rem` deixa o título dividir a linha com o selo no desktop e
     cair para baixo dele no celular, sem media query. */
  .wbe-garantia__titulo {
    flex: 1 1 16rem;
    font-size: clamp(1.25rem, 3.2vw, 1.75rem);
    line-height: 1.25;
  }
  .wbe-garantia__corpo {
    color: hsl(var(--muted-foreground));
    font-size: 0.98rem;
  }
  /* O fecho é a frase que fica. Separado por um fio e em branco cheio, ele
     encerra a objeção em vez de se diluir como um segundo parágrafo. */
  .wbe-garantia__fecho {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: 1.25rem;
    font-size: clamp(1rem, 2.5vw, 1.15rem);
    font-weight: 700;
  }

  /* ---- 16. Urgência --------------------------------------------------------------------- */
  .wbe-urgencia__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    max-width: 42rem;
    margin-inline: auto;
  }
  .wbe-urgencia__inner .btn-cta {
    margin-top: 0.75rem;
  }

  /* ---- Responsivo ------------------------------------------------------------------------ */
  /* Celular estreito: a barra fixa omite o nome do evento e o "ao vivo",
     preservando sempre o logo, a data e o botão. Sem isso a data quebra em
     duas linhas e a barra volta a engordar. */
  @media (max-width: 480px) {
    .wbe-barra__evento,
    .wbe-barra__sep,
    .wbe-barra__aovivo {
      display: none;
    }
    .wbe-barra__texto {
      font-size: 0.65rem;
      white-space: nowrap;
    }
    .wbe-barra__logo {
      height: 1.25rem;
    }
    .wbe-barra__inner {
      gap: 0.5rem;
    }
    .wbe-barra__cta {
      font-size: 0.6rem;
      padding: 0.5rem 0.9rem;
    }
  }

  @media (min-width: 768px) {
    .wbe-prova__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .wbe-entregaveis__grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .wbe-comparativo__cols {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 880px) {
    /* A coluna de texto ganha largura: a headline tem 110 caracteres e, em
       1.15fr, quebrava em 6 linhas e sozinha estourava a primeira dobra de um
       notebook (medido em 1366x657). Mais largura = menos linhas. */
    .wbe-hero__body {
      grid-template-columns: 1.45fr 1fr;
      padding-block: 1.75rem 3.5rem;
      gap: 3rem;
    }
    .wbe-problema__grid {
      grid-template-columns: 1.2fr 1fr;
      gap: 3rem;
    }
    .wbe-autoridade__grid {
      grid-template-columns: 20rem 1fr;
      gap: 3rem;
    }
    /* Cards largos viram duas colunas no desktop; a ordem do DOM continua
       imagem → texto (reposicionamento é por grid, nunca por `order`). */
    .wbe-card--largo:not(.wbe-card--sem-imagem) {
      grid-template-columns: 20rem 1fr;
      align-items: center;
    }
  }

  /* Notebook de tela baixa (1366x657 é o caso típico): headline, subheadline e
     CTA precisam caber na primeira dobra. Comprime a faixa do logo, o respiro
     do topo e os intervalos do hero. Monitores altos não entram aqui e mantêm
     o espaçamento original. */
  @media (min-width: 880px) and (max-height: 820px) {
    .wbe-hero__body {
      padding-block: 1rem 2.5rem;
    }
    .wbe-hero__texto {
      gap: 0.8rem;
    }
    .wbe-hero__selo {
      padding: 0.35rem 1rem;
    }
    .wbe-hero__titulo {
      line-height: 1.05;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wbe-barra__cta {
      transition: none;
    }
  }
</style>

<script>
  // Lote vigente e estado das vendas (issue 186).
  //
  // Roda no NAVEGADOR porque a página é estática: decidir isso no frontmatter
  // congelaria o valor no dia do deploy. Aqui só se sobrescreve o que mudou em
  // relação ao HTML inicial (que já nasce no Lote 0).
  //
  // Sem `setInterval`, sem contador regressivo, sem `fetch`: o cálculo acontece
  // uma vez, no carregamento. A spec proíbe relógio na página, e quem abre a
  // aba atravessando a virada só precisa de um refresh.
  //
  // RISCO ACEITO: a hora vem do relógio do visitante (`Date.now()`), então um
  // aparelho com data errada vê o lote errado. É consciente — não há servidor no
  // caminho da renderização e o checkout é a fonte da verdade do preço. Detalhes
  // no cabeçalho de src/data/lotes-workshop.js. Não "consertar" com fetch de
  // hora do servidor sem discutir antes.
  import { loteVigente, textoProximo } from '../data/lotes-workshop.js';

  // Todo o bloco em try/catch: se algo explodir, a página fica no estado
  // inicial do HTML (Lote 0, vendas abertas) — nunca com preço vazio ou
  // `undefined`. Não há mensagem de erro: a página continua vendável.
  try {
    const estado = loteVigente(Date.now());
    const wrapper = document.querySelector('.wbe') as HTMLElement | null;

    if (estado.estado === 'encerrado') {
      // O CSS de `data-vendas="encerradas"` some com o preço e com todos os
      // botões de compra, e reexibe o aviso mesmo com o atributo `hidden`.
      if (wrapper) wrapper.dataset.vendas = 'encerradas';
      const aviso = document.querySelector('.wbe-encerrado') as HTMLElement | null;
      if (aviso) aviso.hidden = false;
    } else {
      // Cada escrita é condicional / via querySelectorAll: gancho ausente não
      // quebra o resto da página.
      const valor = estado.valor as string;
      const rotulo = estado.rotulo as string;

      document
        .querySelectorAll('[data-preco="hero"], [data-preco="oferta"], [data-preco="botao-oferta"]')
        .forEach((el) => {
          el.textContent = valor;
        });
      document.querySelectorAll('[data-lote="hero"], [data-lote="oferta"]').forEach((el) => {
        el.textContent = rotulo;
      });

      const proximo = document.querySelector('[data-preco="proximo"]') as HTMLElement | null;
      const texto = textoProximo(estado.proximoValor, rotulo);
      if (proximo) {
        if (texto) {
          proximo.textContent = texto;
          proximo.hidden = false;
        } else {
          // Último lote: a página nunca anuncia um valor que não existe.
          proximo.hidden = true;
        }
      }
    }
  } catch (e) {
    /* estado inicial do HTML já é legível e vendável */
  }

  // -------------------------------------------------------------------------
  // Normalização dos botões de compra (issue 187).
  //
  // Os 6 botões escritos nesta página já nascem com `data-checkout` no HTML. O
  // 7º vem de FinalCta.astro, componente COMPARTILHADO que não é alterado por
  // esta página — então ele é marcado aqui, em tempo de execução, pelo seletor
  // `.wbe-fechamento .btn-cta`. Depois disto o seletor único de "botão de
  // compra desta página" é `[data-checkout]`, 7 de 7.
  //
  // Bloco próprio (fora do try/catch do lote) para que uma falha lá não impeça
  // a marcação, e vice-versa. Se o bloco de fechamento sumir ou for renomeado,
  // a lista vem vazia e isto vira no-op — sem exceção, sem quebra. Nada de
  // estado de venda aqui: quem esconde botão é o CSS.
  //
  // CONTRATO COM A ISSUE 188: o handler de clique dela usa DELEGAÇÃO —
  //   document.addEventListener('click', (e) => {
  //     const a = (e.target as Element).closest('[data-checkout]');
  //     ...
  //   })
  // Delegação avalia o seletor no momento do clique, o que elimina qualquer
  // dependência de ordem entre este script e o dela (ambos são módulos do
  // Astro, `defer`). E, ao montar o destino, a 188 escolhe o separador com
  // `const sep = url.includes('?') ? '&' : '?'`, que funciona com ou sem query
  // string na CHECKOUT_URL. Nada de `trk`, `/checkout-session` ou
  // `InitiateCheckout` nesta issue.
  // -------------------------------------------------------------------------
  document.querySelectorAll('.wbe-fechamento .btn-cta').forEach((el) => {
    (el as HTMLElement).dataset.checkout = '';
  });

  // -------------------------------------------------------------------------
  // Rastreamento de página de vendas (issue 188).
  //
  // Três responsabilidades, nesta ordem:
  //   1. obter/criar o identificador de compra (`trk`) da VISITA;
  //   2. gravá-lo em `checkout_sessions` (POST /checkout-session) já no
  //      carregamento, para o webhook da plataforma ter o que consultar horas
  //      depois;
  //   3. no clique em qualquer botão de compra, disparar `InitiateCheckout`
  //      (beacon + pixel com o MESMO event_id, para o Meta deduplicar) e
  //      navegar para o destino com o `trk` anexado.
  //
  // REGRA QUE MANDA EM TUDO: a compra vem antes do rastreamento. Nenhuma falha
  // aqui — sessionStorage bloqueado, rede fora, pixel derrubado por bloqueador —
  // pode impedir a ida ao checkout. Por isso todo o bloco está em try/catch,
  // cada parte frágil tem o seu próprio, e os `href` dos botões continuam
  // intactos: sem JS a página segue navegável, só perde o `trk`.
  //
  // Nada de constantes duplicadas: o nome do parâmetro vem do DOM
  // (`data-checkout-param`, publicado pela 187) e a URL base vem do `href` do
  // botão clicado. Trocar de plataforma continua sendo editar só o frontmatter.
  // -------------------------------------------------------------------------
  try {
    // Fallback em memória: vale enquanto a aba viver. Só é usado se o
    // sessionStorage estiver indisponível (aba anônima com cota zero, extensão
    // bloqueando, SecurityError em iframe). Consequência aceita: um refresh
    // gera outro `trk` e uma segunda linha em `checkout_sessions` — a
    // atribuição segue correta, porque o `trk` que vai ao checkout é sempre o
    // da aba viva.
    let trkMemoria: string | null = null;

    // `crypto.randomUUID` só existe em contexto seguro. A página é HTTPS, então
    // o fallback é praticamente inalcançável — mas existe para nenhum caminho
    // jogar TypeError e derrubar o clique.
    const novoId = () => {
      try {
        return crypto.randomUUID();
      } catch (e) {
        return Date.now() + '-' + Math.random().toString(16).slice(2);
      }
    };

    // Leitura E escrita protegidas: no Safari privado quem lança é o `setItem`.
    const obterTrk = () => {
      try {
        const salvo = sessionStorage.getItem('krob_trk');
        if (salvo) return salvo;
      } catch (e) {
        /* storage indisponível — segue para o fallback em memória */
      }
      if (trkMemoria) return trkMemoria;
      const gerado = novoId();
      trkMemoria = gerado;
      try {
        sessionStorage.setItem('krob_trk', gerado);
      } catch (e) {
        /* fica só em memória */
      }
      return gerado;
    };

    const trk = obterTrk();

    // POST no carregamento (não no clique): o `fetch` tem tempo de completar, e
    // se a pessoa voltar do checkout a linha já está lá. `INSERT OR REPLACE`
    // pela chave `trk` no servidor torna o repost de um refresh idempotente.
    const params = new URLSearchParams(location.search);
    fetch('/checkout-session', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        trk,
        utm_source: params.get('utm_source') || '',
        utm_medium: params.get('utm_medium') || '',
        utm_campaign: params.get('utm_campaign') || '',
        utm_content: params.get('utm_content') || '',
        utm_term: params.get('utm_term') || '',
        event_source_url: location.href,
      }),
      // `location.href` (e não `pathname`) para a variante A/B, servida de
      // `/ab/<slug>/b/`, gravar a URL pública que o visitante realmente viu.
    }).catch(() => {
      /* Falha muda de propósito: nada na tela, nenhum botão bloqueado, nenhum
         retry. Vender importa mais que rastrear. */
    });

    // Um único InitiateCheckout por carregamento de página. Sem esta flag, um
    // duplo toque viraria dois eventos com event_id diferentes — dupla contagem
    // real, já que a dedup do Meta é por event_id. Voltar pelo botão "voltar"
    // recarrega o script e o próximo clique volta a valer (mesma visita, mesmo
    // `trk` do sessionStorage).
    let jaDisparou = false;

    // Delegação em `document`: o seletor é avaliado no momento do clique, o que
    // elimina qualquer dependência de ordem com o bloco acima que marca o 8º
    // botão (o do FinalCta) com `data-checkout`.
    document.addEventListener('click', (evento) => {
      const alvo = evento.target as Element | null;
      const botao = alvo && alvo.closest ? alvo.closest('[data-checkout]') : null;
      if (!botao) return;

      // Vendas encerradas: o CSS já esconde todos os botões, mas um alcançado
      // por teclado ou leitor de tela viraria checkout fantasma. Sai cedo e
      // deixa o navegador seguir o href, sem disparar evento nenhum.
      const wrapperVendas = document.querySelector('.wbe') as HTMLElement | null;
      if (wrapperVendas && wrapperVendas.dataset.vendas === 'encerradas') return;

      const base = botao.getAttribute('href');
      if (!base) return;

      const nomeParam =
        (wrapperVendas && wrapperVendas.dataset.checkoutParam) || 'trk';
      // Separador calculado, nunca fixo: a CHECKOUT_URL da Greenn não tem query
      // string, mas já teve (o fallback de WhatsApp tinha) e pode voltar a ter.
      const separador = base.includes('?') ? '&' : '?';
      const destino = base + separador + nomeParam + '=' + encodeURIComponent(trk);

      evento.preventDefault();

      if (!jaDisparou) {
        jaDisparou = true;
        const eventId = novoId();

        // Beacon (não `fetch`): sobrevive à saída da página. O servidor manda
        // ao Meta CAPI com este event_id e traduz para `begin_checkout` no GA4.
        try {
          navigator.sendBeacon(
            '/tracker',
            new Blob(
              [
                JSON.stringify({
                  event_name: 'InitiateCheckout',
                  event_id: eventId,
                  event_time: Math.floor(Date.now() / 1000),
                  event_source_url: location.href,
                  user_data: {},
                }),
              ],
              { type: 'application/json' },
            ),
          );
        } catch (e) {
          /* sem sendBeacon o evento se perde — a venda, não */
        }

        // Cópia do navegador com o MESMO event_id: é isso que faz o Meta contar
        // uma vez só. `fbq` pode não existir se um bloqueador derrubar o proxy
        // /scripts, daí o try/catch.
        try {
          (window as any).fbq('track', 'InitiateCheckout', {}, { eventID: eventId });
        } catch (e) {
          /* pixel ausente ou bloqueado */
        }
      }

      // 80ms para a fila do beacon esvaziar antes de a aba sair (Chrome Android
      // descarta beacons pendentes na navegação). Cliques seguintes não
      // redisparam evento, mas continuam levando o `trk` ao destino.
      setTimeout(() => {
        window.location.href = destino;
      }, 80);
    });
  } catch (e) {
    // Qualquer erro inesperado: os botões continuam sendo <a href> de verdade,
    // então a navegação segue funcionando — só se perde o `trk` e o evento.
    console.error('[wbe] rastreamento de checkout indisponível', e);
  }
</script>
