    display: grid;
  }
  .wbe-card__corpo {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .wbe-card--largo {
    margin-top: 2.5rem;
  }
  .wbe-card__tag {
    align-self: flex-start;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border: 1px solid rgba(30, 30, 30, 0.2);
    border-radius: 9999px;
    padding: 0.25rem 0.7rem;
  }
  .wbe-card__titulo {
    font-size: 1.15rem;
  }
  .wbe-card__desc {
    font-size: 0.92rem;
    color: rgba(30, 30, 30, 0.7);
  }
  .wbe-entregaveis__grid {
    margin-top: 1.5rem;
    display: grid;
    gap: 1.5rem;
  }

  /* ---- 11. Autoridade ----------------------------------------------------------- */
  .wbe-autoridade__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .wbe-autoridade__img {
    width: 100%;
    height: auto;
    border-radius: 1rem;
    object-fit: cover;
  }
  .wbe-autoridade__texto {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }
  .wbe-autoridade__papel {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: hsl(var(--muted-foreground));
  }
  .wbe-autoridade__bio {
    color: hsl(var(--muted-foreground));
    font-size: 0.98rem;
  }

  /* ---- 12. Prova social ---------------------------------------------------------- */
  /* Uma coluna no celular: os depoimentos são prints de conversa, com texto
     dentro da imagem. Em duas colunas a fonte fica pequena demais para ler. */
  .wbe-prova__grid {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .wbe-prova__img {
    width: 100%;
    height: auto;
    border-radius: 1rem;
    object-fit: cover;
  }

  /* ---- 13. Ancoragem -------------------------------------------------------------- */
  .wbe-ancoragem__inner {
    max-width: 36rem;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: stretch;
  }
  .wbe-ancoragem__conta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .wbe-ancoragem__linha {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    text-align: left;
    border-bottom: 1px solid hsl(var(--border));
    padding-bottom: 0.75rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.95rem;
  }
  .wbe-ancoragem__valor {
    flex: none;
    text-align: right;
    font-weight: 700;
    color: hsl(var(--foreground));
    letter-spacing: 0.05em;
  }
  .wbe-ancoragem__fecho {
    font-size: clamp(1.05rem, 2.5vw, 1.35rem);
    font-weight: 700;
  }

  /* ---- 14. Caixa de oferta ---------------------------------------------------------- */
  .wbe-oferta__caixa {
    max-width: 34rem;
    margin-inline: auto;
    border: 2px solid hsl(var(--foreground));
    border-radius: 1rem;
    padding: 2rem 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .wbe-oferta__titulo {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1.4;
  }
  .wbe-oferta__itens {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
