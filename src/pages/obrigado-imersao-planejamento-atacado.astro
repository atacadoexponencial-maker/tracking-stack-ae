---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';

// Página de obrigado da COMPRA da Imersão Planejamento Atacado 2027 (12/12).
// Cadastrada como página de obrigado / redirecionamento do produto no painel da
// Zouti (quem cadastra é a usuária; o site não tem acesso ao painel).
//
// Molde: /obrigado-black-exponencial (página de obrigado de compra da Greenn).
// Visual: o mundo da LP /imersao-planejamento-atacado (carvão, bege, títulos em
// caixa alta), para quem acabou de comprar reconhecer onde está.
//
// Sem rastreamento próprio: início de checkout e compra quem manda ao Meta é o
// pixel e a CAPI da Zouti, e a compra chega ao CRM, à planilha e à lista de
// e-mail pelo webhook (functions/api/webhooks/zouti). Esta página não envia
// Purchase, não tem formulário e não lê nada do endereço.
//
// CABE NA TELA SEM ROLAR, como a do Black: um botão só, espaçamentos que
// encolhem com a altura da tela. Medir antes de acrescentar qualquer bloco.
//
// O botão aponta para /grupo-imersao (functions/grupo-imersao.js), e não direto
// para o chat.whatsapp.com: o mesmo endereço serve para e-mail e template de
// WhatsApp, e trocar o grupo é só mudar a env var.
const GRUPO_URL = '/grupo-imersao';
---

<BaseLayout
  title="Compra confirmada | Imersão Planejamento Atacado 2027"
  description="Seu ingresso para a Imersão Planejamento Atacado 2027 está garantido. Entre no grupo para receber o link do Google Meet."
  showHeader={false}
  showFooter={false}
  noindex
>
  <main class="oi">
    <div class="oi__inner">
      <!-- `eager`: o logo é o primeiro elemento visível da página. -->
      <Image src={logo} alt="Atacado Exponencial" height={72} loading="eager" class="oi__logo" />

      <h1 class="oi__titulo">Seu ingresso está garantido.</h1>

      <p class="oi__sub">
        Compra confirmada. Agora entre no grupo da Imersão: é por lá que chegam o link do
        Google Meet e os avisos do dia.
      </p>

      <!-- O ingresso: data e horário são o que a pessoa volta para reencontrar,
           então ficam no bloco mais achável depois do botão. -->
      <div class="oi__ingresso">
        <p class="oi__ingresso-nome">Imersão Planejamento Atacado 2027</p>
        <div class="oi__picote" aria-hidden="true"></div>
        <p class="oi__ingresso-data">Sábado, 12/12</p>
        <p class="oi__ingresso-hora">9h30 às 17h30</p>
        <p class="oi__ingresso-nota">Ao vivo no Google Meet · com Felipe Santos</p>
      </div>

      <a class="oi__cta" href={GRUPO_URL}>
        <svg class="oi__icone" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4.5 19.5l1.2-3.6A8 8 0 1 1 8.6 18.6Z" />
          <path d="M9 10.5h6M9 13.5h4" />
        </svg>
        <span>Entrar no grupo da Imersão</span>
      </a>

      <p class="oi__rodape">
        Participou e achou que não valeu? Você pede o reembolso até 2 dias depois do evento.
      </p>
    </div>
  </main>
</BaseLayout>

<style>
  /* Paleta da LP da Imersão (que por sua vez usa só as cores do site). */
  .oi {
    --carvao: #1e1e1e;
    --fundo: #171717;
    --bege: #f5f0eb;
    --bege-tinta: rgba(30, 30, 30, 0.68);
    --branco-2: rgba(255, 255, 255, 0.7);
    --branco-3: rgba(255, 255, 255, 0.55);
    /* `100dvh` e não `100vh`: no celular a barra do navegador aparece e some. */
    min-height: 100dvh;
    display: flex;
    align-items: center;
    background:
      radial-gradient(120% 70% at 50% 0%, #262423 0%, rgba(23, 23, 23, 0) 60%),
      var(--fundo);
    color: #fff;
    padding: clamp(1.25rem, 4vh, 3rem) 1rem;
  }
  .oi ::selection {
    background: var(--bege);
    color: var(--carvao);
  }
  .oi__inner {
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .oi__logo {
    height: clamp(1.4rem, 3.4vh, 1.75rem);
    width: auto;
    margin-bottom: clamp(1.25rem, 4.5vh, 2.75rem);
  }

  .oi__titulo {
    margin: 0;
    font-size: clamp(2rem, 8.5vw, 3.25rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .oi__sub {
    margin: clamp(0.75rem, 2vh, 1.1rem) 0 0;
    max-width: 26rem;
    font-size: clamp(0.95rem, 2.6vw, 1.05rem);
    line-height: 1.45;
    color: var(--branco-2);
    text-wrap: pretty;
  }

  /* ---- Ingresso: cartão bege com picote, eco do ícone de ingresso da LP ---- */
  .oi__ingresso {
    --furo: 0.75rem;
    /* Altura dos furos = topo + nome (1.7rem) + margem do picote: os furos
       caem exatamente na linha tracejada em qualquer altura de tela. */
    --pad-topo: clamp(0.9rem, 2.4vh, 1.35rem);
    --picote-m: clamp(0.55rem, 1.6vh, 0.85rem);
    --picote-y: calc(var(--pad-topo) + 1.7rem + var(--picote-m) + 1px);
    position: relative;
    width: 100%;
    margin-top: clamp(1.25rem, 4vh, 2.25rem);
    padding: var(--pad-topo) 1.25rem clamp(1.1rem, 3vh, 1.6rem);
    background: var(--bege);
    color: var(--carvao);
    border-radius: 6px;
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.7);
    /* Os dois furos do picote, recortados do cartão na altura da linha. */
    -webkit-mask:
      radial-gradient(circle var(--furo) at 0 var(--picote-y), transparent 98%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle var(--furo) at 100% var(--picote-y), transparent 98%, #000) right / 51% 100% no-repeat;
    mask:
      radial-gradient(circle var(--furo) at 0 var(--picote-y), transparent 98%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle var(--furo) at 100% var(--picote-y), transparent 98%, #000) right / 51% 100% no-repeat;
    animation: oi-entra 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }
  .oi__ingresso-nome {
    margin: 0;
    height: 1.7rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--bege-tinta);
  }
  .oi__picote {
    margin: var(--picote-m) calc(var(--furo) * -0.2) clamp(0.7rem, 2vh, 1rem);
    border-top: 2px dashed rgba(30, 30, 30, 0.22);
  }
  .oi__ingresso-data {
    margin: 0;
    font-size: clamp(1.9rem, 7.5vw, 2.6rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .oi__ingresso-hora {
    margin: 0.35rem 0 0;
    font-size: clamp(1.05rem, 3.6vw, 1.25rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .oi__ingresso-nota {
    margin: 0.45rem 0 0;
    font-size: 0.85rem;
    color: var(--bege-tinta);
  }

  /* ---- Botão: retângulo chapado como o da LP, no verde do WhatsApp ---------
     A cor já diz para onde o botão leva. Texto ESCURO: branco sobre #25D366 dá
     2:1 de contraste; o carvão dá 8,5:1. */
  .oi__cta {
    width: 100%;
    margin-top: clamp(1rem, 3vh, 1.75rem);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    background: #25d366;
    color: var(--carvao);
    font-weight: 700;
    font-size: 0.92rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    padding: 1.15rem 1.5rem;
    border-radius: 4px;
    box-shadow: 0 12px 30px -14px rgba(37, 211, 102, 0.55);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }
  .oi__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 36px -14px rgba(37, 211, 102, 0.7);
  }
  .oi__cta:focus-visible {
    outline: 2px solid var(--bege);
    outline-offset: 3px;
  }
  .oi__icone {
    width: 1.3em;
    height: 1.3em;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .oi__rodape {
    margin: clamp(0.9rem, 2.6vh, 1.4rem) 0 0;
    max-width: 24rem;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--branco-3);
  }

  /* O único movimento da página: o ingresso sobe e assenta. */
  @keyframes oi-entra {
    from {
      opacity: 0;
      transform: translateY(14px) rotate(-1.5deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .oi__ingresso {
      animation: none;
    }
    .oi__cta {
      transition: none;
    }
  }

  /* Tela muito baixa: o rodapé é o primeiro a sair. */
  @media (max-height: 600px) {
    .oi__rodape {
      display: none;
    }
  }
</style>
