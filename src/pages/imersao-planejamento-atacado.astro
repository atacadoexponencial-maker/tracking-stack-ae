---
// Página de ingresso da Imersão Planejamento Atacado 2027 (evento de 12/12).
//
// Copy: "Imersão Planejamento Atacado 2027 - copy da página (12-12).txt",
// enviada pela usuária em 12/11 (substitui a de 09/11 e muda a ordem das seções).
// Layout: referência https://workshop.orbyka.com/sprintlp (foto grande no topo,
// faixa de cards de mentorados, bloco de preço em cor chapada, faixa de
// depoimentos em cor). Cores e fonte: as do site (carvão, bege, cinza quente,
// Satoshi). Onde a referência usa vermelho chapado, aqui entra o bege.
// Decisão da usuária em 09/11, depois da primeira versão (parecida demais com a
// página da Black, que converteu mal).
//
// Base técnica: /workshop-black-exponencial-2026 (lotes por data, botão de
// compra com `sf_trk` da Greenn).
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoTestimonials from '../components/sections/VideoTestimonials.astro';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import fotoQuadro from '../assets/imersao/felipe-quadro.jpg';
import fotoNotebook from '../assets/imersao/felipe-notebook.jpg';
import fotoMesa from '../assets/imersao/felipe-mesa.jpg';
import { LOTES_IMERSAO, VALOR_CHEIO_IMERSAO } from '../data/lotes-imersao.js';
import { textoProximo } from '../data/lotes-workshop.js';
import { DEPOIMENTOS_HOME } from '../data/depoimentos.js';
import igDiamandi from '../assets/marcas-imersao/ig-diamandi.jpg';
import igLazarf from '../assets/marcas-imersao/ig-lazarf.jpg';
import igUp from '../assets/marcas-imersao/ig-upsemijoia.jpg';
import igValentt from '../assets/marcas-imersao/ig-valentt.jpg';
import igWillinha from '../assets/marcas-imersao/ig-willinha.jpg';

// ---------------------------------------------------------------------------
// Destino de compra: PONTO ÚNICO de configuração.
//
// O checkout ainda não existe (09/11). Enquanto CHECKOUT_URL for null, todo
// botão de compra leva a `#ingresso` (a seção de preço) e o rastreamento ignora
// o clique. Quando o link da Greenn existir, é trocar null pela URL AQUI e mais
// nada. Restrições da URL (o `sf_trk` é concatenado no fim): sem `#`, sem
// terminar em `?` ou `&`.
// ---------------------------------------------------------------------------
const CHECKOUT_URL: string | null = null;
const HREF_COMPRA = CHECKOUT_URL ?? '#ingresso';

// Parâmetro de rastreio da Greenn, confirmado com venda real na Black
// (2026-08-12). Ver o comentário completo em workshop-black-exponencial-2026.
const CHECKOUT_PARAM = 'sf_trk';

// O HTML nasce no lote 01: o site é estático e quem decide o lote vigente é o
// <script> no fim, no acesso do visitante. Sem JS, a página mostra o lote 01.
const LOTE_INICIAL = LOTES_IMERSAO[0];
const PROXIMO_INICIAL = LOTES_IMERSAO[1].valor;
const TEXTO_PROXIMO_INICIAL = textoProximo(PROXIMO_INICIAL, LOTE_INICIAL.rotulo);
const LOTE_BOTAO_INICIAL = LOTE_INICIAL.rotulo.toLowerCase();

// Prints do perfil no Instagram (capturados em 09/11). Nicho lido na bio.
const marcas = [
  { img: igDiamandi, arroba: 'diamandijoias', nicho: 'prata 925 e semijoias' },
  { img: igLazarf, arroba: 'lazarf_', nicho: 'moda fitness' },
  { img: igUp, arroba: 'up_semijoia', nicho: 'semijoias' },
  { img: igValentt, arroba: 'valenttmodaa', nicho: 'vestuário' },
  { img: igWillinha, arroba: 'barracadowillinha', nicho: 'moda feminina' },
];

const plano = [
  { titulo: 'Raio-X 2026', desc: 'De onde veio o seu faturamento este ano: quanto de revendedoras novas e quanto de recompra.' },
  { titulo: 'A conta de dobrar', desc: 'A meta de 2027 dividida mês a mês, em revendedoras novas e recompra.' },
  { titulo: 'Entrada Previsível', desc: 'Quantas revendedoras novas cada mês precisa e o que destrava a entrada delas na sua marca.' },
  { titulo: 'Recompra Escalável', desc: 'Quanto a sua base precisa recomprar e o que fazer para ela comprar com mais frequência.' },
  { titulo: 'Calendário 2027', desc: 'As campanhas e as datas fortes da sua marca distribuídas pelos quatro trimestres.' },
];

const sinais = [
  'a meta do ano for só um número de faturamento, sem a conta de onde ele vem;',
  'você não souber quantas revendedoras ativas tem hoje e quantas pararam de comprar;',
  'a recompra continuar sem dono e sem controle;',
  'o Instagram e o anúncio continuarem trazendo gente que não é revendedora;',
  'janeiro começar sem campanha pronta no primeiro dia.',
];

const agenda = [
  { hora: '9h30', o: 'Início' },
  { hora: '12h', o: 'Almoço' },
  { hora: '13h30', o: 'Retorno' },
  { hora: '17h30', o: 'Encerramento' },
];

const ofertaItens = [
  'Um dia ao vivo com o Felipe Santos, das 9h30 às 17h30;',
  'O plano para dobrar o faturamento do seu atacado em 2027, mês a mês;',
  'Os números de referência das marcas que o Felipe mentora.',
];

const faqs = [
  {
    q: 'Serve para a minha marca?',
    a: 'Serve para marcas que já vendem no atacado para revendedoras. Se você ainda não vende no atacado, a Imersão não é para você agora.',
  },
  {
    q: 'Quanto tempo dura?',
    a: 'Um sábado, 12/12, das 9h30 às 17h30, com pausa para o almoço.',
  },
  {
    q: 'O que preciso levar?',
    a: 'Os números do seu atacado em 2026. Na quinta antes da Imersão, o Felipe faz um encontro ao vivo e explica cada um.',
  },
  {
    q: 'Por que fazer em dezembro?',
    a: 'Janeiro é um bom mês de vendas, mas precisa de campanha pronta no primeiro dia. Quem planeja em janeiro começa o ano atrasado.',
  },
  {
    q: 'Vai ficar gravado?',
    a: 'O ingresso dá acesso ao vivo. A Imersão em formato de aulas, com hot seat com o Felipe e a planilha do Planejamento 2027, é vendida à parte, por R$ 297, na hora da compra.',
  },
  {
    q: 'Vai ter oferta?',
    a: 'Vai. À tarde o Felipe apresenta a Mentoria para quem quiser ajuda na execução do plano. O restante do dia é conteúdo.',
  },
];

const HEADLINE = 'Monte em um sábado o plano para dobrar o faturamento do seu atacado em 2027.';
---

<BaseLayout
  title="Imersão Planejamento Atacado 2027 | 12/12, ao vivo com Felipe Santos"
  description="Um sábado, 12/12, das 9h30 às 17h30, online e ao vivo. Você traz os números de 2026 e sai com a meta de cada mês de 2027: quantas revendedoras novas trazer e quanto a sua base precisa recomprar."
  showHeader={false}
>
  <div class="ipa" data-vendas="abertas" data-checkout-param={CHECKOUT_PARAM}>
    <div class="ipa-encerrado" hidden>
      <p>As vendas da Imersão Planejamento Atacado 2027 estão encerradas.</p>
    </div>

    <!-- 1. Topo ------------------------------------------------------------- -->
    <header class="ipa-hero">
      <Image
        src={fotoQuadro}
        alt="Felipe Santos escrevendo Entrada Previsível no quadro"
        class="ipa-hero__foto"
        widths={[640, 960, 1400, 1800]}
        sizes="(min-width: 880px) 60vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="ipa-hero__veu" aria-hidden="true"></div>

      <div class="ipa-topo">
        <Image src={logo} alt="Atacado Exponencial" height={72} class="ipa-topo__logo" />
        <p class="ipa-topo__data">
          <svg class="ipa-icone" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="1.5" /><path d="M3.5 9.5h17M8 3v4M16 3v4" /></svg>
          <span>12/12<span class="ipa-topo__dia">, sábado</span></span><span class="ipa-topo__extra"><span class="ipa-topo__sep" aria-hidden="true">·</span>Ao vivo no Google Meet</span><span class="ipa-topo__sep" aria-hidden="true">·</span><span>9h30 às 17h30</span>
        </p>
      </div>

      <div class="ipa-hero__corpo">
        <h1 class="ipa-hero__titulo">{HEADLINE}</h1>
        <p class="ipa-hero__sub">
          Com o Felipe Santos, mentor de marcas que somam mais de R$&nbsp;20&nbsp;milhões por ano.
          Você monta para o seu atacado o mesmo plano que essas marcas usam para crescer.
        </p>
        <!-- O botão do topo sempre leva à seção de preço, nunca direto ao checkout. -->
        <a class="ipa-botao" href="#ingresso" data-ir-preco>
          <span>Garantir meu ingresso | <span data-lote-botao>{LOTE_BOTAO_INICIAL}</span></span>
          <svg class="ipa-icone" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8.5V6a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v2.5a3.5 3.5 0 0 0 0 7V18a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-2.5a3.5 3.5 0 0 0 0-7Z" /><path d="M14 5v14" stroke-dasharray="2 2.2" /></svg>
        </a>
        <div class="ipa-progresso ipa-preco-bloco">
          <div
            class="ipa-progresso__trilho"
            role="progressbar"
            aria-label="Quanto do lote atual já passou"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            data-progresso-barra
          >
            <span class="ipa-progresso__cheio" data-progresso-fill></span>
          </div>
          <p class="ipa-progresso__texto">
            <strong data-lote>{LOTE_INICIAL.rotulo}</strong> de <s>{VALOR_CHEIO_IMERSAO}</s> por
            <strong data-preco>{LOTE_INICIAL.valor}</strong>
            <span class="ipa-progresso__prazo" data-ate-linha>· vale até <span data-ate>{LOTE_INICIAL.ate}</span></span>
            <span class="ipa-progresso__prox" data-proximo-curto>· próximo lote: {PROXIMO_INICIAL}</span>
          </p>
        </div>
      </div>

      <!-- 2. Destaque, colado na base do topo -->
      <ul class="ipa-destaque">
        <li><strong>+7 anos</strong> no atacado</li>
        <li><strong>+100 marcas</strong> de atacado mentoradas</li>
        <li>marcas de <strong>R$&nbsp;200&nbsp;mil a 7&nbsp;dígitos</strong> por mês</li>
      </ul>
    </header>

    <main>
      <!-- 3. Por que dobrar é possível --------------------------------------- -->
      <section class="ipa-dobrar">
        <div class="ipa-largura ipa-dobrar__grade">
          <h2 class="ipa-h2">Dobrar o faturamento não pede dobrar tudo</h2>
          <div class="ipa-dobrar__texto">
            <p>
              O faturamento do seu atacado sai de três números: quantas revendedoras ativas você
              tem, quantas delas recompram no mês e o ticket de cada pedido.
            </p>
            <p class="ipa-dobrar__conta">Se cada um dos três subir 26%, o faturamento dobra.</p>
            <p>
              No sábado você faz essa conta com os números da sua marca e descobre qual dos três
              está mais perto de subir.
            </p>
            <!-- Aqui entra o caso de uma marca mentorada que dobrou em um ano (antes e depois).
                 O conteúdo ainda vai ser enviado pela usuária. -->
          </div>
        </div>
      </section>

      <!-- 4. Marcas que aplicam o método ------------------------------------ -->
      <section class="ipa-marcas" aria-labelledby="ipa-marcas-titulo">
        <ul class="ipa-marcas__faixa">
          {marcas.map((m) => (
            <li class="ipa-marca">
              <a href={`https://www.instagram.com/${m.arroba}/`} target="_blank" rel="noopener" class="ipa-marca__link">
                <Image
                  src={m.img}
                  alt={`Perfil @${m.arroba} no Instagram`}
                  widths={[320, 422]}
                  sizes="17rem"
                  class="ipa-marca__print"
                  loading="lazy"
                />
                <span class="ipa-marca__legenda">
                  <span class="ipa-marca__nicho">{m.nicho}</span>
                  <span class="ipa-marca__arroba">@{m.arroba}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <h2 class="ipa-marcas__titulo" id="ipa-marcas-titulo">
          Marcas de atacado que aplicam o método do Felipe
        </h2>
      </section>

      <!-- 5. Identificação --------------------------------------------------- -->
      <section class="ipa-claro ipa-sinais">
        <div class="ipa-largura ipa-sinais__grade">
          <h2 class="ipa-h2 ipa-sinais__titulo">Seu atacado vai fechar 2027 faturando o mesmo se:</h2>
          <ul class="ipa-sinais__lista">
            {sinais.map((s) => (
              <li>
                <svg class="ipa-icone" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="m9 9 6 6M15 9l-6 6" /></svg>
                <span>{s}</span>
              </li>
            ))}
          </ul>
          <p class="ipa-sinais__fecho">Se isso soa familiar, a Imersão é para você.</p>
        </div>
      </section>

      <!-- 6. O plano que você monta no sábado --------------------------------------- -->
      <section class="ipa-claro ipa-decisoes">
        <div class="ipa-decisoes__foto">
          <Image
            src={fotoNotebook}
            alt="Felipe Santos trabalhando no notebook"
            widths={[480, 800, 1100]}
            sizes="(min-width: 880px) 38vw, 100vw"
            loading="lazy"
          />
        </div>
        <div class="ipa-decisoes__texto">
          <h2 class="ipa-h2">O plano que você monta no sábado</h2>
          <dl class="ipa-decisoes__lista">
            {plano.map((d) => (
              <div class="ipa-decisoes__linha">
                <dt>{d.titulo}</dt>
                <dd>{d.desc}</dd>
              </div>
            ))}
          </dl>
          <p class="ipa-decisoes__fecho">Tudo preenchido na planilha do Planejamento 2027, com os números da sua marca.</p>
          <p class="ipa-decisoes__frase">No atacado, a venda começa na reposição.</p>
          <a class="ipa-botao ipa-botao--escuro" href={HREF_COMPRA} data-checkout>
            <span>Garantir meu ingresso | <span data-lote-botao>{LOTE_BOTAO_INICIAL}</span></span>
          </a>
        </div>
      </section>

      <!-- 7. Como funciona o dia --------------------------------------------- -->
      <section class="ipa-dia">
        <div class="ipa-largura ipa-dia__grade">
          <div class="ipa-dia__cabeca">
            <p class="ipa-pilula">
              <svg class="ipa-icone" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="1.5" /><path d="M3.5 9.5h17M8 3v4M16 3v4" /></svg>
              Sábado, 12/12 | 9h30 às 17h30
            </p>
            <h2 class="ipa-h2">Como funciona o dia</h2>
          </div>
          <div class="ipa-dia__cartao">
            <ol class="ipa-dia__lista">
              {agenda.map((a) => (
                <li>
                  <span class="ipa-dia__hora">
                    <svg class="ipa-icone" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="7.5" /><path d="M12 9.5V13l2.5 1.5M9.5 3h5" /></svg>
                    {a.hora}
                  </span>
                  <span class="ipa-dia__o">{a.o}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      <!-- 8. Preço ------------------------------------------------------------ -->
      <section class="ipa-oferta" id="ingresso">
        <div class="ipa-oferta__cartao">
          <h2 class="ipa-oferta__titulo">Imersão Planejamento Atacado 2027</h2>
          <p class="ipa-oferta__data">Sábado, 12/12 | Online e ao vivo</p>
          <ul class="ipa-oferta__itens">
            {ofertaItens.map((item) => (
              <li>
                <svg class="ipa-icone" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <div class="ipa-oferta__precos ipa-preco-bloco">
            <span class="ipa-oferta__de">De <s>{VALOR_CHEIO_IMERSAO}</s> por:</span>
            <strong class="ipa-oferta__valor" data-preco>{LOTE_INICIAL.valor}</strong>
          </div>
          <a class="ipa-botao ipa-botao--escuro ipa-oferta__botao" href={HREF_COMPRA} data-checkout>
            <span>Garantir meu ingresso | <span data-lote-botao>{LOTE_BOTAO_INICIAL}</span></span>
          </a>
          <div class="ipa-progresso ipa-progresso--claro ipa-preco-bloco">
            <div class="ipa-progresso__trilho" aria-hidden="true">
              <span class="ipa-progresso__cheio" data-progresso-fill></span>
            </div>
            <p class="ipa-progresso__texto" data-proximo-frase>{TEXTO_PROXIMO_INICIAL}</p>
          </div>
        </div>
      </section>

      <!-- 9. Depoimentos: mesmos vídeos da home, texto próprio desta página, em faixa bege -->
      <div class="ipa-depoimentos">
        <VideoTestimonials
          title="O que dizem as marcas que aplicam o método"
          sub="São marcas que vendem para revendedoras, como a sua. Aperte o play e ouça o que mudou no atacado delas."
          videos={DEPOIMENTOS_HOME}
        />
      </div>

      <!-- 10. Quem conduz ------------------------------------------------------ -->
      <section class="ipa-felipe">
        <div class="ipa-largura ipa-felipe__grade">
          <div class="ipa-felipe__texto">
            <h2 class="ipa-felipe__nome">Felipe Santos</h2>
            <p class="ipa-felipe__bio">
              Há mais de sete anos no atacado. Mentor de mais de 100 marcas, de R$&nbsp;200&nbsp;mil a
              sete dígitos por mês. Criador da Equação Exponencial: Entrada Previsível de novos
              revendedores + Recompra Escalável de revendedores ativos.
            </p>
          </div>
          <div class="ipa-felipe__foto">
            <Image
              src={fotoMesa}
              alt="Felipe Santos no escritório"
              widths={[480, 800, 1100]}
              sizes="(min-width: 880px) 40vw, 100vw"
              loading="lazy"
            />
          </div>
        </div>
      </section>

      <!-- 11. Garantia ---------------------------------------------------------- -->
      <section class="ipa-garantia">
        <div class="ipa-largura">
          <div class="ipa-garantia__cartao">
            <svg class="ipa-icone" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4.5 6v5.5c0 4.6 3.1 8 7.5 9.5 4.4-1.5 7.5-4.9 7.5-9.5V6L12 3Z" /><path d="m9 12 2.2 2.2L15.2 10" /></svg>
            <div>
              <h2 class="ipa-garantia__titulo">Participou e achou que não valeu?</h2>
              <p class="ipa-garantia__texto">Você pede o reembolso até 2 dias depois do evento.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 12. Perguntas frequentes -------------------------------------------- -->
      <section class="ipa-faq">
        <div class="ipa-largura ipa-faq__grade">
          <h2 class="ipa-h2">Perguntas frequentes</h2>
          <div class="ipa-faq__lista">
            {faqs.map((f) => (
              <details class="ipa-faq__item">
                <summary>
                  <span>{f.q}</span>
                  <svg class="ipa-icone ipa-faq__sinal" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 6v12M6 12h12" /></svg>
                </summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    </main>

    <!-- 13. Fechamento -------------------------------------------------------- -->
    <section class="ipa-fechamento">
      <div class="ipa-largura ipa-fechamento__corpo">
        <h2 class="ipa-fechamento__titulo">{HEADLINE}</h2>
        <a class="ipa-botao" href={HREF_COMPRA} data-checkout>
          <span>Garantir meu ingresso | <span data-lote-botao>{LOTE_BOTAO_INICIAL}</span></span>
          <svg class="ipa-icone" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8.5V6a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v2.5a3.5 3.5 0 0 0 0 7V18a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-2.5a3.5 3.5 0 0 0 0-7Z" /><path d="M14 5v14" stroke-dasharray="2 2.2" /></svg>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Paleta: só as cores do site (src/styles/global.css). */
  .ipa {
    --carvao: #1e1e1e;
    --fundo: #171717;
    --cinza: #393536;
    --bege: #f5f0eb;
    --bege-tinta: rgba(30, 30, 30, 0.72);
    --branco-2: rgba(255, 255, 255, 0.68);
    --fio: rgba(255, 255, 255, 0.12);
    --gutter: clamp(1rem, 4vw, 2.5rem);
    background: var(--fundo);
    color: #fff;
    overflow-x: clip;
  }
  .ipa ::selection {
    background: var(--bege);
    color: var(--carvao);
  }
  .ipa-largura {
    width: 100%;
    max-width: 76rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .ipa-icone {
    width: 1.15em;
    height: 1.15em;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ipa-h2 {
    font-size: clamp(1.9rem, 4.4vw, 3.4rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  /* ---- Botão: retângulo chapado, como na referência ------------------------ */
  .ipa-botao {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: var(--bege);
    color: var(--carvao);
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 1.15rem 1.75rem;
    border-radius: 4px;
    box-shadow: 0 10px 30px -12px rgba(245, 240, 235, 0.45);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }
  .ipa-botao:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 36px -14px rgba(245, 240, 235, 0.6);
  }
  .ipa-botao:focus-visible,
  .ipa a:focus-visible,
  .ipa summary:focus-visible {
    outline: 2px solid var(--bege);
    outline-offset: 3px;
  }
  .ipa-botao--escuro {
    background: var(--carvao);
    color: var(--bege);
    box-shadow: 0 12px 28px -14px rgba(30, 30, 30, 0.55);
  }
  .ipa-botao--escuro:hover {
    box-shadow: 0 16px 34px -14px rgba(30, 30, 30, 0.7);
  }
  .ipa-claro .ipa-botao--escuro:focus-visible,
  .ipa-oferta .ipa-botao--escuro:focus-visible {
    outline-color: var(--carvao);
  }

  /* ---- Vendas encerradas ---------------------------------------------------- */
  .ipa-encerrado {
    background: var(--cinza);
    text-align: center;
    padding: 1rem var(--gutter);
    font-weight: 700;
  }
  .ipa[data-vendas='encerradas'] .ipa-encerrado[hidden] {
    display: block;
  }
  .ipa[data-vendas='encerradas'] .ipa-preco-bloco,
  .ipa[data-vendas='encerradas'] [data-ir-preco],
  .ipa[data-vendas='encerradas'] [data-checkout] {
    display: none;
  }

  /* ---- 1. Topo ------------------------------------------------------------- */
  .ipa-hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    background: var(--carvao);
  }
  /* Celular: a foto é um bloco no alto (rosto e quadro visíveis) e o texto
     entra por baixo, sobre o véu que funde a foto no carvão. */
  .ipa-hero__foto {
    position: absolute;
    inset: 0 0 auto 0;
    width: 100%;
    height: 64svh;
    object-fit: cover;
    object-position: 58% 30%;
    z-index: -2;
  }
  .ipa-hero__veu {
    position: absolute;
    inset: 0 0 auto 0;
    height: 64svh;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(30, 30, 30, 0.6) 0%, rgba(30, 30, 30, 0) 22%),
      linear-gradient(0deg, var(--carvao) 0%, rgba(30, 30, 30, 0.7) 22%, rgba(30, 30, 30, 0) 50%);
  }
  .ipa-topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem var(--gutter);
    border-bottom: 1px solid var(--fio);
  }
  .ipa-topo__logo {
    height: 1.6rem;
    width: auto;
    filter: brightness(0) invert(1);
  }
  .ipa-topo__data {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(23, 23, 23, 0.55);
    backdrop-filter: blur(6px);
    padding: 0.5rem 0.8rem;
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .ipa-topo__sep {
    color: rgba(255, 255, 255, 0.4);
    margin-inline: 0.1rem;
  }
  .ipa-topo__extra {
    display: none;
  }
  @media (max-width: 400px) {
    .ipa-topo__dia {
      display: none;
    }
    .ipa-topo__logo {
      height: 1.35rem;
    }
  }
  .ipa-hero__corpo {
    margin-top: auto;
    width: 100%;
    max-width: 76rem;
    margin-inline: auto;
    padding: 44svh var(--gutter) 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
  }
  .ipa-hero__titulo {
    max-width: 19ch;
    font-size: clamp(1.7rem, 5.4vw, 3.1rem);
    line-height: 1;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .ipa-hero__sub {
    max-width: 36rem;
    color: var(--branco-2);
    font-size: 0.98rem;
    line-height: 1.55;
  }
  .ipa-hero .ipa-botao {
    margin-top: 0.4rem;
  }

  /* ---- Barra de progresso do lote ------------------------------------------ */
  .ipa-progresso {
    width: 100%;
    max-width: 28rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .ipa-progresso__trilho {
    height: 6px;
    background: rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    overflow: hidden;
  }
  /* Enche por transform (scaleX), não por width: sem recalcular layout. */
  .ipa-progresso__cheio {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--bege);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ipa-progresso__texto {
    font-size: 0.78rem;
    color: var(--branco-2);
    line-height: 1.5;
  }
  .ipa-progresso__texto strong {
    color: #fff;
  }
  .ipa-progresso--claro .ipa-progresso__trilho {
    background: rgba(30, 30, 30, 0.14);
  }
  .ipa-progresso--claro .ipa-progresso__cheio {
    background: var(--carvao);
  }
  .ipa-progresso--claro .ipa-progresso__texto {
    color: var(--bege-tinta);
    text-align: center;
  }

  /* ---- 2. Destaque --------------------------------------------------------- */
  .ipa-destaque {
    list-style: none;
    width: 100%;
    max-width: 76rem;
    margin-inline: auto;
    padding: 1.25rem var(--gutter) 1.75rem;
    display: grid;
    gap: 0.9rem;
    border-top: 1px solid var(--fio);
    color: var(--branco-2);
    font-size: 0.85rem;
  }
  .ipa-destaque strong {
    color: #fff;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    margin-inline-end: 0.3rem;
  }

  /* ---- 3. Marcas ------------------------------------------------------------ */
  .ipa-marcas {
    padding-block: 3.5rem 4.5rem;
    background: var(--fundo);
  }
  .ipa-marcas__faixa {
    list-style: none;
    display: flex;
    gap: 0.9rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    padding: 0 var(--gutter) 0.5rem;
    scrollbar-width: none;
  }
  .ipa-marcas__faixa::-webkit-scrollbar {
    display: none;
  }
  .ipa-marca {
    flex: 0 0 15.5rem;
    scroll-snap-align: start;
  }
  /* O card é o print: recorte alto, borda fina e a legenda por cima de um véu
     escuro na base, como os cards de mentorados da referência. */
  .ipa-marca__link {
    position: relative;
    display: block;
    aspect-ratio: 422 / 600;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--fio);
    background: #fff;
    box-shadow: 0 24px 50px -28px rgba(0, 0, 0, 0.9);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ipa-marca__link:hover {
    transform: translateY(-4px);
  }
  .ipa-marca__print {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .ipa-marca__legenda {
    position: absolute;
    inset: auto 0 0 0;
    padding: 3.5rem 1rem 1rem;
    background: linear-gradient(0deg, rgba(23, 23, 23, 0.96) 15%, rgba(23, 23, 23, 0));
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .ipa-marca__nicho {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(245, 240, 235, 0.75);
  }
  .ipa-marca__arroba {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .ipa-marcas__titulo {
    max-width: 76rem;
    margin: 2.5rem auto 0;
    padding-inline: var(--gutter);
    text-align: right;
    font-size: clamp(1.15rem, 2.4vw, 1.6rem);
    font-weight: 400;
    color: var(--branco-2);
    line-height: 1.35;
  }

  /* ---- Seções claras (bege) ------------------------------------------------- */
  .ipa-claro {
    background: var(--bege);
    color: var(--carvao);
  }

  /* ---- 4. Decisões ---------------------------------------------------------- */
  .ipa-decisoes {
    display: grid;
    padding-block: 0 4.5rem;
  }
  .ipa-decisoes__foto img {
    width: 100%;
    height: 22rem;
    object-fit: cover;
    object-position: 50% 30%;
    display: block;
  }
  .ipa-decisoes__texto {
    padding: 3rem var(--gutter) 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
  }
  .ipa-decisoes__lista {
    width: 100%;
    border-top: 1px solid rgba(30, 30, 30, 0.15);
  }
  .ipa-decisoes__linha {
    display: grid;
    gap: 0.3rem;
    padding-block: 1.15rem;
    border-bottom: 1px solid rgba(30, 30, 30, 0.15);
  }
  .ipa-decisoes__linha dt {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .ipa-decisoes__linha dd {
    color: var(--bege-tinta);
    font-size: 0.98rem;
  }
  .ipa-decisoes__fecho {
    color: var(--bege-tinta);
    font-size: 1rem;
    max-width: 30rem;
  }
  .ipa-decisoes__frase {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  /* ---- 5. Identificação ------------------------------------------------------ */
  .ipa-sinais {
    padding-block: 4rem 5rem;
    border-top: 1px solid rgba(30, 30, 30, 0.1);
  }
  .ipa-sinais__grade {
    display: grid;
    gap: 2rem;
  }
  .ipa-sinais__lista {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .ipa-sinais__lista li {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    background: #fff;
    border: 1px solid rgba(30, 30, 30, 0.08);
    border-radius: 8px;
    padding: 1rem 1.15rem;
    font-size: 0.98rem;
    line-height: 1.5;
    color: rgba(30, 30, 30, 0.85);
  }
  .ipa-sinais__lista .ipa-icone {
    margin-top: 0.15rem;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--carvao);
  }
  .ipa-sinais__fecho {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  /* ---- 6. Felipe ------------------------------------------------------------- */
  .ipa-felipe {
    padding-block: 4.5rem;
    background: var(--carvao);
  }
  .ipa-felipe__grade {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .ipa-felipe__papel {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(245, 240, 235, 0.7);
  }
  .ipa-felipe__nome {
    margin-top: 0.6rem;
    font-size: clamp(2.6rem, 8vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }
  .ipa-felipe__bio {
    margin-top: 1.5rem;
    max-width: 34rem;
    color: var(--branco-2);
    font-size: 1.08rem;
    line-height: 1.6;
  }
  .ipa-felipe__foto img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 40% 30%;
    border-radius: 10px;
    display: block;
  }

  /* ---- 7. Como funciona o dia ------------------------------------------------- */
  .ipa-dia {
    padding-block: 4.5rem;
    background: var(--fundo);
  }
  .ipa-dia__grade {
    display: grid;
    gap: 2.25rem;
    align-items: center;
  }
  .ipa-dia__cabeca {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .ipa-pilula {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 4px;
    padding: 0.5rem 0.8rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  /* Card com luz diagonal em bege sobre o cinza quente: o equivalente do
     degradê vermelho do cronograma da referência, dentro da nossa paleta. */
  .ipa-dia__cartao {
    position: relative;
    border-radius: 12px;
    padding: 4.5rem 1.25rem 1.25rem;
    background:
      linear-gradient(135deg, rgba(245, 240, 235, 0.32) 0%, rgba(245, 240, 235, 0.06) 28%, transparent 46%),
      linear-gradient(160deg, var(--cinza) 0%, #262424 55%, var(--carvao) 100%);
    border: 1px solid var(--fio);
    box-shadow: 0 30px 60px -36px rgba(0, 0, 0, 0.9);
  }
  .ipa-dia__lista {
    list-style: none;
    border: 1px solid var(--fio);
    border-radius: 8px;
    background: rgba(23, 23, 23, 0.55);
  }
  .ipa-dia__lista li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.15rem;
  }
  .ipa-dia__lista li + li {
    border-top: 1px solid var(--fio);
  }
  .ipa-dia__hora {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-size: 1.1rem;
    font-variant-numeric: tabular-nums;
  }
  .ipa-dia__o {
    color: var(--branco-2);
    font-size: 0.95rem;
  }

  /* ---- 8. Preço: bloco bege chapado (o vermelho da referência) --------------- */
  .ipa-oferta {
    padding: 4.5rem var(--gutter) 5rem;
    background:
      radial-gradient(60rem 30rem at 50% 0%, rgba(245, 240, 235, 0.08), transparent 70%),
      var(--fundo);
    scroll-margin-top: 1rem;
  }
  .ipa-oferta__cartao {
    max-width: 32rem;
    margin-inline: auto;
    background: var(--bege);
    color: var(--carvao);
    border-radius: 12px;
    padding: 2.25rem 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: 0 40px 80px -40px rgba(245, 240, 235, 0.35);
  }
  .ipa-oferta__titulo {
    font-size: 1.35rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .ipa-oferta__data {
    align-self: flex-start;
    border: 1px solid rgba(30, 30, 30, 0.3);
    border-radius: 4px;
    padding: 0.45rem 0.75rem;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .ipa-oferta__itens {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .ipa-oferta__itens li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .ipa-oferta__itens .ipa-icone {
    margin-top: 0.15rem;
    stroke-width: 2.2;
  }
  .ipa-oferta__precos {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(30, 30, 30, 0.15);
  }
  .ipa-oferta__de {
    font-size: 0.95rem;
    color: var(--bege-tinta);
  }
  .ipa-oferta__valor {
    font-size: clamp(3.75rem, 14vw, 5.25rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
  }
  .ipa-oferta__botao {
    width: 100%;
  }
  .ipa-oferta .ipa-progresso {
    max-width: none;
  }

  /* ---- 9. Depoimentos em faixa bege ------------------------------------------ */
  /* VideoTestimonials é compartilhado com a home: aqui só muda o fundo e o
     tamanho do título, sem tocar no componente. */
  .ipa-depoimentos :global(.vtesti) {
    background: var(--bege);
  }
  .ipa-depoimentos :global(.vtesti .eyebrow) {
    display: none;
  }
  .ipa-depoimentos :global(.vtesti .section-title) {
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 0.98;
  }

  /* ---- 3. Por que dobrar é possível ------------------------------------------- */
  .ipa-dobrar {
    padding-block: 4.5rem;
    background: var(--carvao);
    border-top: 1px solid var(--fio);
  }
  .ipa-dobrar__grade {
    display: grid;
    gap: 1.75rem;
  }
  .ipa-dobrar__texto {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: var(--branco-2);
    font-size: 1.08rem;
    line-height: 1.6;
    max-width: 34rem;
  }
  .ipa-dobrar__conta {
    color: #fff;
    font-weight: 700;
    font-size: clamp(1.45rem, 3.4vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    padding-block: 1.25rem;
    border-block: 1px solid var(--fio);
    text-wrap: balance;
  }

  /* ---- 11. Garantia ------------------------------------------------------------ */
  .ipa-garantia {
    padding-block: 4.5rem 0;
    background: var(--fundo);
  }
  .ipa-garantia__cartao {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    background: #242424;
    border: 1px solid var(--fio);
    border-radius: 8px;
    padding: 1.5rem 1.25rem;
  }
  .ipa-garantia__cartao .ipa-icone {
    width: 2.25rem;
    height: 2.25rem;
    color: var(--bege);
    stroke-width: 1.4;
  }
  .ipa-garantia__titulo {
    font-size: clamp(1.2rem, 2.6vw, 1.6rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .ipa-garantia__texto {
    margin-top: 0.4rem;
    color: var(--branco-2);
    font-size: 1.02rem;
    line-height: 1.55;
  }

  /* ---- 11. FAQ ----------------------------------------------------------------- */
  .ipa-faq {
    padding-block: 4.5rem;
    background: var(--fundo);
  }
  .ipa-faq__grade {
    display: grid;
    gap: 2rem;
  }
  .ipa-faq__lista {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .ipa-faq__item {
    background: #242424;
    border: 1px solid var(--fio);
    border-radius: 8px;
  }
  .ipa-faq__item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.2rem;
    font-weight: 700;
    font-size: 1rem;
  }
  .ipa-faq__item summary::-webkit-details-marker {
    display: none;
  }
  .ipa-faq__sinal {
    width: 1.6rem;
    height: 1.6rem;
    padding: 0.3rem;
    border-radius: 999px;
    background: var(--bege);
    color: var(--carvao);
    stroke-width: 2.4;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ipa-faq__item[open] .ipa-faq__sinal {
    transform: rotate(45deg);
  }
  .ipa-faq__item p {
    padding: 0 1.2rem 1.2rem;
    color: var(--branco-2);
    line-height: 1.6;
    max-width: 62ch;
  }

  /* ---- 12. Fechamento ----------------------------------------------------------- */
  .ipa-fechamento {
    padding-block: 5rem 5.5rem;
    background:
      radial-gradient(50rem 24rem at 50% 100%, rgba(245, 240, 235, 0.1), transparent 70%),
      var(--carvao);
    border-top: 1px solid var(--fio);
  }
  .ipa-fechamento__corpo {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2rem;
  }
  .ipa-fechamento__titulo {
    max-width: 22ch;
    font-size: clamp(1.5rem, 4.2vw, 2.4rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  /* ---- Celular estreito: botão ocupa a largura --------------------------------- */
  @media (max-width: 560px) {
    .ipa-botao {
      width: 100%;
      padding-inline: 1rem;
      font-size: 0.82rem;
    }
  }

  /* ---- Tablet em diante ----------------------------------------------------------- */
  @media (min-width: 720px) {
    .ipa-topo__extra {
      display: inline;
    }
    .ipa-destaque {
      grid-template-columns: repeat(3, auto);
      justify-content: space-between;
    }
    .ipa-marca {
      flex-basis: 17rem;
    }
  }

  @media (min-width: 880px) {
    /* Computador: foto à direita, texto à esquerda sobre o véu horizontal. */
    .ipa-hero__foto {
      inset: 0 0 0 auto;
      width: 62%;
      height: 100%;
      object-position: 50% 22%;
    }
    .ipa-hero__veu {
      inset: 0;
      height: 100%;
      background:
        linear-gradient(90deg, var(--carvao) 38%, rgba(30, 30, 30, 0.85) 50%, rgba(30, 30, 30, 0) 75%),
        linear-gradient(0deg, var(--carvao) 0%, rgba(30, 30, 30, 0) 30%);
    }
    .ipa-hero__corpo {
      margin-block: auto;
      padding-top: 3rem;
    }
    .ipa-decisoes {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 4rem;
      padding-block: 5.5rem;
      align-items: center;
    }
    .ipa-decisoes__foto img {
      height: auto;
      aspect-ratio: 4 / 5;
      border-radius: 0 12px 12px 0;
    }
    .ipa-decisoes__texto {
      padding: 0 var(--gutter) 0 0;
      max-width: 40rem;
    }
    .ipa-decisoes__linha {
      grid-template-columns: 13rem 1fr;
      gap: 1.5rem;
      align-items: baseline;
    }
    .ipa-sinais__grade {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: 4rem;
      align-items: start;
    }
    .ipa-sinais__titulo {
      position: sticky;
      top: 2rem;
    }
    .ipa-sinais__fecho {
      grid-column: 1 / -1;
    }
    .ipa-felipe__grade {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
    }
    .ipa-dia__grade {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
    .ipa-dia__cartao {
      padding: 5.5rem 2rem 2rem;
    }
    .ipa-dobrar__grade {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }
    .ipa-garantia__cartao {
      padding: 2rem 2.25rem;
      align-items: center;
    }
    .ipa-faq__grade {
      grid-template-columns: 22rem 1fr;
      gap: 4rem;
      align-items: start;
    }
    .ipa-oferta__cartao {
      padding: 2.75rem 2.5rem 2.25rem;
    }
  }

  @media (min-width: 1200px) {
    .ipa-marcas__faixa {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ipa-botao,
    .ipa-marca__link,
    .ipa-progresso__cheio,
    .ipa-faq__sinal {
      transition: none;
    }
  }
</style>

<script>
  // Lote vigente, barra de progresso e estado das vendas.
  //
  // Roda no navegador porque a página é estática. A hora vem do servidor
  // (/api/hora), como na Black: pinta primeiro com o relógio do aparelho e
  // corrige quando a resposta chega. Se a rede falhar, segue o aparelho.
  import { LOTES_IMERSAO } from '../data/lotes-imersao.js';
  import { loteVigente, textoProximo, fracaoDecorrida } from '../data/lotes-workshop.js';
  import { ligarCheckout } from '../scripts/checkout-venda';

  const wrapper = document.querySelector('.ipa') as HTMLElement | null;

  try {
    let desvioMs = 0;
    const agora = () => Date.now() + desvioMs;
    const todos = (sel: string) => Array.from(document.querySelectorAll(sel)) as HTMLElement[];

    function aplicar(estado: ReturnType<typeof loteVigente>) {
      if (estado.estado === 'encerrado') {
        if (wrapper) wrapper.dataset.vendas = 'encerradas';
        const aviso = document.querySelector('.ipa-encerrado') as HTMLElement | null;
        if (aviso) aviso.hidden = false;
        return;
      }
      const rotulo = estado.rotulo as string;
      const lote = LOTES_IMERSAO[estado.indice as number];

      todos('[data-lote]').forEach((el) => (el.textContent = rotulo));
      todos('[data-preco]').forEach((el) => (el.textContent = estado.valor as string));
      todos('[data-lote-botao]').forEach((el) => (el.textContent = rotulo.toLowerCase()));
      todos('[data-ate]').forEach((el) => (el.textContent = lote.ate));

      // Último lote: nunca anuncia um preço que não existe.
      todos('[data-proximo-curto]').forEach((el) => {
        el.textContent = estado.proximoValor ? `· próximo lote: ${estado.proximoValor}` : '· último lote';
      });
      const frase =
        textoProximo(estado.proximoValor, rotulo) ??
        'Último lote. As vendas encerram no início do evento, 12/12 às 9h30.';
      todos('[data-proximo-frase]').forEach((el) => (el.textContent = frase));
      if (estado.ultimo) {
        todos('[data-ate-linha]').forEach((el) => (el.textContent = '· vendas encerram 12/12 às 9h30'));
      }
    }

    function pintarProgresso(estado: ReturnType<typeof loteVigente>) {
      if (estado.estado !== 'aberto') return;
      const fracao = fracaoDecorrida(estado.inicioMs as number, estado.fimMs as number, agora());
      todos('[data-progresso-fill]').forEach((el) => (el.style.transform = `scaleX(${fracao})`));
      todos('[data-progresso-barra]').forEach((el) =>
        el.setAttribute('aria-valuenow', String(Math.round(fracao * 100))),
      );
    }

    let pintado: string | null = LOTES_IMERSAO[0].rotulo;
    let timer = 0;

    function tique() {
      const estado = loteVigente(agora(), LOTES_IMERSAO);
      const chave = estado.estado === 'aberto' ? (estado.rotulo as string) : 'encerrado';
      if (chave !== pintado) {
        pintado = chave;
        aplicar(estado);
      }
      pintarProgresso(estado);
      if (estado.estado === 'encerrado' && timer) {
        window.clearInterval(timer);
        timer = 0;
      }
    }

    async function sincronizarHora() {
      try {
        const r = await fetch('/api/hora', { cache: 'no-store' });
        if (!r.ok) return;
        const dados = (await r.json()) as { agora?: unknown };
        if (typeof dados.agora !== 'number' || !Number.isFinite(dados.agora)) return;
        desvioMs = dados.agora - Date.now();
      } catch (e) {
        /* fica no relógio do aparelho */
      }
    }

    // Primeiro quadro: a barra nasce vazia e enche até o ponto certo (é o único
    // movimento da página que conta alguma coisa).
    requestAnimationFrame(() => tique());
    sincronizarHora().then(tique);
    // Lotes de 3 a 7 dias: um tique por minuto basta e ainda vira o lote com a
    // aba aberta.
    timer = window.setInterval(tique, 60_000);
  } catch (e) {
    /* o HTML inicial (lote 01) já é legível e vendável */
  }

  if (wrapper) ligarCheckout(wrapper);
</script>
