      transition: none;
    }
  }
</style>

<script>
  // Lote vigente, barra de progresso e estado das vendas.
  //
  // Roda no navegador porque a página é estática. A hora vem do servidor
  // (/api/hora), como na Black: pinta primeiro com o relógio do aparelho e
  // corrige quando a resposta chega. Se a rede falhar, segue o aparelho.
  import { LOTES_IMERSAO } from '../data/lotes-imersao.js';
  import { loteVigente, textoProximo, fracaoDecorrida } from '../data/lotes-workshop.js';
  import { ligarCheckout } from '../scripts/checkout-venda';

  const wrapper = document.querySelector('.ipa') as HTMLElement | null;

  try {
    let desvioMs = 0;
    const agora = () => Date.now() + desvioMs;
    const todos = (sel: string) => Array.from(document.querySelectorAll(sel)) as HTMLElement[];

    function aplicar(estado: ReturnType<typeof loteVigente>) {
      if (estado.estado === 'encerrado') {
        if (wrapper) wrapper.dataset.vendas = 'encerradas';
        const aviso = document.querySelector('.ipa-encerrado') as HTMLElement | null;
        if (aviso) aviso.hidden = false;
        return;
      }
      const rotulo = estado.rotulo as string;
      const lote = LOTES_IMERSAO[estado.indice as number];

      todos('[data-lote]').forEach((el) => (el.textContent = rotulo));
      todos('[data-preco]').forEach((el) => (el.textContent = estado.valor as string));
      todos('[data-lote-botao]').forEach((el) => (el.textContent = rotulo.toLowerCase()));
      todos('[data-ate]').forEach((el) => (el.textContent = lote.ate));

      // Último lote: nunca anuncia um preço que não existe. Diz que as
      // vendas encerram no início do evento.
      const curto = estado.proximoValor
        ? `Próximo lote: ${estado.proximoValor}`
        : 'Último lote';
      todos('[data-proximo-curto]').forEach((el) => (el.textContent = curto));

      const frase = textoProximo(estado.proximoValor, rotulo) ??
        'Último lote. As vendas encerram no início do evento, 05/12 às 9h30.';
      todos('[data-proximo-frase]').forEach((el) => (el.textContent = frase));

      todos('[data-ate-linha]').forEach((el) => {
        if (estado.ultimo) el.textContent = 'Vendas encerram no início do evento, 05/12 às 9h30';
      });
    }

    function pintarProgresso(estado: ReturnType<typeof loteVigente>) {
      if (estado.estado !== 'aberto') return;
      const pct = Math.round(
        fracaoDecorrida(estado.inicioMs as number, estado.fimMs as number, agora()) * 1000,
      ) / 10;
      todos('[data-progresso-fill]').forEach((el) => (el.style.transform = `scaleX(${pct / 100})`));
      todos('[data-progresso-barra]').forEach((el) =>
        el.setAttribute('aria-valuenow', String(Math.round(pct))),
      );
    }

    let pintado: string | null = LOTES_IMERSAO[0].rotulo;
    let timer = 0;

    function tique() {
      const estado = loteVigente(agora(), LOTES_IMERSAO);
      const chave = estado.estado === 'aberto' ? (estado.rotulo as string) : 'encerrado';
      if (chave !== pintado) {
        pintado = chave;
        aplicar(estado);
      }
      pintarProgresso(estado);
      if (estado.estado === 'encerrado' && timer) {
        window.clearInterval(timer);
        timer = 0;
      }
    }

    async function sincronizarHora() {
      try {
        const r = await fetch('/api/hora', { cache: 'no-store' });
        if (!r.ok) return;
        const dados = (await r.json()) as { agora?: unknown };
        if (typeof dados.agora !== 'number' || !Number.isFinite(dados.agora)) return;
        desvioMs = dados.agora - Date.now();
      } catch (e) {
        /* fica no relógio do aparelho */
      }
    }

    tique();
    sincronizarHora().then(tique);
    // A barra anda devagar (lotes de 3 a 7 dias): um tique por minuto basta e
    // ainda vira o lote com a aba aberta.
    timer = window.setInterval(tique, 60_000);
  } catch (e) {
    /* o HTML inicial (lote 01) já é legível e vendável */
  }

  if (wrapper) ligarCheckout(wrapper);
</script>
