---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import VideoTestimonials from '../components/sections/VideoTestimonials.astro';
import AboutFelipe from '../components/sections/AboutFelipe.astro';
import ContatoWhatsapp from '../components/obrigada/ContatoWhatsapp.astro';
import EquacaoMetodo from '../components/obrigada/EquacaoMetodo.astro';

// Proposta B da página de obrigada: ângulo de preparação. O centro da página
// é a conta interativa: a pessoa digita quantas revendedoras novas entraram e
// quantas voltaram para repor, e as 10 figuras mostram a taxa contra a régua
// do Felipe (6 de cada 10). É só visual: nada é salvo nem enviado.
// Em aprovação: nenhum formulário redireciona para cá ainda.
const REGUA = 6;
const figuras = Array.from({ length: 10 }, (_, i) => i);

// Os mesmos depoimentos em vídeo da home
const depoimentos = [
  { name: 'Jaque', videoId: '101c1525-fa13-4fe6-a61e-fe38600dec12' },
  { name: 'Barraca do Willinha', videoId: 'a7d5602a-4f1e-4d28-9b83-9cfc53fde08a' },
  { name: 'Adriana', videoId: '03f4e18a-1f52-40f5-844a-3f900f705126' },
  { name: 'Jossanclê', videoId: 'd8d67535-9b07-4713-a21f-14eb4cd70f6b' },
];

const stats = [
  { value: '+100', label: 'marcas atendidas' },
  { value: '2013', label: 'no digital' },
  { value: '1º', label: 'método próprio para atacado' },
];

const bio = [
  'Comecei no varejo em 2013. Em 2018, a convite de uma grande influenciadora de moda do país, me mudei para o Bom Retiro, no coração do atacado de São Paulo, e passei quase dois anos gerenciando uma marca de atacado de moda feminina com uma missão: fazer ela vender pela internet.',
  'Quase tudo que funcionava no varejo não funcionava ali. Tive que descobrir na prática o que funciona no atacado.',
  'De lá pra cá foram mais de 100 marcas atendidas e o Atacado Exponencial, o primeiro método construído do zero para o mercado atacado.',
];
---

<BaseLayout
  title="Aplicação recebida | Atacado Exponencial"
  description="Você está concorrendo a uma das vagas desta semana."
  showHeader={false}
  noindex
>
  <section class="topo">
    <div class="container topo__grid">
      <div class="topo__texto">
        <Image src={logo} alt="Atacado Exponencial" height={72} class="topo__logo" />
        <p class="topo__selo">Aplicação recebida</p>
        <h1 class="topo__titulo">Você está concorrendo a uma das vagas desta semana.</h1>
        <p class="topo__sub">O seu horário está reservado, e agora o nosso time analisa a sua aplicação. Se a sua marca for selecionada, o horário fica confirmado. Se não for, ele é cancelado e a gente avisa você pelo WhatsApp. Enquanto isso, faça a conta abaixo. É por ela que a conversa começa.</p>
      </div>

      <div class="conta" data-conta data-regua={REGUA}>
        <p class="conta__rotulo">Responda de cabeça</p>
        <h2 class="conta__titulo">Quantas revendedoras voltaram?</h2>

        <div class="conta__campos">
          <label class="conta__campo">
            <span>Quantas revendedoras novas fizeram o primeiro pedido no último mês?</span>
            <input type="number" inputmode="numeric" min="0" step="1" placeholder="0" data-novas />
          </label>
          <label class="conta__campo">
            <span>Dessas, quantas já voltaram para repor?</span>
            <input type="number" inputmode="numeric" min="0" step="1" placeholder="0" data-voltaram />
          </label>
        </div>

        <ul class="conta__fila" aria-hidden="true">
          {figuras.map((i) => (
            <li class={i === REGUA - 1 ? 'conta__rev conta__rev--regua' : 'conta__rev'} data-figura>
              <svg viewBox="0 0 24 32"><circle cx="12" cy="8" r="6" /><path d="M1 31c0-7 5-12 11-12s11 5 11 12Z" /></svg>
            </li>
          ))}
        </ul>

        <p class="conta__resultado" aria-live="polite" data-resultado>Preencha os dois números para ver onde a sua marca está na régua.</p>
      </div>
    </div>
  </section>

  <section class="section regua">
    <div class="container regua__inner">
      <p class="regua__texto"><strong>A régua do Felipe:</strong> a cada 10 revendedoras novas, pelo menos 6 precisam fazer a reposição. Abaixo disso, a marca paga caro demais por cada pedido.</p>
      <p class="regua__frase">No atacado, a venda começa na reposição.</p>
      <p class="regua__nota">Não sabe esses números de cabeça? Anote o que souber. Descobrir o resto faz parte da consultoria.</p>
    </div>
  </section>

  <section class="section aviso">
    <div class="container">
      <ContatoWhatsapp titulo="Fique de olho no WhatsApp">
        <p>O resultado da análise chega pelo número <strong>+55 19 98170-2315</strong>, em até 24 horas. Confirme a sua aplicação agora: a conversa abre com a mensagem pronta, é só enviar. Se a nossa mensagem ficar sem resposta, o horário passa para a próxima marca da fila.</p>
      </ContatoWhatsapp>
    </div>
  </section>

  <VideoTestimonials title="O que muda quando a conta fecha" videos={depoimentos} />

  <EquacaoMetodo
    titulo="O Atacado Exponencial cabe numa equação"
    entrada="A internet ensinou o atacado a ser um varejo disfarçado. O Pilar 1 coloca anúncio, perfil e comercial falando com a lojista, para a revendedora nova entrar todo mês por um caminho que a marca controla."
    recompra="Atacado é relacionamento. O Pilar 2 é o processo depois do primeiro pedido, que faz a revendedora voltar para repor sem depender de a marca correr atrás dela toda vez."
    fecho="A maioria das marcas tenta resolver os dois ao mesmo tempo. Na consultoria, a gente mostra qual atacar primeiro."
  />

  <AboutFelipe bio={bio} stats={stats} />
</BaseLayout>

<script>
  // Conta da régua: só mostra a taxa na tela, nada sai do navegador.
  const conta = document.querySelector<HTMLElement>('[data-conta]');
  if (conta) {
    const regua = Number(conta.dataset.regua);
    const novasEl = conta.querySelector<HTMLInputElement>('[data-novas]')!;
    const voltaramEl = conta.querySelector<HTMLInputElement>('[data-voltaram]')!;
    const figuras = conta.querySelectorAll<HTMLElement>('[data-figura]');
    const resultado = conta.querySelector<HTMLElement>('[data-resultado]')!;
    const fmt = new Intl.NumberFormat('pt-BR', { maximumFractionDigits: 1 });

    const atualizar = () => {
      const novas = Math.floor(Number(novasEl.value));
      const voltaram = Math.floor(Number(voltaramEl.value));
      conta.classList.remove('conta--acima', 'conta--abaixo');
      figuras.forEach((f) => f.classList.remove('conta__rev--acesa'));

      if (!novasEl.value || voltaramEl.value === '' || novas <= 0 || voltaram < 0) {
        resultado.textContent = 'Preencha os dois números para ver onde a sua marca está na régua.';
        return;
      }
      if (voltaram > novas) {
        resultado.textContent = 'Quem voltou para repor não pode passar do número de revendedoras novas.';
        return;
      }

      const deCada10 = (voltaram / novas) * 10;
      const acesas = Math.round(deCada10);
      figuras.forEach((f, i) => f.classList.toggle('conta__rev--acesa', i < acesas));

      const acima = deCada10 >= regua;
      conta.classList.add(acima ? 'conta--acima' : 'conta--abaixo');
      resultado.textContent = `${fmt.format(deCada10)} de cada 10 voltaram para repor. ${acima ? 'Dentro da régua.' : 'Abaixo da régua.'}`;
    };

    novasEl.addEventListener('input', atualizar);
    voltaramEl.addEventListener('input', atualizar);
  }
</script>

<style>
  .topo { padding-block: 2.5rem 4rem; }
  .topo__grid { display: grid; gap: 3rem; align-items: center; }
  .topo__logo { height: 1.75rem; width: auto; }
  .topo__selo {
    margin-top: 3rem; display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: 0.9rem; font-weight: 700;
  }
  .topo__selo::before {
    content: ''; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: hsl(var(--light-bg));
  }
  .topo__titulo {
    margin-top: 1rem;
    font-size: clamp(2.1rem, 6vw, 3.75rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
    max-width: 15ch;
  }
  .topo__sub { margin-top: 1.5rem; color: hsl(var(--muted-foreground)); font-size: 1.05rem; line-height: 1.6; max-width: 34rem; }

  /* A conta: painel bege com os dois campos e as 10 figuras que acendem */
  .conta {
    background: hsl(var(--light-bg));
    color: hsl(var(--light-fg));
    border-radius: 1.25rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
  }
  .conta__rotulo { font-size: 0.9rem; color: rgba(30, 30, 30, 0.6); }
  .conta__titulo { font-size: clamp(1.4rem, 3vw, 1.75rem); line-height: 1.2; margin-top: 0.35rem; }
  .conta__campos { margin-top: 1.5rem; display: grid; gap: 1rem; }
  .conta__campo { display: grid; grid-template-columns: 1fr 6.5rem; gap: 1rem; align-items: center; font-size: 0.98rem; line-height: 1.45; }
  .conta__campo input {
    width: 100%;
    font: inherit; font-weight: 700; font-size: 1.6rem; text-align: center;
    font-variant-numeric: tabular-nums;
    color: hsl(var(--light-fg));
    background: #fff;
    border: 1.5px solid rgba(30, 30, 30, 0.2);
    border-radius: 0.75rem;
    padding: 0.5rem 0.25rem;
    -moz-appearance: textfield;
  }
  .conta__campo input::-webkit-outer-spin-button,
  .conta__campo input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .conta__campo input:focus-visible { outline: 2px solid hsl(var(--light-fg)); outline-offset: 2px; border-color: transparent; }

  .conta__fila {
    list-style: none; padding: 1.75rem 0 0; margin: 1.75rem 0 0;
    border-top: 1px solid rgba(30, 30, 30, 0.12);
    display: grid; grid-template-columns: repeat(10, 1fr); gap: clamp(0.25rem, 1.2vw, 0.6rem);
  }
  .conta__rev { position: relative; }
  .conta__rev svg { width: 100%; height: auto; display: block; fill: none; stroke: rgba(30, 30, 30, 0.35); stroke-width: 1.5; transition: fill 0.25s ease, stroke 0.25s ease; }
  .conta__rev--acesa svg { fill: hsl(var(--light-fg)); stroke: hsl(var(--light-fg)); }
  /* A régua de 6: um traço depois da 6ª figura */
  .conta__rev--regua::after {
    content: ''; position: absolute; top: -0.5rem; bottom: -0.5rem;
    right: calc(clamp(0.25rem, 1.2vw, 0.6rem) / -2 - 1px);
    width: 2px; background: rgba(30, 30, 30, 0.55);
  }
  .conta__resultado { margin-top: 1.25rem; font-weight: 700; font-size: 1.05rem; line-height: 1.45; min-height: 3em; }
  .conta--abaixo .conta__resultado { color: #9c2f2f; }
  @media (prefers-reduced-motion: reduce) { .conta__rev svg { transition: none; } }

  @media (min-width: 960px) {
    .topo__grid { grid-template-columns: 1fr 1fr; gap: 4rem; }
  }

  .regua { border-top: 1px solid hsl(var(--border)); }
  .regua__inner { max-width: 48rem; }
  .regua__texto { font-size: 1.1rem; line-height: 1.6; color: hsl(var(--muted-foreground)); max-width: 36rem; }
  .regua__texto strong { color: hsl(var(--foreground)); }
  .regua__frase { margin-top: 1.25rem; font-size: clamp(1.5rem, 4vw, 2.25rem); font-weight: 700; line-height: 1.15; letter-spacing: -0.03em; }
  .regua__nota { margin-top: 1.5rem; font-size: 0.95rem; color: hsl(var(--muted-foreground)); }

  .aviso { border-top: 1px solid hsl(var(--border)); }
</style>
