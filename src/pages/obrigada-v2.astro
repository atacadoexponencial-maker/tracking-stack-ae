---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import VideoTestimonials from '../components/sections/VideoTestimonials.astro';
import AboutFelipe from '../components/sections/AboutFelipe.astro';
import ContatoWhatsapp from '../components/obrigada/ContatoWhatsapp.astro';
import EquacaoMetodo from '../components/obrigada/EquacaoMetodo.astro';

// Proposta B da página de obrigada: ângulo de preparação. O centro da página
// é a folha de caderno com a conta e a régua do Felipe desenhada (10
// revendedoras novas, 6 repondo). Em aprovação: nenhum formulário
// redireciona para cá ainda.
const regua = Array.from({ length: 10 }, (_, i) => i < 6);

// Os mesmos depoimentos em vídeo da home
const depoimentos = [
  { name: 'Jaque', videoId: '101c1525-fa13-4fe6-a61e-fe38600dec12' },
  { name: 'Barraca do Willinha', videoId: 'a7d5602a-4f1e-4d28-9b83-9cfc53fde08a' },
  { name: 'Adriana', videoId: '03f4e18a-1f52-40f5-844a-3f900f705126' },
  { name: 'Jossanclê', videoId: 'd8d67535-9b07-4713-a21f-14eb4cd70f6b' },
];

const stats = [
  { value: '+100', label: 'marcas atendidas' },
  { value: '2013', label: 'no digital' },
  { value: '1º', label: 'método próprio para atacado' },
];

const bio = [
  'Comecei no varejo em 2013. Em 2018, a convite de uma grande influenciadora de moda do país, me mudei para o Bom Retiro, no coração do atacado de São Paulo, e passei quase dois anos gerenciando uma marca de atacado de moda feminina com uma missão: fazer ela vender pela internet.',
  'Quase tudo que funcionava no varejo não funcionava ali. Tive que descobrir na prática o que funciona no atacado.',
  'De lá pra cá foram mais de 100 marcas atendidas e o Atacado Exponencial, o primeiro método construído do zero para o mercado atacado.',
];
---

<BaseLayout
  title="Aplicação recebida | Atacado Exponencial"
  description="Você está concorrendo a uma das vagas desta semana."
  showHeader={false}
  noindex
>
  <section class="topo">
    <div class="container topo__grid">
      <div class="topo__texto">
        <Image src={logo} alt="Atacado Exponencial" height={72} class="topo__logo" />
        <p class="topo__selo">Aplicação recebida</p>
        <h1 class="topo__titulo">Você está concorrendo a uma das vagas desta semana.</h1>
        <p class="topo__sub">Nosso time vai analisar a sua aplicação. Se a sua marca for selecionada, a gente chama você no WhatsApp para marcar a consultoria. Enquanto isso, faça a conta abaixo. É por ela que a conversa começa.</p>
      </div>

      <!-- A folha de caderno: pautada, com espaço para a resposta -->
      <div class="folha">
        <p class="folha__rotulo">Responda de cabeça</p>
        <h2 class="folha__titulo">Quantas revendedoras voltaram?</h2>
        <ol class="folha__perguntas">
          <li>
            <span>Quantas revendedoras novas fizeram o primeiro pedido no último mês?</span>
            <span class="folha__resposta" aria-hidden="true"></span>
          </li>
          <li>
            <span>Dessas, quantas já voltaram para repor?</span>
            <span class="folha__resposta" aria-hidden="true"></span>
          </li>
        </ol>
        <p class="folha__nota">Não sabe esses números de cabeça? Anote o que souber. Descobrir o resto faz parte da consultoria.</p>
      </div>
    </div>
  </section>

  <section class="section regua">
    <div class="container regua__inner">
      <p class="regua__nome">A régua do Felipe</p>
      <ul class="regua__fila" aria-label="De 10 revendedoras novas, 6 fazem a reposição">
        {regua.map((repos) => (
          <li class={repos ? 'regua__rev regua__rev--repos' : 'regua__rev'}>
            <svg viewBox="0 0 24 32" aria-hidden="true"><circle cx="12" cy="8" r="6" /><path d="M1 31c0-7 5-12 11-12s11 5 11 12Z" /></svg>
          </li>
        ))}
      </ul>
      <div class="regua__legenda" aria-hidden="true">
        <span><i class="regua__ponto regua__ponto--repos"></i>voltaram para repor</span>
        <span><i class="regua__ponto"></i>ficaram no primeiro pedido</span>
      </div>
      <p class="regua__texto">A cada 10 revendedoras novas, pelo menos 6 precisam fazer a reposição. Abaixo disso, a marca paga caro demais por cada pedido.</p>
      <p class="regua__frase">No atacado, a venda começa na reposição.</p>
    </div>
  </section>

  <section class="section aviso">
    <div class="container">
      <ContatoWhatsapp titulo="Fique de olho no WhatsApp">
        <p>O contato vem do número <strong>+55 19 98170-2315</strong>. Salve agora: se a mensagem ficar sem resposta, a vaga passa para a próxima marca da fila. A análise sai em até 24 horas.</p>
      </ContatoWhatsapp>
    </div>
  </section>

  <VideoTestimonials title="O que muda quando a conta fecha" videos={depoimentos} />

  <EquacaoMetodo
    titulo="O Atacado Exponencial cabe numa equação"
    entrada="A internet ensinou o atacado a ser um varejo disfarçado. O Pilar 1 coloca anúncio, perfil e comercial falando com a lojista, para a revendedora nova entrar todo mês por um caminho que a marca controla."
    recompra="Atacado é relacionamento. O Pilar 2 é o processo depois do primeiro pedido, que faz a revendedora voltar para repor sem depender de a marca correr atrás dela toda vez."
    fecho="A maioria das marcas tenta resolver os dois ao mesmo tempo. Na consultoria, a gente mostra qual atacar primeiro."
  />

  <AboutFelipe bio={bio} stats={stats} />
</BaseLayout>

<style>
  .topo { padding-block: 2.5rem 4rem; }
  .topo__grid { display: grid; gap: 3rem; align-items: center; }
  .topo__logo { height: 1.75rem; width: auto; }
  .topo__selo {
    margin-top: 3rem; display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: 0.9rem; font-weight: 700;
  }
  .topo__selo::before {
    content: ''; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: hsl(var(--light-bg));
  }
  .topo__titulo {
    margin-top: 1rem;
    font-size: clamp(2.1rem, 6vw, 3.75rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
    max-width: 15ch;
  }
  .topo__sub { margin-top: 1.5rem; color: hsl(var(--muted-foreground)); font-size: 1.05rem; line-height: 1.6; max-width: 34rem; }

  /* Folha pautada: as linhas saem de um gradiente repetido, a margem
     vermelha de caderno fica à esquerda */
  .folha {
    --pauta: 2.25rem;
    position: relative;
    background-color: hsl(var(--light-bg));
    background-image:
      linear-gradient(90deg, transparent 2.75rem, rgba(190, 70, 70, 0.35) 2.75rem, rgba(190, 70, 70, 0.35) calc(2.75rem + 1px), transparent calc(2.75rem + 1px)),
      repeating-linear-gradient(180deg, transparent 0 calc(var(--pauta) - 1px), rgba(30, 30, 30, 0.12) calc(var(--pauta) - 1px) var(--pauta));
    color: hsl(var(--light-fg));
    border-radius: 0.5rem;
    padding: var(--pauta) 1.5rem var(--pauta) 3.75rem;
    line-height: var(--pauta);
    transform: rotate(-1.2deg);
    box-shadow: 0 1.5rem 3rem -1.5rem rgba(0, 0, 0, 0.6);
  }
  .folha__rotulo { font-size: 0.9rem; color: rgba(30, 30, 30, 0.6); }
  .folha__titulo { font-size: clamp(1.4rem, 3vw, 1.75rem); line-height: var(--pauta); }
  .folha__perguntas { margin-top: var(--pauta); padding-left: 1.1rem; font-size: 1.02rem; }
  .folha__perguntas li + li { margin-top: var(--pauta); }
  .folha__perguntas li::marker { font-weight: 700; }
  .folha__resposta { display: block; height: calc(var(--pauta) * 1); }
  .folha__nota { margin-top: var(--pauta); font-size: 0.9rem; color: rgba(30, 30, 30, 0.7); }

  @media (min-width: 960px) {
    .topo__grid { grid-template-columns: 1fr 1fr; gap: 4rem; }
  }

  .regua { border-top: 1px solid hsl(var(--border)); }
  .regua__inner { max-width: 48rem; }
  .regua__nome { font-weight: 700; font-size: 1.1rem; }
  .regua__fila {
    list-style: none; padding: 0; margin-top: 1.5rem;
    display: grid; grid-template-columns: repeat(10, 1fr); gap: clamp(0.25rem, 1.5vw, 0.9rem);
  }
  .regua__rev svg { width: 100%; height: auto; display: block; fill: none; stroke: hsl(var(--muted-foreground)); stroke-width: 1.5; }
  .regua__rev--repos svg { fill: hsl(var(--light-bg)); stroke: hsl(var(--light-bg)); }
  .regua__legenda { margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; font-size: 0.85rem; color: hsl(var(--muted-foreground)); }
  .regua__legenda span { display: inline-flex; align-items: center; gap: 0.5rem; }
  .regua__ponto { width: 0.7rem; height: 0.7rem; border-radius: 50%; border: 1.5px solid hsl(var(--muted-foreground)); }
  .regua__ponto--repos { background: hsl(var(--light-bg)); border-color: hsl(var(--light-bg)); }
  .regua__texto { margin-top: 2rem; font-size: 1.1rem; line-height: 1.6; color: hsl(var(--muted-foreground)); max-width: 36rem; }
  .regua__frase { margin-top: 1.25rem; font-size: clamp(1.5rem, 4vw, 2.25rem); font-weight: 700; line-height: 1.15; letter-spacing: -0.03em; }

  .aviso { border-top: 1px solid hsl(var(--border)); }
</style>
