---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import VideoTestimonials from '../components/sections/VideoTestimonials.astro';
import AboutFelipe from '../components/sections/AboutFelipe.astro';
import ContatoWhatsapp from '../components/obrigada/ContatoWhatsapp.astro';
import EquacaoMetodo from '../components/obrigada/EquacaoMetodo.astro';

// Proposta B da página de obrigada: ângulo de preparação. O topo leva a ação
// principal (confirmar no WhatsApp); logo abaixo vem a conta, com as duas
// perguntas e a régua do Felipe desenhada (10 revendedoras novas, 6 voltando
// para repor). Em aprovação: nenhum formulário redireciona
// para cá ainda.
const regua = Array.from({ length: 10 }, (_, i) => i < 6);

// Os mesmos depoimentos em vídeo da home
const depoimentos = [
  { name: 'Jaque', videoId: '101c1525-fa13-4fe6-a61e-fe38600dec12' },
  { name: 'Barraca do Willinha', videoId: 'a7d5602a-4f1e-4d28-9b83-9cfc53fde08a' },
  { name: 'Adriana', videoId: '03f4e18a-1f52-40f5-844a-3f900f705126' },
  { name: 'Jossanclê', videoId: 'd8d67535-9b07-4713-a21f-14eb4cd70f6b' },
];

const stats = [
  { value: '+100', label: 'marcas atendidas' },
  { value: '2013', label: 'no digital' },
  { value: '1º', label: 'método próprio para atacado' },
];

const bio = [
  'Comecei no varejo em 2013. Em 2018, a convite de uma grande influenciadora de moda do país, me mudei para o Bom Retiro, no coração do atacado de São Paulo, e passei quase dois anos gerenciando uma marca de atacado de moda feminina com uma missão: fazer ela vender pela internet.',
  'Quase tudo que funcionava no varejo não funcionava ali. Tive que descobrir na prática o que funciona no atacado.',
  'De lá pra cá foram mais de 100 marcas atendidas e o Atacado Exponencial, o primeiro método construído do zero para o mercado atacado.',
];
---

<BaseLayout
  title="Aplicação recebida | Atacado Exponencial"
  description="Você está concorrendo a uma das vagas desta semana."
  showHeader={false}
  noindex
>
  <section class="topo">
    <div class="container">
      <ContatoWhatsapp>
        <Image src={logo} alt="Atacado Exponencial" height={72} class="topo__logo" />
        <span class="topo__selo">Aplicação recebida</span>
        <h1 class="topo__titulo">Você está concorrendo a uma das vagas desta semana.</h1>
        <p class="topo__sub">O seu horário está reservado e a sua aplicação está em análise. O resultado chega pelo WhatsApp em até 24 horas: confirme agora para não perder a vaga.</p>
      </ContatoWhatsapp>
    </div>
  </section>

  <section class="section conta">
    <div class="container conta__inner">
      <p class="conta__intro">Enquanto isso, faça esta conta. É por ela que a conversa começa.</p>
      <h2 class="conta__titulo">Quantas revendedoras voltaram?</h2>
      <p class="conta__rotulo">Responda de cabeça</p>
      <ol class="conta__perguntas">
        <li>Quantas revendedoras novas fizeram o primeiro pedido no último mês?</li>
        <li>Dessas, quantas já voltaram para repor?</li>
      </ol>
      <ul class="conta__fila" aria-label="A régua do Felipe: de 10 revendedoras novas, 6 voltam para repor">
        {regua.map((repos) => (
          <li class={repos ? 'conta__rev conta__rev--repos' : 'conta__rev'}>
            <svg viewBox="0 0 24 32" aria-hidden="true"><circle cx="12" cy="8" r="6" /><path d="M1 31c0-7 5-12 11-12s11 5 11 12Z" /></svg>
          </li>
        ))}
      </ul>
      <p class="conta__texto"><strong>A régua do Felipe:</strong> a cada 10 revendedoras novas, pelo menos 6 precisam fazer a reposição. Abaixo disso, a marca paga caro demais por cada pedido.</p>
      <p class="conta__frase">No atacado, a venda começa na reposição.</p>
      <p class="conta__nota">Não sabe esses números de cabeça? Anote o que souber. Descobrir o resto faz parte da consultoria.</p>
    </div>
  </section>

  <VideoTestimonials title="O que muda quando a conta fecha" videos={depoimentos} />

  <EquacaoMetodo
    titulo="O Atacado Exponencial cabe numa equação"
    entrada="A internet ensinou o atacado a ser um varejo disfarçado. O Pilar 1 coloca anúncio, perfil e comercial falando com a lojista, para a revendedora nova entrar todo mês por um caminho que a marca controla."
    recompra="Atacado é relacionamento. O Pilar 2 é o processo depois do primeiro pedido, que faz a revendedora voltar para repor sem depender de a marca correr atrás dela toda vez."
    fecho="A maioria das marcas tenta resolver os dois ao mesmo tempo. Na consultoria, a gente mostra qual atacar primeiro."
  />

  <AboutFelipe bio={bio} stats={stats} />
</BaseLayout>

<style>
  .topo { padding-block: 2.5rem 4rem; }
  .topo__logo { height: 1.75rem; width: auto; }
  .topo__selo {
    margin-top: 3rem; display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.9rem; font-weight: 700;
  }
  .topo__selo::before {
    content: ''; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: hsl(var(--light-bg));
  }
  .topo__titulo {
    margin-top: 1rem;
    font-size: clamp(2.1rem, 6vw, 3.5rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
    max-width: 15ch;
  }
  .topo__sub { margin-top: 1.25rem; }

  /* A conta: preparação para a consultoria, abaixo da ação principal */
  .conta { border-top: 1px solid hsl(var(--border)); }
  .conta__inner { max-width: 48rem; }
  .conta__intro { color: hsl(var(--muted-foreground)); font-size: 1.05rem; }
  .conta__titulo { font-size: clamp(1.6rem, 4vw, 2.25rem); line-height: 1.15; margin-top: 0.75rem; }
  .conta__rotulo { margin-top: 1.5rem; font-size: 0.9rem; color: hsl(var(--muted-foreground)); }
  .conta__perguntas { margin-top: 0.75rem; padding-left: 1.25rem; display: grid; gap: 0.75rem; font-size: 1.05rem; line-height: 1.5; }
  .conta__perguntas li::marker { font-weight: 700; }
  .conta__fila {
    list-style: none; padding: 0; margin-top: 2.25rem; max-width: 30rem;
    display: grid; grid-template-columns: repeat(10, 1fr); gap: clamp(0.25rem, 1.2vw, 0.6rem);
  }
  .conta__rev svg { width: 100%; height: auto; display: block; fill: none; stroke: hsl(var(--muted-foreground)); stroke-width: 1.5; }
  .conta__rev--repos svg { fill: hsl(var(--light-bg)); stroke: hsl(var(--light-bg)); }
  .conta__texto { margin-top: 1.5rem; font-size: 1.05rem; line-height: 1.6; color: hsl(var(--muted-foreground)); max-width: 36rem; }
  .conta__texto strong { color: hsl(var(--foreground)); }
  .conta__frase { margin-top: 1.25rem; font-size: clamp(1.4rem, 3.5vw, 2rem); font-weight: 700; line-height: 1.15; letter-spacing: -0.03em; }
  .conta__nota { margin-top: 1.25rem; font-size: 0.95rem; color: hsl(var(--muted-foreground)); }
</style>
