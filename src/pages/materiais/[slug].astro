---
/**
 * Página de entrega dos materiais ricos do ManyChat (issue 146).
 *
 * Uma rota por entrada de src/data/materiais.js, pré-renderizada no build.
 * Capta nome, email e WhatsApp e envia ao /tracker (event Lead, funil
 * 'iscas-manychat', campo `material` com o slug). O backend registra a
 * atribuição, dispara Meta CAPI/GA4, encaminha ao CRM e devolve o link do
 * arquivo no Drive — a página só executa o redirect.
 *
 * O link do material NUNCA é renderizado aqui: quem resolve o destino é o
 * /tracker, a partir do mesmo catálogo.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import logo from '../../assets/brand/logo.png';
import { MATERIAIS, FUNIL_MATERIAIS } from '../../data/materiais.js';

export function getStaticPaths() {
  return MATERIAIS.map((material) => ({
    params: { slug: material.slug },
    props: { titulo: material.titulo, subtitulo: material.subtitulo },
  }));
}

const { slug } = Astro.params;
const { titulo, subtitulo } = Astro.props;
---

<BaseLayout
  title={`${titulo} — Atacado Exponencial`}
  description={subtitulo}
  showHeader={false}
  showFooter={false}
>
  <main class="mat">
    <div class="mat__panel">
      <Image src={logo} alt="Atacado Exponencial" height={72} class="mat__logo" />
      <span class="mat__badge">Material gratuito</span>
      <h1 class="mat__title">{titulo}</h1>
      <p class="mat__sub">{subtitulo}</p>

      <form class="mat__form" id="material-form" data-slug={slug} data-funnel={FUNIL_MATERIAIS}>
        <label class="mat__field">
          <span>Nome</span>
          <input name="nome" type="text" placeholder="Seu nome" required minlength="2" autocomplete="name" />
        </label>
        <label class="mat__field">
          <span>Email</span>
          <input name="email" type="email" placeholder="Seu melhor email" required autocomplete="email" />
        </label>
        <label class="mat__field">
          <span>WhatsApp</span>
          <input name="telefone" type="tel" placeholder="(00) 00000-0000" required autocomplete="tel" />
        </label>
        <p class="mat__error" id="material-form-error" hidden></p>
        <button type="submit" class="mat__submit" id="material-form-submit">Quero receber o material</button>
        <p class="mat__legal">Ao enviar, você concorda em receber conteúdos do Atacado Exponencial.</p>
      </form>
    </div>
  </main>
</BaseLayout>

<style>
  .mat {
    min-height: 100vh;
    display: flex; align-items: center; justify-content: center;
    padding: 2rem 1rem;
  }
  .mat__panel {
    width: 100%; max-width: 32rem;
    background: #1e1e1e; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 1rem;
    padding: 2rem 1.5rem;
    display: flex; flex-direction: column; align-items: center; text-align: center;
  }
  .mat__logo { height: 2.75rem; width: auto; }
  .mat__badge {
    margin-top: 1.5rem;
    font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.5);
  }
  .mat__title { margin: 0.75rem 0 0; font-size: 1.6rem; line-height: 1.2; }
  .mat__sub { margin: 0.9rem 0 0; font-size: 0.95rem; line-height: 1.5; color: rgba(255, 255, 255, 0.7); }
  .mat__form { width: 100%; display: flex; flex-direction: column; gap: 1rem; margin-top: 2rem; text-align: left; }
  .mat__field { display: flex; flex-direction: column; gap: 0.4rem; }
  .mat__field > span { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: rgba(255, 255, 255, 0.5); }
  .mat__field input {
    background: #000; border: 1px solid rgba(255, 255, 255, 0.2); color: #fff;
    padding: 0.8rem 1rem; font-family: inherit; font-size: 0.9rem;
  }
  .mat__field input::placeholder { color: rgba(255, 255, 255, 0.25); }
  .mat__field input:focus { outline: none; border-color: rgba(255, 255, 255, 0.6); }
  .mat__error { color: #f87171; font-size: 0.8rem; margin: 0; }
  .mat__submit {
    background: #fff; color: #1e1e1e; border: none; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.8rem; padding: 1rem; margin-top: 0.5rem;
    cursor: pointer;
  }
  .mat__submit:disabled { opacity: 0.5; cursor: default; }
  .mat__legal { margin: 0; font-size: 0.7rem; line-height: 1.5; color: rgba(255, 255, 255, 0.35); text-align: center; }

  @media (min-width: 640px) {
    .mat__panel { padding: 2.5rem; }
    .mat__title { font-size: 2rem; }
  }
</style>

<script>
  import { telefoneValido, TELEFONE_ERRO, aplicarMascaraTelefone, aplicarSugestaoEmail } from '../../scripts/lead-validacao';

  const form = document.getElementById('material-form') as HTMLFormElement | null;
  const errEl = document.getElementById('material-form-error') as HTMLElement | null;
  const submitBtn = document.getElementById('material-form-submit') as HTMLButtonElement | null;

  if (form && errEl && submitBtn) {
    const telEl = form.querySelector('input[name="telefone"]') as HTMLInputElement | null;
    const emailEl = form.querySelector('input[name="email"]') as HTMLInputElement | null;
    if (telEl) aplicarMascaraTelefone(telEl);
    if (emailEl) aplicarSugestaoEmail(emailEl);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errEl.hidden = true;
      if (!form.checkValidity()) { form.reportValidity(); return; }
      const data = new FormData(form);
      const lead = {
        nome: String(data.get('nome') || ''),
        telefone: String(data.get('telefone') || ''),
        email: String(data.get('email') || ''),
        funnel: String(form.dataset.funnel || ''),
        material: String(form.dataset.slug || ''),
      };
      if (!telefoneValido(lead.telefone)) {
        errEl.textContent = TELEFONE_ERRO;
        errEl.hidden = false;
        return;
      }
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando…';
      // Fallback caso o /tracker não responda: a pessoa nunca fica numa tela
      // morta. O link do material só existe no backend, então aqui é /obrigada.
      let redirect = '/obrigada';
      const eventId = 'lead-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8);
      try { if (typeof (window as any).fbq === 'function') (window as any).fbq('track', 'Lead', {}, { eventID: eventId }); } catch (e) { /* espelho browser nunca bloqueia o envio */ }
      try {
        const res = await fetch('/tracker', {
          method: 'POST',
          // keepalive: o navegador termina o envio mesmo se a aba fechar no
          // meio (comum no browser embutido do Instagram, origem do ManyChat).
          keepalive: true,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            event_name: 'Lead',
            event_id: eventId,
            event_time: Math.floor(Date.now() / 1000),
            event_source_url: window.location.href,
            user_data: { em: lead.email, ph: lead.telefone, fn: lead.nome },
            lead_data: lead,
          }),
        });
        const json = await res.json();
        if (json && json.redirect) redirect = json.redirect;
      } catch (e) {
        /* segue para o destino padrão acima */
      }
      window.location.href = redirect;
    });
  }
</script>
